@inject VehicleTax.Web.Services.IPermissionService Perms
@* Links the reports of the current page's group (Services/ReportCatalog). *@
@{
    var found = VehicleTax.Web.Services.ReportCatalog.Find(Context.Request.Path.Value);
    if (found == null) { return; }
    var (group, current) = found.Value;
    var perms = await Perms.GetEffectiveAsync(User);
    var siblings = group.Reports.Where(r => perms.Contains(r.Permission)).ToList();
}
<style>
    .rt-bar { display: flex; align-items: center; gap: .5rem; flex-wrap: wrap; margin-bottom: 1rem; }
    .rt-crumb { display: inline-flex; align-items: center; gap: .4rem; font-size: .82rem; font-weight: 700; color: #64748b; text-decoration: none; white-space: nowrap; }
    .rt-crumb:hover { color: #0b57d0; }
    .rt-tabs { display: flex; gap: .35rem; overflow-x: auto; scrollbar-width: thin; padding-bottom: 2px; }
    .rt-tab { display: inline-flex; align-items: center; gap: .4rem; border: 1px solid #e2e8f0; background: #fff; color: #334155;
        border-radius: 999px; padding: .3rem .8rem; font-size: .82rem; font-weight: 600; text-decoration: none; white-space: nowrap; }
    .rt-tab:hover { border-color: #93b4f5; color: #0b57d0; }
    .rt-tab.active { background: var(--rt-color); border-color: var(--rt-color); color: #fff; }
    @@media print { .rt-bar { display: none !important; } }
</style>
<div class="rt-bar d-print-none" style="--rt-color:@group.Color">
    <a class="rt-crumb" href="@VehicleTax.Web.Services.ReportCatalog.CenterPage">
        <i class="bi bi-grid-3x3-gap"></i>@L["Reports Center"]
    </a>
    <i class="bi bi-chevron-right text-muted small"></i>
    <span class="rt-crumb" style="color:@group.Color"><i class="bi @group.Icon"></i>@L[group.Title]</span>
    @if (siblings.Count > 1)
    {
        <span class="text-muted">|</span>
        <div class="rt-tabs" data-view-fixed>
            @foreach (var r in siblings)
            {
                <a class="rt-tab @(r == current ? "active" : "")" href="@r.Page" data-view-fixed><i class="bi @r.Icon"></i>@L[r.Title]</a>
            }
        </div>
    }
</div>
