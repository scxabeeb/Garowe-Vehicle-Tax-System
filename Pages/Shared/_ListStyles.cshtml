@* Shared look for data list pages (Vehicles, Tariffs): hero, filter card, chips, table, icon buttons. *@
<style>
    .ls-hero { background: linear-gradient(135deg, #0b57d0, #1e3a8a); color: #fff; border-radius: 18px; padding: 20px 24px; }
    .ls-hero .count { background: rgba(255,255,255,.18); border-radius: 999px; padding: 2px 12px; font-size: 14px; font-weight: 700; margin-left: 8px; vertical-align: middle; }
    .ls-card { border: 1px solid #e2e8f0; border-radius: 16px; background: #fff; overflow: hidden; }
    .ls-chip { display: inline-flex; align-items: center; gap: 8px; border: 2px solid #e2e8f0; background: #fff; border-radius: 14px;
        padding: 8px 14px; font-weight: 700; color: #334155; text-decoration: none; transition: all .15s; }
    .ls-chip:hover { border-color: #93b4f5; color: #334155; }
    .ls-chip.active { border-color: #0b57d0; background: #eef4ff; color: #0b57d0; }
    .ls-chip .n { background: #f1f5f9; border-radius: 999px; padding: 0 9px; font-size: 13px; }
    .ls-chip.active .n { background: #0b57d0; color: #fff; }
    .ls-table thead th { font-size: 12px; text-transform: uppercase; letter-spacing: .04em; color: #64748b; background: #f8fafc;
        white-space: nowrap; border-bottom: 1px solid #e2e8f0; padding-top: 12px; padding-bottom: 12px; }
    .ls-table td { vertical-align: middle; border-color: #f1f5f9; }
    .ls-table tbody tr:hover { background: #f8fbff; }
    .ls-plate { display: inline-block; background: #0b57d0; color: #fff; font-weight: 800; letter-spacing: .06em; border-radius: 8px; padding: 4px 10px; }
    .ls-avatar { width: 34px; height: 34px; border-radius: 10px; display: inline-grid; place-items: center; background: #eef4ff; color: #0b57d0; font-weight: 800; font-size: 13px; flex-shrink: 0; }
    .ls-pill { display: inline-flex; align-items: center; gap: 5px; border-radius: 999px; padding: 3px 10px; font-size: 12px; font-weight: 700; white-space: nowrap; }
    .ls-act { width: 34px; height: 34px; border-radius: 10px; display: inline-grid; place-items: center; border: 1px solid #e2e8f0; background: #fff; color: #334155; text-decoration: none; }
    .ls-act:hover { background: #f1f5f9; color: #0b57d0; }
    .ls-act.danger { color: #dc2626; }
    .ls-act.danger:hover { background: #fef2f2; }
    .ls-empty { padding: 48px 16px; text-align: center; color: #64748b; }
    .ls-empty i { font-size: 2.2rem; display: block; margin-bottom: 8px; color: #94a3b8; }
</style>
