@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@inject VehicleTax.Web.Services.IPermissionService Perms
<!DOCTYPE html>
<html lang="@L.Code">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - @L["Vehicle Tax System"]</title>

    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="cache-control" content="no-cache, no-store, must-revalidate" />
    <meta http-equiv="pragma" content="no-cache" />
    <meta http-equiv="expires" content="0" />

    <link rel="icon" type="image/jpeg" href="/images/Logo.jpeg" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700;800&display=swap" rel="stylesheet" media="print" onload="this.media='all'">

    <link href="~/lib/bootstrap/bootstrap.min.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/lib/bootstrap-icons/bootstrap-icons.min.css" rel="stylesheet" asp-append-version="true" />

    <style>
        :root {
            --brand-blue: #1f4ed3;
            --brand-navy: #0f2b73;
            --brand-soft: #eef3ff;
            --text-dark: #1f2937;
        }

        body {
            font-family: 'Manrope', sans-serif;
            color: var(--text-dark);
            background: linear-gradient(180deg, #f8fbff 0%, #f4f6f8 42%, #f7f7f7 100%);
        }

        .app-navbar {
            background: linear-gradient(90deg, #0f172a 0%, #132f73 55%, #1f4ed3 100%) !important;
        }

        .navbar-brand {
            background: rgba(255, 255, 255, .1);
            border: 1px solid rgba(255, 255, 255, .22);
            border-radius: .75rem;
            padding: .35rem .7rem;
            backdrop-filter: blur(3px);
        }

        .navbar-brand img {
            border-radius: 50%;
            border: 2px solid rgba(255, 255, 255, .6);
        }

        .navbar .nav-link {
            border-radius: .5rem;
            margin: 0 .15rem;
            padding: .45rem .65rem !important;
            transition: all .18s ease-in-out;
            color: rgba(255, 255, 255, .93) !important;
        }

        .navbar .nav-link:hover,
        .navbar .nav-link:focus {
            color: #fff !important;
            background: rgba(255, 255, 255, .14);
            transform: translateY(-1px);
        }

        .navbar .nav-link.active,
        .navbar .show > .nav-link {
            color: #fff !important;
            background: rgba(255, 255, 255, .22);
            box-shadow: inset 0 0 0 1px rgba(255, 255, 255, .18);
        }

        .dropdown-menu {
            z-index: 1080;
            border-radius: .8rem;
        }

        .dropdown-item {
            border-radius: .5rem;
            margin: .08rem .35rem;
            width: calc(100% - .7rem);
        }

        .dropdown-item:hover {
            background: var(--brand-soft);
            color: var(--brand-navy);
        }

        .menu-category {
            font-size: .72rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .08em;
            color: #64748b;
            padding: .45rem .9rem .2rem;
        }

        .profile-trigger {
            background: rgba(255, 255, 255, .12);
            border: 1px solid rgba(255, 255, 255, .2);
            border-radius: .8rem;
            padding: .3rem .55rem !important;
        }

        .profile-trigger:hover {
            background: rgba(255, 255, 255, .2);
        }

        .profile-avatar {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            background: linear-gradient(145deg, #ffd666 0%, #f59f00 100%);
            color: #111827;
            font-weight: 800;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border: 2px solid rgba(255, 255, 255, .55);
        }

        .profile-avatar-lg {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            background: linear-gradient(145deg, #ffe082 0%, #f59e0b 100%);
            color: #111827;
            font-weight: 800;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

        .profile-menu {
            min-width: 280px;
        }

        .profile-card {
            display: flex;
            align-items: center;
            gap: .7rem;
            background: linear-gradient(90deg, #f4f7ff 0%, #eef3ff 100%);
            border: 1px solid #dbe7ff;
            border-radius: .8rem;
            padding: .6rem .7rem;
        }

        .report-banner {
            background: linear-gradient(90deg, #ffffff 0%, #f5f8ff 52%, #edf2ff 100%);
            border: 1px solid #dbe7ff;
            border-radius: 1rem;
            box-shadow: 0 10px 24px rgba(15, 43, 115, .08);
            padding: .9rem 1rem;
            margin-bottom: 1rem;
        }

        /* Horizontal pagination scroller for large page counts */
        .pagination {
            flex-direction: row;
            flex-wrap: nowrap;
            overflow-x: auto;
            overflow-y: hidden;
            align-items: stretch;
            justify-content: flex-start !important;
            gap: .25rem;
            white-space: nowrap;
            padding-bottom: .25rem;
        }

        .pagination .page-link {
            min-width: 3rem;
            text-align: center;
        }

        @@media (max-width: 768px) {
            .pagination .page-link {
                padding: .25rem .5rem;
                font-size: .9rem;
                min-width: 2.75rem;
            }
        }
    </style>
</head>

@{ var printMode = Context.Request.Query["print"] == "1"; }
<body class="d-flex flex-column min-vh-100 @(printMode ? "print-mode" : "")">
@if (printMode)
{
    @* Print view: only the report content, then the print dialog (choose "Save as PDF"). *@
    <style>
        .print-mode nav.navbar, .print-mode footer, .print-mode form, .print-mode .report-view-cards,
        .print-mode .vt-pager, .print-mode .vt-sort-hint, .print-mode .d-print-none, .print-mode .alert,
        .print-mode .btn, .print-mode .module-header .btn { display: none !important; }
        .print-mode .vt-sort { display: none !important; }
        .print-mode .container, .print-mode .container-fluid { max-width: none !important; }
        .print-mode table { font-size: 11px; }
        @@page { size: A4 landscape; margin: 10mm; }
    </style>
    <div class="container-fluid pt-3 d-flex align-items-center gap-3 border-bottom pb-2 mb-2">
        <img src="/images/Logo.jpeg" alt="" width="48" height="48" class="rounded-circle" />
        <div>
            <div class="fw-bold">@L["Garowe Local Government"] — @ViewData["Title"]</div>
            <div class="small text-muted">
                @{ var f = Context.Request.Query["FromDate"].ToString(); var t = Context.Request.Query["ToDate"].ToString(); }
                @(string.IsNullOrEmpty(f) && string.IsNullOrEmpty(t) ? L["All dates"] : $"{f} – {t}")
                · @L["Printed"] @VehicleTax.Web.AppTime.Now.ToString("dd MMM yyyy HH:mm")
            </div>
        </div>
    </div>
    <script>window.addEventListener('load', function () { setTimeout(function () { window.print(); }, 400); });</script>
}

<nav class="navbar navbar-expand-lg navbar-dark app-navbar shadow">
    <div class="container-fluid">

        <a class="navbar-brand d-flex align-items-center gap-2" asp-page="/Index">
            <img src="/images/Logo.jpeg" width="40" height="40" />
            <span class="fw-bold text-uppercase" style="letter-spacing:.35px;">
                @L["Garowe Local Government"] 
            </span>
        </a>

        <button class="navbar-toggler" type="button"
                data-bs-toggle="collapse"
                data-bs-target="#mainNav">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="mainNav">

            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    // Menus follow the user's live permissions (same rules the pages enforce).
                    var perms = await Perms.GetEffectiveAsync(User);
                    Func<string, bool> can = key => perms.Contains(key);
                    var canVehicleView = can("Vehicles.View");
                    var canSettingsView = can("Settings.View");
                    var canPaymentView = can("Payments.View");
                    var canPaymentCreate = can("Payments.Create");
                    var canReportsView = can("Reports.View");
                    var canFinanceView = can("Finance.View");
                    var canUserView = can("Users.View");
                    var canUserCreate = can("Users.Create");
                    var canManagePermissions = can("Roles.ManagePermissions");
                    var canRolesView = can("Roles.View");
                    var canActivityLog = canUserView;
                    var canTransferPayments = User.IsInRole("Admin") || User.IsInRole("Super Admin");
                    var currentPath = (Context.Request.Path.Value ?? string.Empty).ToLowerInvariant();

                    var isDataSetup = currentPath.StartsWith("/vehicles") ||
                                      currentPath.StartsWith("/cartypes") ||
                                      currentPath.StartsWith("/movements") ||
                                      currentPath.StartsWith("/taxamounts") ||
                                      currentPath.StartsWith("/checkpoints") ||
                                      currentPath.StartsWith("/revenueaccounts");
                    var isPayments = currentPath.StartsWith("/payments") ||
                                     currentPath.StartsWith("/receiptreferences");
                    var isReports = currentPath.StartsWith("/reports") ||
                                    currentPath.StartsWith("/finance") ||
                                    currentPath.StartsWith("/transactions");
                    var isAdministration = currentPath.StartsWith("/account/users") ||
                                           currentPath.StartsWith("/account/register") ||
                                           currentPath.StartsWith("/account/usersecurity");

                    @if (canVehicleView || canSettingsView)
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle d-flex align-items-center gap-1 @(isDataSetup ? "active" : "")"
                               href="#"
                               role="button"
                               data-bs-toggle="dropdown">
                                <i class="bi bi-grid-1x2"></i> @L["Data & Setup"]
                            </a>
                            <ul class="dropdown-menu shadow border-0">
                                <li class="menu-category">@L["Registry"]</li>
                                @if (canVehicleView)
                                {
                                <li>
                                    <a class="dropdown-item d-flex align-items-center gap-2" asp-page="/Vehicles/Index">
                                        <i class="bi bi-truck"></i> @L["Vehicles"]
                                    </a>
                                </li>
                                }
                                @if (canSettingsView)
                                {
                                <li>
                                    <a class="dropdown-item d-flex align-items-center gap-2" asp-page="/CarTypes/Index">
                                        <i class="bi bi-diagram-3"></i> @L["Car Types"]
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item d-flex align-items-center gap-2" asp-page="/Movements/Index">
                                        <i class="bi bi-arrow-left-right"></i> @L["Tariff"]
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider" /></li>
                                <li class="menu-category">@L["Tax Setup"]</li>
                                <li>
                                    <a class="dropdown-item d-flex align-items-center gap-2" asp-page="/TaxAmounts/Index">
                                        <i class="bi bi-currency-dollar"></i> @L["Tax Amounts"]
                                    </a>
                                </li>
                                    <li>
                                        <a class="dropdown-item d-flex align-items-center gap-2" asp-page="/Checkpoints/Index">
                                            <i class="bi bi-geo-alt"></i> @L["Checkpoints"]
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item d-flex align-items-center gap-2" asp-page="/RevenueAccounts/Index">
                                            <i class="bi bi-wallet2"></i> @L["Revenue Accounts"]
                                        </a>
                                    </li>
                                }
                            </ul>
                        </li>
                    }

                    @if (canPaymentView || canPaymentCreate)
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle d-flex align-items-center gap-1 @(isPayments ? "active" : "")"
                               href="#"
                               role="button"
                               data-bs-toggle="dropdown">
                                <i class="bi bi-cash-stack"></i> @L["Payments"]
                            </a>
                            <ul class="dropdown-menu shadow border-0">
                                <li class="menu-category">@L["Collect"]</li>
                                @if (canPaymentCreate)
                                {
                                    <li>
                                        <a class="dropdown-item d-flex align-items-center gap-2" asp-page="/Payments/Collect">
                                            <i class="bi bi-wallet2"></i> @L["Collect Tax"]
                                        </a>
                                    </li>
                                }
                                @if (canPaymentView)
                                {
                                    <li>
                                        <a class="dropdown-item d-flex align-items-center gap-2" asp-page="/Payments/Index">
                                            <i class="bi bi-receipt-cutoff"></i> @L["Payments List"]
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item d-flex align-items-center gap-2" asp-page="/Payments/Index" asp-route-Status="pending">
                                            <i class="bi bi-hourglass-split"></i> @L["Pending Invoices"]
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item d-flex align-items-center gap-2" asp-page="/Payments/Index" asp-route-Status="cancelled">
                                            <i class="bi bi-x-circle"></i> @L["Cancelled Payments"]
                                        </a>
                                    </li>
                                }
                                @if (canTransferPayments)
                                {
                                    <li>
                                        <a class="dropdown-item d-flex align-items-center gap-2" asp-page="/Finance/TransferPayments">
                                            <i class="bi bi-arrow-left-right"></i> @L["Transfer Payments"]
                                        </a>
                                    </li>
                                }
                            </ul>
                        </li>
                    }

                    @if (canUserView || canUserCreate)
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle d-flex align-items-center gap-1 @(isAdministration ? "active" : "")"
                               href="#"
                               role="button"
                               data-bs-toggle="dropdown">
                                <i class="bi bi-shield-check"></i> @L["Administration"]
                            </a>

                            <ul class="dropdown-menu shadow border-0">
                                <li class="menu-category">@L["User Management"]</li>
                                @if (canUserView)
                                {
                                    <li>
                                        <a class="dropdown-item d-flex align-items-center gap-2"
                                           asp-page="/Account/Users">
                                            <i class="bi bi-list-ul"></i>
                                            @L["Manage Users"]
                                        </a>
                                    </li>
                                }

                                @if (canUserCreate)
                                {
                                    <li>
                                        <a class="dropdown-item d-flex align-items-center gap-2"
                                           asp-page="/Account/Register">
                                            <i class="bi bi-person-plus"></i>
                                            @L["Create User"]
                                        </a>
                                    </li>
                                }

                                @if (canUserView)
                                {
                                    <li>
                                        <a class="dropdown-item d-flex align-items-center gap-2"
                                           asp-page="/Account/UserSecurity">
                                            <i class="bi bi-shield-lock"></i>
                                            @L["User Security"]
                                        </a>
                                    </li>
                                }
                                @if (canManagePermissions || canRolesView)
                                {
                                    <li><hr class="dropdown-divider" /></li>
                                    <li class="menu-category">@L["Roles & Permissions"]</li>
                                    @if (canRolesView)
                                    {
                                    <li>
                                        <a class="dropdown-item d-flex align-items-center gap-2" asp-page="/Account/Roles">
                                            <i class="bi bi-person-badge"></i>
                                            @L["Roles"]
                                        </a>
                                    </li>
                                    }
                                }
                                @if (canManagePermissions)
                                {
                                    <li>
                                        <a class="dropdown-item d-flex align-items-center gap-2"
                                           asp-page="/Account/ManagePermissions">
                                            <i class="bi bi-sliders"></i>
                                            @L["Manage Permissions"]
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item d-flex align-items-center gap-2"
                                           asp-page="/Account/PermissionHistory">
                                            <i class="bi bi-clock-history"></i>
                                            @L["Permission Change History"]
                                        </a>
                                    </li>
                                }
                            </ul>
                        </li>
                    }

                    @if (canPaymentView)
                    {
                    <li class="nav-item">
                        <a class="nav-link d-flex align-items-center gap-1 @(currentPath.StartsWith("/verify") ? "active" : "")"
                           asp-page="/Verify/Index">
                            <i class="bi bi-patch-check"></i> @L["Verify Plate"]
                        </a>
                    </li>
                    }

                    @if (canReportsView || canFinanceView || canActivityLog)
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle d-flex align-items-center gap-1 @(isReports ? "active" : "")"
                               href="#"
                               role="button"
                               data-bs-toggle="dropdown">
                                <i class="bi bi-bar-chart-line"></i> @L["Reports"]
                            </a>

                            <ul class="dropdown-menu shadow border-0" style="max-height: 75vh; overflow-y: auto;">
                                <li class="menu-category">@L["Collections"]</li>
                                @if (canReportsView)
                                {
                                <li>
                                    <a class="dropdown-item d-flex align-items-center gap-2" asp-page="/Reports/Index">
                                        <i class="bi bi-speedometer2"></i> @L["Collections Dashboard"]
                                    </a>
                                </li>
                                }
                                @if (canReportsView)
                                {
                                <li>
                                    <a class="dropdown-item d-flex align-items-center gap-2" asp-page="/Reports/Summary">
                                        <i class="bi bi-file-earmark-bar-graph"></i> @L["Summary Report"]
                                    </a>
                                </li>
                                }
                                @if (canReportsView)
                                {
                                <li>
                                    <a class="dropdown-item d-flex align-items-center gap-2" asp-page="/Reports/CheckpointReport">
                                        <i class="bi bi-geo-alt"></i> @L["Checkpoint Collection Report"]
                                    </a>
                                </li>
                                }
                                @if (canReportsView)
                                {
                                <li>
                                    <a class="dropdown-item d-flex align-items-center gap-2" asp-page="/Reports/PaymentSummary">
                                        <i class="bi bi-bar-chart-line"></i> @L["Payment Summary Report"]
                                    </a>
                                </li>
                                }
                                <li><hr class="dropdown-divider" /></li>
                                <li class="menu-category">@L["Finance & Accounts"]</li>
                                @if (canReportsView)
                                {
                                <li>
                                    <a class="dropdown-item d-flex align-items-center gap-2" asp-page="/Reports/RevenueAccountReport">
                                        <i class="bi bi-wallet2"></i> @L["Revenue Account Report"]
                                    </a>
                                </li>
                                }
                                @if (canFinanceView)
                                {
                                <li>
                                    <a class="dropdown-item d-flex align-items-center gap-2" asp-page="/Finance/Index">
                                        <i class="bi bi-cash-stack"></i> @L["Finance Dashboard"]
                                    </a>
                                </li>
                                }
                                @if (canFinanceView)
                                {
                                <li>
                                    <a class="dropdown-item d-flex align-items-center gap-2" asp-page="/Finance/Rv/Index">
                                        <i class="bi bi-file-earmark-text"></i> @L["RV History"]
                                    </a>
                                </li>
                                }
                                @if (canTransferPayments)
                                {
                                <li>
                                    <a class="dropdown-item d-flex align-items-center gap-2" asp-page="/Finance/TransferPayments">
                                        <i class="bi bi-arrow-left-right"></i> @L["Transfer Payments"]
                                    </a>
                                </li>
                                }
                                <li><hr class="dropdown-divider" /></li>
                                <li class="menu-category">@L["Audit"]</li>
                                @if (canReportsView)
                                {
                                <li>
                                    <a class="dropdown-item d-flex align-items-center gap-2" asp-page="/Reports/GolisAudit">
                                        <i class="bi bi-shield-check"></i> @L["Golis Audit"]
                                    </a>
                                </li>
                                }
                                @if (canReportsView)
                                {
                                <li>
                                    <a class="dropdown-item d-flex align-items-center gap-2" asp-page="/Reports/GolisAuditHistory">
                                        <i class="bi bi-clock-history"></i> @L["Golis Audit History"]
                                    </a>
                                </li>
                                }
                                @if (canReportsView)
                                {
                                <li>
                                    <a class="dropdown-item d-flex align-items-center gap-2" asp-page="/Reports/Logs">
                                        <i class="bi bi-journal-text"></i> @L["Logs & Audit Report"]
                                    </a>
                                </li>
                                }
                                @if (canReportsView)
                                {
                                <li>
                                    <a class="dropdown-item d-flex align-items-center gap-2" asp-page="/Transactions/Index">
                                        <i class="bi bi-arrow-left-right"></i> @L["Transactions Audit Log"]
                                    </a>
                                </li>
                                }
                                @if (canActivityLog)
                                {
                                <li>
                                    <a class="dropdown-item d-flex align-items-center gap-2" asp-page="/Reports/ActivityLog">
                                        <i class="bi bi-activity"></i> @L["Activity Log"]
                                    </a>
                                </li>
                                }
                                <li><hr class="dropdown-divider" /></li>
                                <li class="menu-category">@L["Registry & Setup"]</li>
                                @if (canReportsView)
                                {
                                <li>
                                    <a class="dropdown-item d-flex align-items-center gap-2" asp-page="/Reports/Vehicles">
                                        <i class="bi bi-truck"></i> @L["Vehicle Registry Report"]
                                    </a>
                                </li>
                                }
                                @if (canReportsView)
                                {
                                <li>
                                    <a class="dropdown-item d-flex align-items-center gap-2" asp-page="/Reports/AccountTariffs">
                                        <i class="bi bi-wallet2"></i> @L["Revenue Account Tariffs"]
                                    </a>
                                </li>
                                }
                                @if (canReportsView)
                                {
                                <li>
                                    <a class="dropdown-item d-flex align-items-center gap-2" asp-page="/Reports/Movements">
                                        <i class="bi bi-signpost-split"></i> @L["Tariff Types Report"]
                                    </a>
                                </li>
                                }
                                @if (canReportsView)
                                {
                                <li>
                                    <a class="dropdown-item d-flex align-items-center gap-2" asp-page="/Reports/TaxMovement">
                                        <i class="bi bi-bar-chart"></i> @L["Tax by Tariff Report"]
                                    </a>
                                </li>
                                }
                                @if (canReportsView)
                                {
                                <li>
                                    <a class="dropdown-item d-flex align-items-center gap-2" asp-page="/Reports/TaxMovementCarType">
                                        <i class="bi bi-diagram-3"></i> @L["Tax Amount by Tariff & Car Type"]
                                    </a>
                                </li>
                                }
                                @if (canReportsView)
                                {
                                <li>
                                    <a class="dropdown-item d-flex align-items-center gap-2" asp-page="/Reports/TaxAmountReport">
                                        <i class="bi bi-currency-dollar"></i> @L["Tax Amount Schedule"]
                                    </a>
                                </li>
                                }
                                @if (canReportsView)
                                {
                                <li>
                                    <a class="dropdown-item d-flex align-items-center gap-2" asp-page="/Reports/UsersReport">
                                        <i class="bi bi-people"></i> @L["User Activity Report"]
                                    </a>
                                </li>
                                }
                             </ul>
                        </li>
                    }
                }
            </ul>

            <ul class="navbar-nav ms-auto align-items-center">
                <li class="nav-item me-2 my-2 my-lg-0">
                    <partial name="_LangSwitch" />
                </li>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <li class="nav-item dropdown">
                        <a class="nav-link profile-trigger dropdown-toggle d-flex align-items-center gap-2"
                           href="#"
                           role="button"
                           data-bs-toggle="dropdown">

                            <span class="profile-avatar">
                                @User.Identity!.Name!.Substring(0,1).ToUpper()
                            </span>

                            <span class="d-none d-md-block">
                                <small class="d-block text-white-50" style="line-height:1;">@L["Signed in as"]</small>
                                <span class="fw-semibold" style="line-height:1.2;">@User.Identity.Name</span>
                            </span>
                        </a>

                        <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2 profile-menu">
                            <li class="px-3 pt-3 pb-2">
                                <div class="profile-card">
                                    <span class="profile-avatar-lg">
                                        @(User.Identity!.Name.Substring(0,1).ToUpper())
                                    </span>
                                    <div>
                                        <div class="fw-bold">@User.Identity.Name</div>
                                        <small class="text-muted">
                                            @L["Role:"] @L[User.IsInRole("Admin") ? "Administrator" : "User"]
                                        </small>
                                    </div>
                                </div>
                            </li>

                            <li><hr class="dropdown-divider" /></li>

                            <li>
                                <a class="dropdown-item d-flex align-items-center"
                                   asp-page="/Account/ChangePassword">
                                    <i class="bi bi-key me-2"></i>
                                    @L["Change Password"]
                                </a>
                            </li>

                            <li><hr class="dropdown-divider" /></li>

                            <li>
                                <button type="button"
                                        class="dropdown-item text-danger d-flex align-items-center"
                                        onclick="logoutUser()">
                                    <i class="bi bi-box-arrow-right me-2"></i>
                                    @L["Logout"]
                                </button>
                            </li>
                        </ul>
                    </li>
                }
                else
                {
                    <li class="nav-item">
                        <a class="btn btn-sm btn-outline-light" asp-page="/Account/Login">
                            <i class="bi bi-box-arrow-in-right"></i> @L["Login"]
                        </a>
                    </li>
                }
            </ul>

        </div>
    </div>
</nav>

<main class="container mt-4 flex-fill">
    @if (!string.IsNullOrEmpty(Context.Request.Query["expired"]))
{
    <div class="container mt-3">
        <div class="alert alert-warning alert-dismissible fade show d-flex align-items-center gap-2">
            <i class="bi bi-clock-history"></i>@L["Your session expired. Please try again."]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    </div>
}
@RenderBody()
</main>

<footer class="mt-5 py-3 border-top text-center text-muted small bg-white">
    <div class="d-flex align-items-center justify-content-center gap-2">
        <img src="/images/Logo.jpeg" width="24" height="24" style="border-radius:50%;" />
        <span>&copy; @VehicleTax.Web.AppTime.Now.Year @L["Garowe Local Government"] - @L["Vehicle Tax System"]</span>
    </div>
</footer>

<script src="~/lib/bootstrap/bootstrap.bundle.min.js" asp-append-version="true"></script>

<script>
    window.__reportPagerText = { showing: '@L["Showing"]', of: '@L["of"]', rows: '@L["Rows"]', all: '@L["All"]', prev: '@L["Previous"]', next: '@L["Next"]', sort: '@L["Sort"]', sortHint: '@L["Sorting applies to the rows on this page. Choose All rows to sort everything."]' };
</script>
<script src="~/js/report-tables.js" asp-append-version="true"></script>
@RenderSection("Scripts", required: false)

<script>
    function logoutUser() {
        fetch('/Account/Logout', {
            method: 'POST',
            headers: {
                'X-Requested-With': 'XMLHttpRequest'
            }
        })
        .then(() => {
            window.location.replace('/Account/Login');
        })
        .catch(() => {
            window.location.replace('/Account/Login');
        });
    }

    window.addEventListener("pageshow", function (event) {
        if (event.persisted) {
            window.location.replace('/Account/Login');
        }
    });
</script>

</body>
</html>