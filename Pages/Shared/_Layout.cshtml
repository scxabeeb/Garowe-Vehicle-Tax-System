@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Vehicle Tax System</title>

    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="cache-control" content="no-cache, no-store, must-revalidate" />
    <meta http-equiv="pragma" content="no-cache" />
    <meta http-equiv="expires" content="0" />

    <link rel="icon" type="image/jpeg" href="/images/Logo.jpeg" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700;800&display=swap" rel="stylesheet">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

    <style>
        :root {
            --brand-blue: #1f4ed3;
            --brand-navy: #0f2b73;
            --brand-soft: #eef3ff;
            --text-dark: #1f2937;
        }

        body {
            font-family: 'Manrope', sans-serif;
            color: var(--text-dark);
            background: linear-gradient(180deg, #f8fbff 0%, #f4f6f8 42%, #f7f7f7 100%);
        }

        .app-navbar {
            background: linear-gradient(90deg, #0f172a 0%, #132f73 55%, #1f4ed3 100%) !important;
        }

        .navbar-brand {
            background: rgba(255, 255, 255, .1);
            border: 1px solid rgba(255, 255, 255, .22);
            border-radius: .75rem;
            padding: .35rem .7rem;
            backdrop-filter: blur(3px);
        }

        .navbar-brand img {
            border-radius: 50%;
            border: 2px solid rgba(255, 255, 255, .6);
        }

        .navbar .nav-link {
            border-radius: .5rem;
            margin: 0 .15rem;
            padding: .45rem .65rem !important;
            transition: all .18s ease-in-out;
            color: rgba(255, 255, 255, .93) !important;
        }

        .navbar .nav-link:hover,
        .navbar .nav-link:focus {
            color: #fff !important;
            background: rgba(255, 255, 255, .14);
            transform: translateY(-1px);
        }

        .navbar .nav-link.active,
        .navbar .show > .nav-link {
            color: #fff !important;
            background: rgba(255, 255, 255, .22);
            box-shadow: inset 0 0 0 1px rgba(255, 255, 255, .18);
        }

        .dropdown-menu {
            z-index: 1080;
            border-radius: .8rem;
        }

        .dropdown-item {
            border-radius: .5rem;
            margin: .08rem .35rem;
            width: calc(100% - .7rem);
        }

        .dropdown-item:hover {
            background: var(--brand-soft);
            color: var(--brand-navy);
        }

        .menu-category {
            font-size: .72rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .08em;
            color: #64748b;
            padding: .45rem .9rem .2rem;
        }

        .profile-trigger {
            background: rgba(255, 255, 255, .12);
            border: 1px solid rgba(255, 255, 255, .2);
            border-radius: .8rem;
            padding: .3rem .55rem !important;
        }

        .profile-trigger:hover {
            background: rgba(255, 255, 255, .2);
        }

        .profile-avatar {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            background: linear-gradient(145deg, #ffd666 0%, #f59f00 100%);
            color: #111827;
            font-weight: 800;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border: 2px solid rgba(255, 255, 255, .55);
        }

        .profile-avatar-lg {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            background: linear-gradient(145deg, #ffe082 0%, #f59e0b 100%);
            color: #111827;
            font-weight: 800;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

        .profile-menu {
            min-width: 280px;
        }

        .profile-card {
            display: flex;
            align-items: center;
            gap: .7rem;
            background: linear-gradient(90deg, #f4f7ff 0%, #eef3ff 100%);
            border: 1px solid #dbe7ff;
            border-radius: .8rem;
            padding: .6rem .7rem;
        }

        .report-banner {
            background: linear-gradient(90deg, #ffffff 0%, #f5f8ff 52%, #edf2ff 100%);
            border: 1px solid #dbe7ff;
            border-radius: 1rem;
            box-shadow: 0 10px 24px rgba(15, 43, 115, .08);
            padding: .9rem 1rem;
            margin-bottom: 1rem;
        }

        /* Horizontal pagination scroller for large page counts */
        .pagination {
            flex-direction: row;
            flex-wrap: nowrap;
            overflow-x: auto;
            overflow-y: hidden;
            align-items: stretch;
            justify-content: flex-start !important;
            gap: .25rem;
            white-space: nowrap;
            padding-bottom: .25rem;
        }

        .pagination .page-link {
            min-width: 3rem;
            text-align: center;
        }

        @@media (max-width: 768px) {
            .pagination .page-link {
                padding: .25rem .5rem;
                font-size: .9rem;
                min-width: 2.75rem;
            }
        }
    </style>
</head>

<body class="d-flex flex-column min-vh-100">

<nav class="navbar navbar-expand-lg navbar-dark app-navbar shadow">
    <div class="container-fluid">

        <a class="navbar-brand d-flex align-items-center gap-2" asp-page="/Index">
            <img src="/images/Logo.jpeg" width="40" height="40" />
            <span class="fw-bold text-uppercase" style="letter-spacing:.45px;">
                Garowe Local Government Vehicle Tax
            </span>
        </a>

        <button class="navbar-toggler" type="button"
                data-bs-toggle="collapse"
                data-bs-target="#mainNav">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="mainNav">

            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    var isAdmin = User.IsInRole("Admin");
                    var canVehicleView = isAdmin || User.HasClaim("permission", "vehicle.view");
                    var canPaymentView = isAdmin || User.HasClaim("permission", "payment.view");
                    var canPaymentCreate = isAdmin || User.HasClaim("permission", "payment.create");
                    var canReportsView = isAdmin || User.HasClaim("permission", "reports.view");
                    var canUserView = isAdmin || User.HasClaim("permission", "user.view");
                    var canUserCreate = isAdmin || User.HasClaim("permission", "user.create");
                    var canRevenueAccountView = isAdmin || User.HasClaim("permission", "revenueaccount.view");
                    var currentPath = (Context.Request.Path.Value ?? string.Empty).ToLowerInvariant();

                    var isDataSetup = currentPath.StartsWith("/vehicles") ||
                                      currentPath.StartsWith("/cartypes") ||
                                      currentPath.StartsWith("/movements") ||
                                      currentPath.StartsWith("/taxamounts") ||
                                      currentPath.StartsWith("/checkpoints") ||
                                      currentPath.StartsWith("/revenueaccounts");
                    var isPayments = currentPath.StartsWith("/payments") ||
                                     currentPath.StartsWith("/receiptreferences");
                    var isReports = currentPath.StartsWith("/reports") ||
                                    currentPath.StartsWith("/transactions");
                    var isAdministration = currentPath.StartsWith("/account/users") ||
                                           currentPath.StartsWith("/account/register") ||
                                           currentPath.StartsWith("/account/usersecurity");

                    @if (canVehicleView)
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle d-flex align-items-center gap-1 @(isDataSetup ? "active" : "")"
                               href="#"
                               role="button"
                               data-bs-toggle="dropdown">
                                <i class="bi bi-grid-1x2"></i> Data & Setup
                            </a>
                            <ul class="dropdown-menu shadow border-0">
                                <li class="menu-category">Registry</li>
                                <li>
                                    <a class="dropdown-item d-flex align-items-center gap-2" asp-page="/Vehicles/Index">
                                        <i class="bi bi-truck"></i> Vehicles
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item d-flex align-items-center gap-2" asp-page="/CarTypes/Index">
                                        <i class="bi bi-diagram-3"></i> Car Types
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item d-flex align-items-center gap-2" asp-page="/Movements/Index">
                                        <i class="bi bi-arrow-left-right"></i> Movements
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider" /></li>
                                <li class="menu-category">Tax Setup</li>
                                <li>
                                    <a class="dropdown-item d-flex align-items-center gap-2" asp-page="/TaxAmounts/Index">
                                        <i class="bi bi-currency-dollar"></i> Tax Amounts
                                    </a>
                                </li>
                                @if (isAdmin)
                                {
                                    <li>
                                        <a class="dropdown-item d-flex align-items-center gap-2" asp-page="/Checkpoints/Index">
                                            <i class="bi bi-geo-alt"></i> Checkpoints
                                        </a>
                                    </li>
                                }
                                @if (canRevenueAccountView)
                                {
                                    <li>
                                        <a class="dropdown-item d-flex align-items-center gap-2" asp-page="/RevenueAccounts/Index">
                                            <i class="bi bi-wallet2"></i> Revenue Accounts
                                        </a>
                                    </li>
                                }
                            </ul>
                        </li>
                    }

                    @if (canPaymentView || canPaymentCreate)
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle d-flex align-items-center gap-1 @(isPayments ? "active" : "")"
                               href="#"
                               role="button"
                               data-bs-toggle="dropdown">
                                <i class="bi bi-cash-stack"></i> Payments
                            </a>
                            <ul class="dropdown-menu shadow border-0">
                                <li class="menu-category">Payment Tools</li>
                                @if (canPaymentView)
                                {
                                    <li>
                                        <a class="dropdown-item d-flex align-items-center gap-2" asp-page="/ReceiptReferences/Index">
                                            <i class="bi bi-upload"></i> Receipt References
                                        </a>
                                    </li>
                                }
                                @if (canPaymentCreate)
                                {
                                    <li>
                                        <a class="dropdown-item d-flex align-items-center gap-2" asp-page="/Payments/Collect">
                                            <i class="bi bi-wallet2"></i> Collect Tax
                                        </a>
                                    </li>
                                }
                            </ul>
                        </li>
                    }

                    @if (canUserView || canUserCreate)
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle d-flex align-items-center gap-1 @(isAdministration ? "active" : "")"
                               href="#"
                               role="button"
                               data-bs-toggle="dropdown">
                                <i class="bi bi-shield-check"></i> Administration
                            </a>

                            <ul class="dropdown-menu shadow border-0">
                                <li class="menu-category">User Management</li>
                                @if (canUserView)
                                {
                                    <li>
                                        <a class="dropdown-item d-flex align-items-center gap-2"
                                           asp-page="/Account/Users">
                                            <i class="bi bi-list-ul"></i>
                                            Manage Users
                                        </a>
                                    </li>
                                }

                                @if (canUserCreate)
                                {
                                    <li>
                                        <a class="dropdown-item d-flex align-items-center gap-2"
                                           asp-page="/Account/Register">
                                            <i class="bi bi-person-plus"></i>
                                            Create User
                                        </a>
                                    </li>
                                }

                                @if (canUserView)
                                {
                                    <li>
                                        <a class="dropdown-item d-flex align-items-center gap-2"
                                           asp-page="/Account/UserSecurity">
                                            <i class="bi bi-shield-lock"></i>
                                            User Security
                                        </a>
                                    </li>
                                }
                            </ul>
                        </li>
                    }

                    @if (canReportsView)
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle d-flex align-items-center gap-1 @(isReports ? "active" : "")"
                               href="#"
                               role="button"
                               data-bs-toggle="dropdown">
                                <i class="bi bi-bar-chart-line"></i> Reports
                            </a>

                            <ul class="dropdown-menu shadow border-0" style="max-height: 75vh; overflow-y: auto;">
                                <li class="menu-category">Operations Reports</li>
                                <li>
                                    <a class="dropdown-item d-flex align-items-center gap-2"
                                       asp-page="/Reports/vehicles">
                                        <i class="bi bi-truck"></i>
                                        Vehicle Registry Report
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item d-flex align-items-center gap-2"
                                       asp-page="/Reports/movements">
                                        <i class="bi bi-arrow-left-right"></i>
                                        Movement Catalog Report
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item d-flex align-items-center gap-2"
                                       asp-page="/Reports/taxmovement">
                                        <i class="bi bi-bar-chart"></i>
                                        Tax by Movement Report
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item d-flex align-items-center gap-2"
                                       asp-page="/Reports/taxmovementcartype">
                                        <i class="bi bi-diagram-3"></i>
                                        Tax by Movement & Car Type
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item d-flex align-items-center gap-2"
                                       asp-page="/Reports/TaxAmountReport">
                                        <i class="bi bi-currency-dollar"></i>
                                        Tax Amount Schedule
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item d-flex align-items-center gap-2"
                                       asp-page="/Reports/ReceiptReferences">
                                        <i class="bi bi-receipt"></i>
                                        Receipt References Report
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item d-flex align-items-center gap-2"
                                       asp-page="/Reports/usersreport">
                                        <i class="bi bi-people"></i>
                                        User Activity Report
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider" /></li>
                                <li class="menu-category">Revenue & Audit</li>
                                <li>
                                    <a class="dropdown-item d-flex align-items-center gap-2"
                                       asp-page="/Reports/Index">
                                        <i class="bi bi-graph-up-arrow"></i>
                                        Payment Summary Report
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item d-flex align-items-center gap-2"
                                       asp-page="/Reports/RevenueAccountReport">
                                        <i class="bi bi-wallet2"></i>
                                        Revenue Account Report
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item d-flex align-items-center gap-2"
                                       asp-page="/Reports/CheckpointReport">
                                        <i class="bi bi-geo-alt"></i>
                                        Checkpoint Collection Report
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item d-flex align-items-center gap-2"
                                       asp-page="/Reports/Logs">
                                        <i class="bi bi-journal-text"></i>
                                        Logs & Audit Report
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item d-flex align-items-center gap-2"
                                       asp-page="/Transactions/Index">
                                        <i class="bi bi-arrow-left-right"></i>
                                        Transactions Audit Log
                                    </a>
                                </li>
                             </ul>
                        </li>
                    }
                }
            </ul>

            <ul class="navbar-nav ms-auto align-items-center">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <li class="nav-item dropdown">
                        <a class="nav-link profile-trigger dropdown-toggle d-flex align-items-center gap-2"
                           href="#"
                           role="button"
                           data-bs-toggle="dropdown">

                            <span class="profile-avatar">
                                @User.Identity!.Name!.Substring(0,1).ToUpper()
                            </span>

                            <span class="d-none d-md-block">
                                <small class="d-block text-white-50" style="line-height:1;">Signed in as</small>
                                <span class="fw-semibold" style="line-height:1.2;">@User.Identity.Name</span>
                            </span>
                        </a>

                        <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2 profile-menu">
                            <li class="px-3 pt-3 pb-2">
                                <div class="profile-card">
                                    <span class="profile-avatar-lg">
                                        @(User.Identity!.Name.Substring(0,1).ToUpper())
                                    </span>
                                    <div>
                                        <div class="fw-bold">@User.Identity.Name</div>
                                        <small class="text-muted">
                                            Role: @(User.IsInRole("Admin") ? "Administrator" : "User")
                                        </small>
                                    </div>
                                </div>
                            </li>

                            <li><hr class="dropdown-divider" /></li>

                            <li>
                                <a class="dropdown-item d-flex align-items-center"
                                   asp-page="/Account/ChangePassword">
                                    <i class="bi bi-key me-2"></i>
                                    Change Password
                                </a>
                            </li>

                            <li><hr class="dropdown-divider" /></li>

                            <li>
                                <button type="button"
                                        class="dropdown-item text-danger d-flex align-items-center"
                                        onclick="logoutUser()">
                                    <i class="bi bi-box-arrow-right me-2"></i>
                                    Logout
                                </button>
                            </li>
                        </ul>
                    </li>
                }
                else
                {
                    <li class="nav-item">
                        <a class="btn btn-sm btn-outline-light" asp-page="/Account/Login">
                            <i class="bi bi-box-arrow-in-right"></i> Login
                        </a>
                    </li>
                }
            </ul>

        </div>
    </div>
</nav>

<main class="container mt-4 flex-fill">
    @RenderBody()
</main>

<footer class="mt-5 py-3 border-top text-center text-muted small bg-white">
    <div class="d-flex align-items-center justify-content-center gap-2">
        <img src="/images/Logo.jpeg" width="24" height="24" style="border-radius:50%;" />
        <span>&copy; @VehicleTax.Web.AppTime.Now.Year Garowe Local Government - Vehicle Tax System</span>
    </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

@RenderSection("Scripts", required: false)

<script>
    function logoutUser() {
        fetch('/Account/Logout', {
            method: 'POST',
            headers: {
                'X-Requested-With': 'XMLHttpRequest'
            }
        })
        .then(() => {
            window.location.replace('/Account/Login');
        })
        .catch(() => {
            window.location.replace('/Account/Login');
        });
    }

    window.addEventListener("pageshow", function (event) {
        if (event.persisted) {
            window.location.replace('/Account/Login');
        }
    });
</script>

</body>
</html>