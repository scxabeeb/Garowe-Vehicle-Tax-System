@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
<!DOCTYPE html>
<html lang="@L.Code" style="height:100%; margin:0;">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - @L["Vehicle Tax System"]</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link href="~/lib/bootstrap/bootstrap.min.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/lib/bootstrap-icons/bootstrap-icons.min.css" rel="stylesheet" asp-append-version="true" />

    <style>
        html, body {
            height: 100%;
            margin: 0;
        }

        body {
            overflow: hidden;
        }

        .login-bg {
            min-height: 100vh;
            width: 100vw;
            background: linear-gradient(135deg, #4f6cff 0%, #3ccf91 100%);
            display: flex;
            justify-content: center;
            align-items: center;
            flex-direction: column;
        }
    </style>
</head>

<body>
    <div class="login-bg">
        @RenderBody()
    </div>

    <script src="~/lib/bootstrap/bootstrap.bundle.min.js" asp-append-version="true"></script>
</body>
</html>
