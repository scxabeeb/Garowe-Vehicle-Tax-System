@page
@model VehicleTax.Web.Pages.Finance.Rv.IndexModel
@{
    ViewData["Title"] = L["RV History"];
    Layout = "_Layout";
}

<div class="container-fluid py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <h2 class="mb-0">@L["RV History"]</h2>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-primary" onclick="window.print()">
                <i class="bi bi-printer"></i> @L["Print"]
            </button>
            <a class="btn btn-outline-secondary" asp-page="/Finance/Index">← Finance Dashboard</a>
        </div>
    </div>

    <form method="get" class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="row g-2 align-items-end">
                <div class="col-md-2">
                    <label class="form-label small mb-0">@L["RV Number"]</label>
                    <input class="form-control" asp-for="RvNumber" placeholder="RV-000001" />
                </div>
                <div class="col-md-2">
                    <label class="form-label small mb-0">@L["RV Date"]</label>
                    <input type="date" class="form-control" asp-for="Date" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small mb-0">@L["Account"]</label>
                    <select class="form-select" asp-for="AccountId">
                        <option value="">@L["All accounts"]</option>
                        @foreach (var a in Model.Accounts)
                        {
                            <option value="@a.Id">@a.AccountCode - @a.AccountName</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small mb-0">@L["Status"]</label>
                    <select class="form-select" asp-for="Status">
                        <option value="">@L["All"]</option>
                        <option value="Draft">@L["Draft"]</option>
                        <option value="Prepared">@L["Prepared"]</option>
                        <option value="ReadyForFmis">@L["ReadyForFmis"]</option>
                        <option value="Transferred">@L["Transferred"]</option>
                        <option value="Cancelled">@L["Cancelled"]</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small mb-0">@L["FMIS Status"]</label>
                    <select class="form-select" asp-for="FmisStatus">
                        <option value="">@L["All"]</option>
                        <option value="NotTransferred">@L["NotTransferred"]</option>
                        <option value="ReadyForFmis">@L["ReadyForFmis"]</option>
                        <option value="Failed">@L["Failed"]</option>
                        <option value="Transferred">@L["Transferred"]</option>
                    </select>
                </div>
                <div class="col-md-1">
                    <button class="btn btn-primary w-100" type="submit">@L["Search"]</button>
                </div>
            </div>
        </div>
    </form>

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light"><tr>
                    <th>@L["RV Number"]</th><th>@L["System ID"]</th><th>@L["Date"]</th><th>@L["Account"]</th>
                    <th class="text-end">@L["Transactions"]</th><th class="text-end">@L["Amount"]</th>
                    <th>@L["Prepared By"]</th><th>@L["Status"]</th><th>FMIS</th>
                </tr></thead>
                <tbody>
                @foreach (var r in Model.Rows)
                {
                    <tr>
                        <td><a asp-page="/Finance/Rv/Details" asp-route-number="@r.RvNumber" class="fw-semibold">@r.RvNumber</a></td>
                        <td><small class="text-muted font-monospace">@(r.SystemId?.Length > 12 ? r.SystemId[..12] + "…" : r.SystemId)</small></td>
                        <td>@AppTime.ToLocal(r.RvDate).ToString("dd MMM yyyy")</td>
                        <td>@(r.Account ?? "-")</td>
                        <td class="text-end">@r.TotalTransactions</td>
                        <td class="text-end">$@r.TotalAmount.ToString("N2")</td>
                        <td>@(r.PreparedBy ?? "-")</td>
                        <td>
                            <span class="badge @(r.Status == "Transferred" ? "bg-success" : r.Status == "Cancelled" ? "bg-danger" : r.Status == "ReadyForFmis" ? "bg-info text-dark" : "bg-warning text-dark")">
                                @r.Status
                            </span>
                        </td>
                        <td>
                            <span class="badge @(r.FmisStatus == "Transferred" ? "bg-success" : r.FmisStatus == "Failed" ? "bg-danger" : "bg-secondary")">
                                @r.FmisStatus
                            </span>
                            @if (!string.IsNullOrEmpty(r.FmisBatchNumber))
                            {
                                <div class="small text-muted">@r.FmisBatchNumber</div>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Rows.Any())
                {
                    <tr><td colspan="9" class="text-center text-muted py-4">@L["No RV documents found."]</td></tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
