@page
@model VehicleTax.Web.Pages.Finance.IndexModel
@{
    ViewData["Title"] = "Finance Dashboard";
    Layout = "_Layout";
}

<div class="container-fluid py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <div>
            <h2 class="mb-0">Finance Dashboard</h2>
            <div class="text-muted">Today's Payments · Account Summary · RF Management · FMIS Transfers</div>
        </div>
        <form method="get" class="d-flex gap-2 align-items-end">
            <div>
                <label class="form-label mb-0 small">Payment Date</label>
                <input type="date" class="form-control" asp-for="Date" />
            </div>
            <button class="btn btn-primary" type="submit">Apply</button>
            <a class="btn btn-outline-secondary" asp-page="/Finance/Rf/Index">RF History</a>
        </form>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-6 col-xl-3">
            <div class="card shadow-sm h-100"><div class="card-body">
                <div class="text-muted small">Total Paid Transactions</div>
                <div class="fs-3 fw-bold">@Model.TotalPayments</div>
                <div class="text-muted small">@Model.Date?.ToString("dd MMMM yyyy")</div>
            </div></div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="card shadow-sm h-100"><div class="card-body">
                <div class="text-muted small">Total Paid Amount</div>
                <div class="fs-3 fw-bold">$@Model.TotalAmount.ToString("N2")</div>
            </div></div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="card shadow-sm h-100"><div class="card-body">
                <div class="text-muted small">RFs (Prepared / Ready / Transferred)</div>
                <div class="fs-3 fw-bold">@Model.RfPrepared / @Model.RfReadyForFmis / @Model.RfTransferred</div>
                @if (Model.RfFailed > 0)
                {
                    <div class="small text-danger">@Model.RfFailed FMIS transfer failure(s)</div>
                }
            </div></div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="card shadow-sm h-100 border-warning"><div class="card-body">
                <div class="text-muted small">Not Yet Included in RF</div>
                <div class="fs-3 fw-bold text-warning">@Model.NotYetInRf</div>
                <div class="text-muted small">$@Model.NotYetInRfAmount.ToString("N2") remaining</div>
            </div></div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-lg-6">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white fw-semibold">TODAY'S ACCOUNT SUMMARY</div>
                <div class="card-body p-0">
                    @if (!Model.AccountSummary.Any())
                    {
                        <div class="p-4 text-center text-muted">No paid payments for this date.</div>
                    }
                    else
                    {
                        <table class="table mb-0 align-middle">
                            <thead class="table-light"><tr>
                                <th>Financial Account</th><th class="text-end">Transactions</th><th class="text-end">Total</th><th></th>
                            </tr></thead>
                            <tbody>
                            @foreach (var a in Model.AccountSummary)
                            {
                                <tr>
                                    <td>@a.AccountName</td>
                                    <td class="text-end">@a.Transactions</td>
                                    <td class="text-end">$@a.Total.ToString("N2")</td>
                                    <td class="text-end">
                                        <a class="btn btn-sm btn-outline-primary"
                                           asp-page="/Finance/Account"
                                           asp-route-date="@Model.Date?.ToString("yyyy-MM-dd")"
                                           asp-route-accountId="@a.RevenueAccountId">View →</a>
                                    </td>
                                </tr>
                            }
                            </tbody>
                            <tfoot class="table-light fw-bold"><tr>
                                <td>TOTAL</td>
                                <td class="text-end">@Model.TotalPayments</td>
                                <td class="text-end">$@Model.TotalAmount.ToString("N2")</td>
                                <td></td>
                            </tr></tfoot>
                        </table>
                    }
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white fw-semibold">Reconciliation — Paid → RF → FMIS</div>
                <div class="card-body p-0">
                    <table class="table mb-0 align-middle">
                        <thead class="table-light"><tr><th>Stage</th><th class="text-end">Count</th><th class="text-end">Amount</th></tr></thead>
                        <tbody>
                            <tr><td>Paid Payments</td><td class="text-end">@Model.TotalPayments</td><td class="text-end">$@Model.TotalAmount.ToString("N2")</td></tr>
                            <tr><td>Included in RF</td><td class="text-end">@Model.IncludedInRf</td><td class="text-end">$@Model.IncludedInRfAmount.ToString("N2")</td></tr>
                            <tr><td>Transferred to FMIS</td><td class="text-end">@Model.TransferredTo_Fmis</td><td class="text-end">$@Model.TransferredTo_FmisAmount.ToString("N2")</td></tr>
                            <tr class="table-warning fw-bold"><td>Remaining (needs RF)</td><td class="text-end">@Model.NotYetInRf</td><td class="text-end">$@Model.NotYetInRfAmount.ToString("N2")</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-white fw-semibold">TODAY'S PAYMENTS (@Model.Date?.ToString("dd MMMM yyyy"))</div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light"><tr>
                    <th>Payment ID</th><th>Ref No.</th><th>Invoice ID</th><th>Receipt</th><th>Golis/Bill No.</th>
                    <th>Vehicle</th><th>Account</th><th class="text-end">Amount</th><th>Collector</th>
                    <th>Paid At</th><th>Status</th><th>FMIS Transfer Status</th>
                </tr></thead>
                <tbody>
                @foreach (var p in Model.Payments)
                {
                    <tr>
                        <td>@p.PaymentId</td>
                        <td>@(p.ReferenceNo?.ToString() ?? "-")</td>
                        <td>@p.InvoiceNumber</td>
                        <td>@(p.ReceiptNo ?? "-")</td>
                        <td>@(p.GolisBillNo ?? "-")</td>
                        <td>@p.Vehicle</td>
                        <td>@(p.Account ?? "-")</td>
                        <td class="text-end">$@p.Amount.ToString("N2")</td>
                        <td>@(p.Collector ?? "-")</td>
                        <td>@AppTime.ToLocal(p.PaidAt).ToString("dd MMM HH:mm")</td>
                        <td><span class="badge bg-success">@p.Status</span></td>
                        <td>
                            @if (p.RfNumber != null)
                            {
                                <span class="badge @(p.FmisStatus == "Transferred" ? "bg-success" : p.FmisStatus == "FMIS Failed" ? "bg-danger" : "bg-info text-dark")">
                                    @p.FmisStatus
                                </span>
                                <a class="small" asp-page="/Finance/Rf/Details" asp-route-number="@p.RfNumber">@p.RfNumber</a>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Not Included</span>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Payments.Any())
                {
                    <tr><td colspan="12" class="text-center text-muted py-4">No paid payments found for this date.</td></tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

