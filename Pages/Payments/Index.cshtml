@page
@model VehicleTax.Web.Pages.Payments.IndexModel
@{
    ViewData["Title"] = L["Payments List"];
    string when(DateTime utc) => VehicleTax.Web.AppTime.ToLocal(utc).ToString("dd MMM yyyy HH:mm");
    var statuses = new[]
    {
        ("all", L["All"], Model.PaidCount + Model.PendingCount + Model.CancelledCount, Model.PaidAmount + Model.PendingAmount + Model.CancelledAmount, "#0b57d0", "#eef4ff", "bi-list-ul"),
        ("paid", L["Paid"], Model.PaidCount, Model.PaidAmount, "#15803d", "#dcfce7", "bi-check-circle"),
        ("pending", L["Pending"], Model.PendingCount, Model.PendingAmount, "#b45309", "#fef3c7", "bi-hourglass-split"),
        ("cancelled", L["Cancelled"], Model.CancelledCount, Model.CancelledAmount, "#b91c1c", "#fee2e2", "bi-x-circle"),
    };
}
<style>
    .pl-hero { background: linear-gradient(135deg, #0b57d0, #1e3a8a); color: #fff; border-radius: 18px; padding: 20px 24px; }
    .pl-card { border: 1px solid #e2e8f0; border-radius: 16px; background: #fff; overflow: hidden; }
    .pl-stat { display: flex; gap: 12px; align-items: center; border: 2px solid #e2e8f0; border-radius: 16px; background: #fff; padding: 12px 14px;
        text-decoration: none; color: inherit; height: 100%; transition: all .15s; }
    .pl-stat:hover { border-color: #93b4f5; color: inherit; }
    .pl-stat.active { border-color: #0b57d0; box-shadow: 0 2px 10px rgba(11,87,208,.12); }
    .pl-stat .ic { width: 40px; height: 40px; border-radius: 12px; display: grid; place-items: center; font-size: 1.15rem; flex-shrink: 0; }
    .pl-stat .v { font-size: 1.3rem; font-weight: 800; line-height: 1.1; }
    .pl-stat .l { font-size: 12px; color: #64748b; font-weight: 600; }
    .pl-table thead th { font-size: 12px; text-transform: uppercase; letter-spacing: .04em; color: #64748b; background: #f8fafc; white-space: nowrap; }
    .pl-table td { vertical-align: middle; font-size: 14px; }
    .pl-acc { font-size: 12px; font-weight: 700; border-radius: 999px; padding: 3px 10px; background: #eef4ff; color: #0b57d0; white-space: nowrap; }
    .pl-act { width: 34px; height: 34px; border-radius: 10px; display: inline-grid; place-items: center; border: 1px solid #e2e8f0; background: #fff; color: #334155; }
    .pl-act:hover { background: #f1f5f9; }
    .pl-act.danger { color: #dc2626; }
    .pl-act.disabled { opacity: .35; pointer-events: none; }
</style>

<div class="container-fluid py-4" style="max-width: 1440px;">
    <div class="pl-hero mb-3 d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <h3 class="fw-bold mb-1"><i class="bi bi-receipt-cutoff me-2"></i>@L["Payments List"]</h3>
            <div style="opacity:.85">@(Model.IsPersonal ? L["The payments you collected."] : L["Search any payment, open its receipt, transfer or cancel it."])</div>
        </div>
        <div class="d-flex gap-2">
            @if (Model.IsAdmin)
            {
                <a class="btn btn-outline-light" asp-page="/Finance/TransferPayments"><i class="bi bi-arrow-left-right me-1"></i>@L["Transfer Payments"]</a>
            }
            <a class="btn btn-light fw-semibold" asp-page="/Payments/Collect"><i class="bi bi-wallet2 me-1"></i>@L["Collect Tax"]</a>
        </div>
    </div>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success d-flex gap-2 align-items-center"><i class="bi bi-check-circle-fill"></i>@TempData["Message"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-warning d-flex gap-2 align-items-center"><i class="bi bi-exclamation-triangle-fill"></i>@L[TempData["Error"]!.ToString()!]</div>
    }

    <form method="get" class="pl-card mb-3">
        <div class="p-3 row g-2 align-items-end">
            <div class="col-md-4 col-xl-3">
                <label class="form-label small fw-semibold mb-1">@L["Search"]</label>
                <input name="Search" value="@Model.Search" class="form-control" placeholder="@L["System ID, invoice no, plate, owner, Golis bill"]" autofocus />
            </div>
            <div class="col-6 col-md-2 col-xl-2">
                <label class="form-label small fw-semibold mb-1">@L["From Date"]</label>
                <input type="date" name="FromDate" value="@Model.FromDate?.ToString("yyyy-MM-dd")" class="form-control" />
            </div>
            <div class="col-6 col-md-2 col-xl-2">
                <label class="form-label small fw-semibold mb-1">@L["To Date"]</label>
                <input type="date" name="ToDate" value="@Model.ToDate?.ToString("yyyy-MM-dd")" class="form-control" />
            </div>
            @if (!Model.IsPersonal)
            {
                <div class="col-6 col-md-2 col-xl-1">
                    <label class="form-label small fw-semibold mb-1">@L["Collector"]</label>
                    <select name="CollectorId" class="form-select">
                        <option value="">@L["All"]</option>
                        @foreach (var u in Model.Collectors)
                        {
                            <option value="@u.Id" selected="@(u.Id == Model.CollectorId ? "selected" : null)">@u.Username</option>
                        }
                    </select>
                </div>
            }
            <div class="col-6 col-md-2 col-xl-1">
                <label class="form-label small fw-semibold mb-1">@L["Checkpoint"]</label>
                <select name="CheckpointId" class="form-select">
                    <option value="">@L["All"]</option>
                    @foreach (var c in Model.Checkpoints)
                    {
                        <option value="@c.Id" selected="@(c.Id == Model.CheckpointId ? "selected" : null)">@c.Name</option>
                    }
                </select>
            </div>
            <div class="col-6 col-md-2 col-xl-2">
                <label class="form-label small fw-semibold mb-1">@L["Tariff"]</label>
                <select name="MovementId" class="form-select">
                    <option value="">@L["All Tariffs"]</option>
                    @foreach (var m in Model.Movements)
                    {
                        <option value="@m.Id" selected="@(m.Id == Model.MovementId ? "selected" : null)">@m.Name</option>
                    }
                </select>
            </div>
            @if (!Model.IsPersonal)
            {
                <div class="col-6 col-md-2 col-xl-1">
                    <label class="form-label small fw-semibold mb-1" title="@L["Pending or cancelled payments: collector who made the mistake"]">@L["Mistake by"]</label>
                    <select name="MistakeById" class="form-select">
                        <option value="">@L["All"]</option>
                        @foreach (var u in Model.Collectors)
                        {
                            <option value="@u.Id" selected="@(u.Id == Model.MistakeById ? "selected" : null)">@u.Username</option>
                        }
                    </select>
                </div>
            }
            @if (!Model.IsPersonal)
            {
                <div class="col-6 col-md-2 col-xl-2">
                    <label class="form-label small fw-semibold mb-1">@L["Pending reason"]</label>
                    <select name="PendingReason" class="form-select">
                        <option value="">@L["All"]</option>
                        @foreach (var pr in VehicleTax.Web.Models.PendingReasons.All)
                        {
                            <option value="@pr" selected="@(pr == Model.PendingReason ? "selected" : null)">@L[pr]</option>
                        }
                    </select>
                </div>
            }
            <input type="hidden" name="Status" value="@Model.Status" />
            <input type="hidden" name="PageSize" value="@Model.PageSize" />
            <div class="col-md-auto d-flex gap-2">
                <button class="btn btn-primary px-3"><i class="bi bi-search me-1"></i>@L["Search"]</button>
                <a class="btn btn-outline-secondary" asp-page="/Payments/Index">@L["Reset"]</a>
            </div>
        </div>
    </form>

    <div class="row g-3 mb-3">
        @foreach (var s in statuses)
        {
            <div class="col-6 col-lg-3">
                <a class="pl-stat @(Model.Status == s.Item1 ? "active" : "")"
                   asp-route-Status="@s.Item1" asp-route-Search="@Model.Search"
                   asp-route-FromDate="@Model.FromDate?.ToString("yyyy-MM-dd")" asp-route-ToDate="@Model.ToDate?.ToString("yyyy-MM-dd")"
                   asp-route-CollectorId="@Model.CollectorId" asp-route-CheckpointId="@Model.CheckpointId" asp-route-MovementId="@Model.MovementId" asp-route-MistakeById="@Model.MistakeById" asp-route-PendingReason="@Model.PendingReason"
                   asp-route-PageSize="@Model.PageSize">
                    <span class="ic" style="background:@s.Item6;color:@s.Item5"><i class="bi @s.Item7"></i></span>
                    <div>
                        <div class="v">@s.Item3.ToString("N0") <span class="fs-6 text-muted fw-semibold">· $@s.Item4.ToString("N2")</span></div>
                        <div class="l">@s.Item2</div>
                    </div>
                </a>
            </div>
        }
    </div>

    <div class="pl-card">
        <div class="table-responsive">
            <table class="table pl-table mb-0">
                <thead>
                    <tr>
                        <th>@L["System ID"]</th>
                        <th>@L["Invoice No"]</th>
                        <th>@L["Date"]</th>
                        <th>@L["Plate"]</th>
                        <th>@L["Owner"]</th>
                        <th>@L["Tariff"]</th>
                        <th>@L["Revenue Account"]</th>
                        <th>@L["Collector"]</th>
                        <th>@L["Checkpoint"]</th>
                        <th>@L["Golis Bill No"]</th>
                        <th class="text-end">@L["Amount"]</th>
                        <th>@L["Status"]</th>
                        <th class="text-end">@L["Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Rows)
                    {
                        var p = r.Payment;
                        <tr class="@(p.IsReverted ? "table-danger" : "")">
                            <td class="fw-semibold">@p.Id</td>
                            <td class="text-nowrap">@p.InvoiceNumber<div class="small text-primary fw-semibold">@p.ShortCode</div></td>
                            <td class="text-nowrap small">@when(p.PaidAt)</td>
                            <td class="fw-semibold">@p.Vehicle?.PlateNumber</td>
                            <td>@p.Vehicle?.OwnerName</td>
                            <td>@(p.Movement?.Name ?? p.MovementType)</td>
                            <td><span class="pl-acc">@(r.Account ?? "—")</span></td>
                            <td>@(p.Collector?.Username ?? "—")</td>
                            <td>@(p.Checkpoint?.Name ?? "—")</td>
                            <td>@(string.IsNullOrWhiteSpace(p.TransactionId) ? "—" : p.TransactionId)</td>
                            <td class="text-end fw-semibold">$@p.Amount.ToString("N2")</td>
                            <td>
                                @if (p.IsReverted)
                                {
                                    <span class="badge bg-danger" title="@p.RevertReason">@L["Cancelled"]</span>
                                    <div class="small text-muted">@L["by"] @p.RevertedByUser?.Username</div>
                                    @if (p.MistakeByUser != null)
                                    {
                                        <div class="small text-danger fw-semibold"><i class="bi bi-person-exclamation"></i> @L["Mistake by"]: @p.MistakeByUser.Username</div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(p.RevertReason))
                                    {
                                        <div class="small text-muted text-truncate" style="max-width:180px" title="@p.RevertReason">@p.RevertReason</div>
                                    }
                                }
                                else if (p.IsPaid)
                                {
                                    <span class="badge bg-success">@L["Paid"]</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">@L["Pending"]</span>
                                    @if (p.PendingReason != null)
                                    {
                                        <div class="small fw-semibold" style="color:#b45309"><i class="bi bi-info-circle"></i> @L[p.PendingReason]</div>
                                    }
                                    @if (p.MistakeByUser != null)
                                    {
                                        <div class="small text-danger fw-semibold"><i class="bi bi-person-exclamation"></i> @L["Mistake by"]: @p.MistakeByUser.Username</div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(p.PendingNote))
                                    {
                                        <div class="small text-muted text-truncate" style="max-width:180px" title="@p.PendingNote">@p.PendingNote</div>
                                    }
                                }
                                @if (r.RvNumber != null)
                                {
                                    <div class="small text-muted"><i class="bi bi-lock"></i> RV @r.RvNumber</div>
                                }
                            </td>
                            <td class="text-end text-nowrap">
                                <a class="pl-act" title="@L["Open receipt"]" asp-page="/Payments/Receipt" asp-route-paymentId="@p.Id"><i class="bi bi-receipt"></i></a>
                                @if (Model.IsAdmin && !p.IsReverted)
                                {
                                    @if (p.IsPaid)
                                    {
                                        <a class="pl-act @(r.RvNumber != null ? "disabled" : "")" title="@L["Transfer"]"
                                           asp-page="/Finance/TransferPayments" asp-route-Search="@p.InvoiceNumber"><i class="bi bi-arrow-left-right"></i></a>
                                    }
                                    @if (!p.IsPaid)
                                    {
                                        <button type="button" class="pl-act" style="color:#b45309" title="@L["Pending reason"]"
                                                data-bs-toggle="modal" data-bs-target="#plPending"
                                                data-id="@p.Id" data-collector="@(p.MistakeByUserId ?? p.CollectorId)"
                                                data-reason="@p.PendingReason" data-note="@p.PendingNote"
                                                data-label="#@p.Id · @p.InvoiceNumber · @p.Vehicle?.PlateNumber · $@p.Amount.ToString("N2")">
                                            <i class="bi bi-chat-left-text"></i>
                                        </button>
                                    }
                                    @if (Model.CanCancel && p.IsPaid)
                                    {
                                        <button type="button" class="pl-act danger @(r.RvNumber != null ? "disabled" : "")" title="@L["Cancel payment"]"
                                                data-bs-toggle="modal" data-bs-target="#plCancel"
                                                data-id="@p.Id" data-collector="@p.CollectorId" data-label="#@p.Id · @p.InvoiceNumber · @p.Vehicle?.PlateNumber · $@p.Amount.ToString("N2")">
                                            <i class="bi bi-x-circle"></i>
                                        </button>
                                    }
                                }
                            </td>
                        </tr>
                    }
                    @if (!Model.Rows.Any())
                    {
                        <tr><td colspan="13" class="text-center text-muted py-4">@L["No payments found."]</td></tr>
                    }
                </tbody>
            </table>
        </div>
        <partial name="_Pager" model="Model.Pager" />
    </div>
</div>

@if (Model.IsAdmin)
{
    <div class="modal fade" id="plPending" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <form method="post" asp-page-handler="PendingReason" class="modal-content"
                  asp-route-Search="@Model.Search" asp-route-Status="@Model.Status"
                  asp-route-FromDate="@Model.FromDate?.ToString("yyyy-MM-dd")" asp-route-ToDate="@Model.ToDate?.ToString("yyyy-MM-dd")"
                  asp-route-CollectorId="@Model.CollectorId" asp-route-CheckpointId="@Model.CheckpointId" asp-route-MovementId="@Model.MovementId"
                  asp-route-PageSize="@Model.PageSize" asp-route-CurrentPage="@Model.CurrentPage">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-hourglass-split me-2" style="color:#b45309"></i>@L["Why is this payment pending?"]</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="paymentId" id="plPendingId" />
                    <div class="fw-semibold mb-2" id="plPendingLabel"></div>
                    <label class="form-label small fw-semibold">@L["Reason"]</label>
                    <select name="pendingReason" id="plPendingReason" class="form-select">
                        <option value="">@L["No reason (clear)"]</option>
                        @foreach (var pr in VehicleTax.Web.Models.PendingReasons.All)
                        {
                            <option value="@pr">@L[pr]</option>
                        }
                    </select>
                    <label class="form-label small fw-semibold mt-3">@L["Note"]</label>
                    <textarea name="note" id="plPendingNote" class="form-control" rows="2" maxlength="500"></textarea>
                    <label class="form-label small fw-semibold mt-3">@L["Mistake by (collector)"]</label>
                    <select name="mistakeByUserId" id="plPendingMistake" class="form-select">
                        <option value="">@L["No one / not a collector mistake"]</option>
                        @foreach (var u in Model.Collectors)
                        {
                            <option value="@u.Id">@u.Username@(string.IsNullOrWhiteSpace(u.FullName) ? "" : " · " + u.FullName)</option>
                        }
                    </select>
                    <div class="form-text">@L["The payment stays pending; it is not cancelled. If the customer pays, it becomes paid as usual."]</div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@L["Close"]</button>
                    <button type="submit" class="btn btn-warning"><i class="bi bi-check2-circle me-1"></i>@L["Save"]</button>
                </div>
            </form>
        </div>
    </div>
    <script>
        document.getElementById('plPending').addEventListener('show.bs.modal', function (e) {
            var b = e.relatedTarget;
            document.getElementById('plPendingId').value = b.dataset.id;
            document.getElementById('plPendingLabel').textContent = b.dataset.label;
            document.getElementById('plPendingReason').value = b.dataset.reason || '';
            document.getElementById('plPendingNote').value = b.dataset.note || '';
            document.getElementById('plPendingMistake').value = b.dataset.collector || '';
        });
    </script>
}

@if (Model.IsAdmin && Model.CanCancel)
{
    <div class="modal fade" id="plCancel" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <form method="post" asp-page-handler="Cancel" class="modal-content"
                  asp-route-Search="@Model.Search" asp-route-Status="@Model.Status"
                  asp-route-FromDate="@Model.FromDate?.ToString("yyyy-MM-dd")" asp-route-ToDate="@Model.ToDate?.ToString("yyyy-MM-dd")"
                  asp-route-CollectorId="@Model.CollectorId" asp-route-CheckpointId="@Model.CheckpointId" asp-route-MovementId="@Model.MovementId" asp-route-MistakeById="@Model.MistakeById" asp-route-PendingReason="@Model.PendingReason"
                  asp-route-PageSize="@Model.PageSize" asp-route-CurrentPage="@Model.CurrentPage">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-x-circle text-danger me-2"></i>@L["Cancel payment"]</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="paymentId" id="plCancelId" />
                    <div class="fw-semibold mb-2" id="plCancelLabel"></div>
                    <label class="form-label small fw-semibold">@L["Reason"] <span class="text-danger">*</span></label>
                    <textarea name="reason" class="form-control" rows="3" required minlength="3" maxlength="500"></textarea>
                    <label class="form-label small fw-semibold mt-3">@L["Mistake by (collector)"]</label>
                    <select name="mistakeByUserId" id="plCancelMistake" class="form-select">
                        <option value="">@L["No one / not a collector mistake"]</option>
                        @foreach (var u in Model.Collectors)
                        {
                            <option value="@u.Id">@u.Username@(string.IsNullOrWhiteSpace(u.FullName) ? "" : " · " + u.FullName)</option>
                        }
                    </select>
                    <div class="form-text">@L["Starts on the collector who took the payment. Filter by Mistake by to see each collector's mistakes."]</div>
                    <div class="form-text">@L["The payment will no longer count as paid. This is recorded in the Activity Log."]</div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@L["Close"]</button>
                    <button type="submit" class="btn btn-danger"><i class="bi bi-x-circle me-1"></i>@L["Cancel payment"]</button>
                </div>
            </form>
        </div>
    </div>
    <script>
        document.getElementById('plCancel').addEventListener('show.bs.modal', function (e) {
            var b = e.relatedTarget;
            document.getElementById('plCancelId').value = b.dataset.id;
            document.getElementById('plCancelLabel').textContent = b.dataset.label;
            this.querySelector('textarea').value = '';
            document.getElementById('plCancelMistake').value = b.dataset.collector || '';
        });
    </script>
}
