@page
@model VehicleTax.Web.Pages.Payments.CollectModel

<div class="container mt-4">

    <h3 class="fw-bold mb-4">
        <i class="bi bi-cash-coin text-success"></i>
        @L["Collect Vehicle Tax"]
    </h3>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @Model.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-4">
    <div class="col-lg-8">
    <div class="card shadow-sm border-0">
        <div class="card-body p-4">

            <form method="post" id="collectForm">

                <!-- Search -->
                <label class="form-label fw-semibold" for="PlateNumber">@L["Plate Number"]</label>
                <div class="input-group input-group-lg mb-3">
                    <span class="input-group-text"><i class="bi bi-car-front"></i></span>
                    <input asp-for="PlateNumber" class="form-control fw-bold text-uppercase" placeholder="e.g. GAR-1234" autocomplete="off" autofocus />
                    <button asp-page-handler="Search" type="submit" formnovalidate class="btn btn-primary px-4">
                        <i class="bi bi-search me-1"></i>@L["Search"]
                    </button>
                    <button asp-page-handler="Reset" type="submit" formnovalidate class="btn btn-outline-secondary" title="@L["Reset"]">
                        <i class="bi bi-arrow-repeat"></i>
                    </button>
                </div>

                @if (Model.NotFound)
                {
                    <!-- Not found: register here -->
                    <div class="border rounded-4 p-3 mb-3" style="background:#fffbeb;border-color:#fcd34d!important">
                        <div class="fw-bold mb-1"><i class="bi bi-exclamation-circle text-warning me-1"></i>@L["Vehicle not found"] — @Model.PlateNumber.ToUpper()</div>
                        <div class="small text-muted mb-3">@L["Register it now, then continue to payment."]</div>
                        <div class="row g-2">
                            <div class="col-md-4">
                                <label class="form-label small fw-semibold mb-1">@L["Owner Name"]</label>
                                <input name="OwnerName" value="@Model.OwnerName" class="form-control" placeholder="@L["Owner full name"]" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-semibold mb-1">@L["Mobile Number"]</label>
                                <div class="input-group">
                                    <span class="input-group-text fw-semibold">+252</span>
                                    <input name="Mobile" value="@VehicleTax.Web.Services.SomaliPhone.Local(Model.Mobile)" class="form-control"
                                           inputmode="numeric" maxlength="9" placeholder="61xxxxxxx"
                                           oninput="this.value=this.value.replace(/\D/g,'').slice(0,9)" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-semibold mb-1">@L["Car Type"]</label>
                                <select name="CarTypeId" class="form-select">
                                    <option value="">@L["Select Car Type"]</option>
                                    @foreach (var c in Model.CarTypes)
                                    {
                                        <option value="@c.Id" selected="@(c.Id == Model.CarTypeId ? "selected" : null)">@c.Name</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="text-end mt-3">
                            <button asp-page-handler="RegisterVehicle" type="submit" formnovalidate class="btn btn-warning fw-semibold">
                                <i class="bi bi-plus-circle me-1"></i>@L["Register Vehicle"]
                            </button>
                        </div>
                    </div>
                }

                @if (Model.Vehicle != null)
                {
                    var v = Model.Vehicle;
                    @if (!v.IsActive)
                    {
                        <div class="alert alert-danger d-flex align-items-center gap-2 mb-3">
                            <i class="bi bi-slash-circle-fill"></i>@L["This vehicle is inactive and cannot be charged. Ask an admin to set it Active."]
                        </div>
                    }
                    <!-- Vehicle -->
                    <div class="border rounded-4 p-3 mb-3 d-flex flex-wrap gap-3 align-items-center" style="background:#f8fafc">
                        <div class="px-3 py-2 rounded-3 fw-bold fs-4" style="background:#0b57d0;color:#fff;letter-spacing:.05em">@v.PlateNumber</div>
                        <div class="row g-2 flex-grow-1 small">
                            <div class="col-6 col-md-4">
                                <div class="text-muted">@L["Owner"]</div>
                                <div class="fw-semibold fs-6">@v.OwnerName</div>
                            </div>
                            <div class="col-6 col-md-4">
                                <div class="text-muted">@L["Mobile"]</div>
                                <div class="fw-semibold fs-6">
                                    @if (string.IsNullOrWhiteSpace(v.Mobile))
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                    else
                                    {
                                        <a href="tel:@v.Mobile" class="text-decoration-none"><i class="bi bi-telephone me-1"></i>@v.Mobile</a>
                                    }
                                </div>
                            </div>
                            <div class="col-6 col-md-4">
                                <div class="text-muted">@L["Car Type"]</div>
                                <div class="fw-semibold fs-6"><span class="badge bg-info text-dark">@(v.CarType?.Name ?? "—")</span></div>
                            </div>
                        </div>
                    </div>

                    @if (Model.PaidToday != null)
                    {
                        <div class="alert alert-warning d-flex align-items-start gap-2">
                            <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                            <div>
                                <strong>@L["Already paid today"]</strong><br />
                                @L["This vehicle already has a paid payment today at"]
                                <strong>@VehicleTax.Web.AppTime.ToLocal(Model.PaidToday.PaidAt).ToString("HH:mm")</strong>
                                (@L["Invoice No"] @Model.PaidToday.InvoiceNumber, $@Model.PaidToday.Amount.ToString("N2")).
                            </div>
                        </div>
                    }

                    @if (!Model.Tariffs.Any())
                    {
                        <div class="alert alert-secondary">@L["No tariff has an amount for this car type yet. Add one in Data & Setup → Tax Amounts."]</div>
                    }
                    else
                    {
                        <div class="row g-3">
                            <div class="col-md-8">
                                <label class="form-label fw-semibold">@L["Tariff"]</label>
                                <select name="MovementId" id="tariffSelect" class="form-select form-select-lg" required>
                                    <option value="">@L["Select Tariff"]</option>
                                    @foreach (var t in Model.Tariffs)
                                    {
                                        <option value="@t.Id" data-amount="@t.Amount.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                                selected="@(t.Id == Model.MovementId ? "selected" : null)">@t.Name — $@t.Amount.ToString("N2")</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-semibold">@L["Quantity"]</label>
                                <input asp-for="Quantity" id="qtyInput" type="number" min="1" class="form-control form-control-lg" />
                            </div>
                        </div>

                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mt-4 p-3 rounded-4" style="background:#eef4ff">
                            <div>
                                <div class="small text-muted">@L["Total"]</div>
                                <div class="fw-bold" style="font-size:2rem;color:#0b57d0" id="totalBox">$0.00</div>
                                <div class="small text-muted" id="unitBox"></div>
                            </div>
                            <button asp-page-handler="GenerateInvoice" type="submit" id="generateBtn" disabled
                                    class="btn btn-success btn-lg px-4"
                                    onclick="@(Model.PaidToday != null
                                        ? "return confirm('" + System.Web.HttpUtility.JavaScriptStringEncode(L["This vehicle was already paid today. Generate another invoice anyway?"]) + "');"
                                        : null)">
                                <i class="bi bi-receipt me-1"></i>@L["Generate Invoice"]
                            </button>
                        </div>
                        <script>
                            (function () {
                                var sel = document.getElementById('tariffSelect'), qty = document.getElementById('qtyInput');
                                function money(n) { return '$' + n.toFixed(2); }
                                function update() {
                                    var o = sel.options[sel.selectedIndex], unit = parseFloat(o && o.dataset.amount) || 0;
                                    var q = Math.max(1, parseInt(qty.value, 10) || 1);
                                    document.getElementById('totalBox').textContent = money(unit * q);
                                    document.getElementById('unitBox').textContent = unit ? money(unit) + ' × ' + q : '';
                                    document.getElementById('generateBtn').disabled = !unit;
                                }
                                sel.addEventListener('change', update); qty.addEventListener('input', update); update();
                            })();
                        </script>
                    }
                }

            </form>
        </div>
    </div>
    </div>

    <!-- Plate / QR checker (same as the mobile app) -->
    <div class="col-lg-4">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white fw-bold">
                <i class="bi bi-patch-check text-primary me-1"></i>@L["Verify Plate"]
            </div>
            <div class="card-body">
                <partial name="_PlateChecker" />
            </div>
        </div>
    </div>
    </div>

    @if (Model.Payments.Any())
    {
        <div class="card shadow-sm border-0 mt-5">
            <div class="card-body">

                <h4 class="mb-3">
                    <i class="bi bi-clock-history"></i>
                    @L["Payment History"]
                </h4>

                <div class="table-responsive">
                    <table class="table table-bordered table-striped">
                        <thead class="table-dark">
                            <tr>
                                <th>@L["System ID"]</th>
                                <th>@L["Date"]</th>
                                <th>@L["Tariff"]</th>
                                <th>@L["Amount"]</th>
                                <th>@L["Invoice ID"]</th>
                                <th>@L["Golis Bill No"]</th>
                                <th>@L["Code"]</th>
                                <th>@L["Status"]</th>
                                <th>@L["Action"]</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var p in Model.Payments)
                        {
                            <tr class="@(p.IsReverted ? "table-danger" : "")">
                                <td>@p.Id</td>
                                <td>@VehicleTax.Web.AppTime.ToLocal(p.PaidAt).ToString("dd MMM yyyy HH:mm")</td>
                                <td>@p.MovementType</td>
                                <td>$@p.Amount.ToString("N0")</td>
                                <td>
                                    <a asp-page="/Payments/Receipt" asp-route-paymentId="@p.Id">
                                        @p.InvoiceNumber
                                    </a>
                                </td>
                                <td>@(string.IsNullOrWhiteSpace(p.TransactionId) ? "-" : p.TransactionId)</td>
                                <td>@p.ShortCode</td>
                                <td>
                                    @if (p.IsReverted)
                                    {
                                        <span class="badge bg-danger">@L["Cancelled"]</span>
                                    }
                                    else if (p.IsPaid)
                                    {
                                        <span class="badge bg-success">@L["Paid"]</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">@L["Invoice Pending"]</span>
                                    }
                                </td>
                                <td>
                                @if (p.IsReverted)
                                {
                                    <span class="text-muted small">@L["No actions"]</span>
                                }
                                 else if (!p.IsPaid)
                                 {
                                     if (User.IsInRole("Admin"))
                                     {
                                         <form method="post" asp-page-handler="CollectInvoice" class="mb-2">
                                             <input type="hidden" name="paymentId" value="@p.Id" />
                                             <select name="checkpointId" class="form-select form-select-sm mb-2">
                                                 <option value="">— Default —</option>
                                                 @if (Model.Checkpoints != null)
                                                 {
                                                     @foreach (var c in Model.Checkpoints)
                                                     {
                                                         <option value="@c.Value">@c.Text</option>
                                                     }
                                                 }
                                             </select>
                                             <button type="submit" class="btn btn-sm btn-success w-100">
                                                 <i class="bi bi-cash"></i> @L["Collect"]
                                             </button>
                                         </form>
                                     }
                                    else
                                    {
                                        <span class="badge bg-secondary d-block mb-2">@L["Admin only"]</span>
                                    }

                                    <a class="btn btn-sm btn-outline-primary w-100"
                                       asp-page="/Payments/Receipt"
                                       asp-route-paymentId="@p.Id">
                                        <i class="bi bi-printer"></i> @L["Print Invoice"]
                                    </a>
                                }
                                else if (User.IsInRole("Admin"))
                                {
                                    <form method="post" asp-page-handler="Revert" class="mb-2">
                                        <input type="hidden" name="paymentId" value="@p.Id" />
                                        <input type="text"
                                               name="reason"
                                               class="form-control mb-2"
                                               placeholder="@L["Reason for cancellation"]"
                                               required />
                                        <button type="submit" class="btn btn-sm btn-warning w-100">
                                            <i class="bi bi-x-circle"></i> @L["Cancel"]
                                        </button>
                                    </form>

                                    <a class="btn btn-sm btn-outline-primary w-100"
                                       asp-page="/Payments/Receipt"
                                       asp-route-paymentId="@p.Id">
                                        <i class="bi bi-printer"></i> @L["Print Receipt"]
                                    </a>
                                }
                                else
                                {
                                    <a class="btn btn-sm btn-outline-primary w-100"
                                       asp-page="/Payments/Receipt"
                                       asp-route-paymentId="@p.Id">
                                        <i class="bi bi-printer"></i> @L["Print Receipt"]
                                    </a>
                                }
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>

            </div>
        </div>
    }

</div>
