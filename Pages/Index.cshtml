@page
@model VehicleTax.Web.Pages.IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<style>
    .dash-hero {
        background: linear-gradient(120deg, #102a72 0%, #1f4ed3 58%, #3f74ff 100%);
        border-radius: 1rem;
        padding: 1rem 1.2rem;
        color: #fff;
        box-shadow: 0 14px 30px rgba(16, 42, 114, .24);
    }

    .kpi-card {
        border: 0;
        border-radius: 1rem;
        box-shadow: 0 8px 20px rgba(15, 23, 42, .08);
        overflow: hidden;
    }

    .kpi-head {
        font-size: .82rem;
        letter-spacing: .2px;
        color: #6b7280;
    }

    .kpi-value {
        font-size: 1.7rem;
        font-weight: 800;
        line-height: 1.1;
        margin-bottom: 0;
    }

    .kpi-icon {
        width: 42px;
        height: 42px;
        border-radius: .75rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.15rem;
    }

    .panel-card {
        border: 0;
        border-radius: 1rem;
        box-shadow: 0 10px 24px rgba(15, 23, 42, .08);
    }

    .panel-title {
        font-weight: 700;
        margin-bottom: .25rem;
    }

    .metric-chip {
        background: rgba(255, 255, 255, .16);
        border: 1px solid rgba(255, 255, 255, .2);
        padding: .35rem .55rem;
        border-radius: .55rem;
        font-size: .82rem;
    }
</style>

<div class="dash-hero mb-4">
    <div class="d-flex flex-column flex-lg-row justify-content-between gap-3 align-items-lg-center">
        <div>
            <h2 class="fw-bold mb-1">Dashboard Overview</h2>
            <div class="opacity-75">Infographic summary of vehicle tax performance</div>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <span class="metric-chip"><i class="bi bi-calendar3"></i> @VehicleTax.Web.AppTime.Now.ToString("dd MMM yyyy")</span>
            <span class="metric-chip"><i class="bi bi-clock-history"></i> Live Snapshot</span>
        </div>
    </div>
</div>

<!-- KPI CARDS -->
<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="card kpi-card h-100">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="kpi-head">Total Vehicles</div>
                    <p class="kpi-value">@Model.TotalVehicles</p>
                </div>
                <span class="kpi-icon" style="background:#e9f0ff;color:#1f4ed3;"><i class="bi bi-truck"></i></span>
            </div>
        </div>
    </div>

    <div class="col-6 col-lg-3">
        <div class="card kpi-card h-100">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="kpi-head">Completed Payments</div>
                    <p class="kpi-value">@Model.TotalPayments</p>
                </div>
                <span class="kpi-icon" style="background:#e7f8ef;color:#147d4f;"><i class="bi bi-check2-circle"></i></span>
            </div>
        </div>
    </div>

    <div class="col-6 col-lg-3">
        <div class="card kpi-card h-100">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="kpi-head">Today Collection</div>
                    <p class="kpi-value">$@Model.TodayTotal.ToString("N0")</p>
                </div>
                <span class="kpi-icon" style="background:#fff5df;color:#b77700;"><i class="bi bi-cash-stack"></i></span>
            </div>
        </div>
    </div>

    <div class="col-6 col-lg-3">
        <div class="card kpi-card h-100">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="kpi-head">Average Payment</div>
                    <p class="kpi-value">$@Model.AveragePayment.ToString("N0")</p>
                </div>
                <span class="kpi-icon" style="background:#f2ecff;color:#6b3bd2;"><i class="bi bi-activity"></i></span>
            </div>
        </div>
    </div>

    <div class="col-6 col-lg-3">
        <div class="card kpi-card h-100">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="kpi-head">Active Collectors</div>
                    <p class="kpi-value">@Model.ActiveCollectors</p>
                </div>
                <span class="kpi-icon" style="background:#eaf7ff;color:#0077b8;"><i class="bi bi-people"></i></span>
            </div>
        </div>
    </div>

    <div class="col-6 col-lg-3">
        <div class="card kpi-card h-100">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="kpi-head">Reverted Records</div>
                    <p class="kpi-value">@Model.RevertedPayments</p>
                </div>
                <span class="kpi-icon" style="background:#ffe9ea;color:#bf1d2d;"><i class="bi bi-arrow-counterclockwise"></i></span>
            </div>
        </div>
    </div>
</div>

<!-- CHARTS -->
<div class="row g-4 mb-4">

    <!-- DAILY -->
    <div class="col-lg-6">
        <div class="card panel-card h-100">
            <div class="card-body">
                <h6 class="panel-title">Daily Collection (7 Days)</h6>
                <p class="text-muted small mb-2">Track day-by-day revenue trend from completed payments.</p>
                <canvas id="dailyChart"></canvas>
            </div>
        </div>
    </div>

    <!-- MOVEMENT -->
    <div class="col-lg-3">
        <div class="card panel-card h-100">
            <div class="card-body">
                <h6 class="panel-title">Movement Mix</h6>
                <canvas id="movementChart"></canvas>

                <table class="table table-sm table-bordered mt-3" id="movementTable">
                    <thead class="table-light">
                        <tr>
                            <th>Movement</th>
                            <th class="text-end">Count</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var m in Model.MovementTable)
                        {
                            <tr>
                                <td>@m.Movement</td>
                                <td class="text-end fw-bold">@m.Count</td>
                            </tr>
                        }
                    </tbody>
                </table>

                <!-- Movement Pagination -->
                <nav>
                    <ul class="pagination pagination-sm justify-content-center" id="movementPagination"></ul>
                </nav>
            </div>
        </div>
    </div>

    <!-- COLLECTOR -->
    <div class="col-lg-3">
        <div class="card panel-card h-100">
            <div class="card-body">
                <h6 class="panel-title">Collector Performance</h6>
                <p class="text-muted small mb-2">Amount collected by each collector.</p>
                <canvas id="collectorChart"></canvas>
            </div>
        </div>
    </div>

    <!-- CHECKPOINT -->
    <div class="col-lg-6">
        <div class="card panel-card h-100">
            <div class="card-body">
                <h6 class="panel-title mb-0">Checkpoint Performance</h6>
                <p class="text-muted small mb-2">Collections by checkpoint (snapshot).</p>
                <div class="d-flex flex-wrap gap-2 mb-2">
                    <input type="date" id="checkpointFromDate" class="form-control form-control-sm w-auto" />
                    <input type="date" id="checkpointToDate" class="form-control form-control-sm w-auto" />
                    <button type="button" id="checkpointApplyBtn" class="btn btn-sm btn-primary">Apply</button>
                    <button type="button" id="checkpointResetBtn" class="btn btn-sm btn-outline-secondary">Reset</button>
                </div>
                <canvas id="checkpointChart"></canvas>
                <div id="checkpointChartHint" class="text-muted small mt-2">Loading checkpoint data...</div>
            </div>
        </div>
    </div>

    <!-- REVENUE ACCOUNT -->
    <div class="col-lg-6">
        <div class="card panel-card h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h6 class="panel-title mb-0">Collections by Revenue Account</h6>
                    <span class="text-muted small fw-bold">$@Model.RevenueAccountGrandTotal.ToString("N0") total</span>
                </div>
                <p class="text-muted small mb-2">Top revenue accounts by collected amount.</p>
                <div class="d-flex flex-wrap gap-2 mb-2">
                    <input type="date" id="revAccountFromDate" class="form-control form-control-sm w-auto" />
                    <input type="date" id="revAccountToDate" class="form-control form-control-sm w-auto" />
                    <button type="button" id="revAccountApplyBtn" class="btn btn-sm btn-primary">Apply</button>
                    <button type="button" id="revAccountResetBtn" class="btn btn-sm btn-outline-secondary">Reset</button>
                </div>
                <canvas id="revenueAccountChart"></canvas>
                <div id="revenueAccountChartHint" class="text-muted small mt-2">Loading revenue account data...</div>
                <table class="table table-sm table-bordered table-striped mt-3" id="revenueAccountTable">
                    <thead class="table-light">
                        <tr>
                            <th>Revenue Account</th>
                            <th class="text-end">Amount</th>
                        </tr>
                    </thead>
                    <tbody id="revenueAccountTableBody"></tbody>
                </table>
                <!-- Revenue Account Pagination -->
                <nav>
                    <ul class="pagination pagination-sm justify-content-center" id="revenueAccountPagination"></ul>
                </nav>
            </div>
        </div>
    </div>
</div>

<!-- RECENT PAYMENTS -->
<div class="card panel-card">
    <div class="card-body">

        <div class="d-flex justify-content-between align-items-center mb-2">
            <h6 class="fw-bold mb-0">Recent Payments</h6>

            <!-- Search -->
            <input type="text"
                   id="paymentSearch"
                   class="form-control form-control-sm w-auto"
                   style="min-width:220px;"
                   placeholder="Search all fields..." />
        </div>

        <div class="table-responsive">
            <table class="table table-striped table-bordered table-sm align-middle" id="paymentsTable">
                <thead class="table-light">
                    <tr>
                        <th>Date</th>
                        <th>Plate</th>
                        <th>Mobile</th>
                        <th>Movement</th>
                        <th>Collector</th>
                        <th>Checkpoint</th>
                        <th class="text-end">Amount</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var p in Model.RecentPayments)
                {
                    <tr>
                        <td>@p.PaidAt.ToString("yyyy-MM-dd")</td>
                        <td>@p.Vehicle?.PlateNumber</td>
                        <td>@p.Vehicle?.Mobile</td>
                        <td>@p.MovementType</td>
                        <td>@(p.Collector?.Username ?? p.ReceiptReference?.UsedBy ?? "Unassigned")</td>
                        <td>@(p.Checkpoint?.Name ?? "Unassigned")</td>
                        <td class="text-end fw-bold">$@p.Amount.ToString("N0")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        <!-- Payments Pagination -->
        <nav>
            <ul class="pagination pagination-sm justify-content-center" id="paymentsPagination"></ul>
        </nav>

    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
/* =========================
   CHARTS
========================= */
const dailyChart = new Chart(document.getElementById('dailyChart'), {
    type: 'line',
    data: {
        labels: @Html.Raw(Model.DailyLabels),
        datasets: [{
            label: 'Daily Collection',
            data: @Html.Raw(Model.DailyAmounts),
            borderColor: '#1f4ed3',
            backgroundColor: 'rgba(31,78,211,.18)',
            fill: true,
            tension: .35,
            pointBackgroundColor: '#1f4ed3',
            pointRadius: 3
        }]
    },
    options: {
        plugins: {
            legend: { display: false }
        }
    }
});

const movementChart = new Chart(document.getElementById('movementChart'), {
    type: 'doughnut',
    data: {
        labels: @Html.Raw(Model.MovementLabels),
        datasets: [{
            data: @Html.Raw(Model.MovementCounts),
            backgroundColor: ['#0d6efd','#198754','#ffc107','#dc3545','#6610f2','#20c997']
        }]
    }
});

const collectorChart = new Chart(document.getElementById('collectorChart'), {
    type: 'bar',
    data: {
        labels: @Html.Raw(Model.CollectorLabels),
        datasets: [{
            label: 'Collected Amount',
            data: @Html.Raw(Model.CollectorAmounts),
            backgroundColor: '#147d4f'
        }]
    },
    options: {
        indexAxis: 'y',
        plugins: {
            legend: { display: false }
        },
        scales: { x: { beginAtZero: true } }
    }
});

let revenueAccountChart = null;

function formatDateInputValue(dateObj) {
    const year = dateObj.getFullYear();
    const month = String(dateObj.getMonth() + 1).padStart(2, '0');
    const day = String(dateObj.getDate()).padStart(2, '0');
    return `${year}-${month}-${day}`;
}

function setDefaultRevAccountDateRange() {
    const fromInput = document.getElementById('revAccountFromDate');
    const toInput = document.getElementById('revAccountToDate');

    if (!fromInput || !toInput) {
        return;
    }

    const today = new Date();
    const weekStart = new Date(today);
    weekStart.setDate(today.getDate() - 6);

    fromInput.value = formatDateInputValue(weekStart);
    toInput.value = formatDateInputValue(today);
}

async function loadRevenueAccountChart() {
    const hint = document.getElementById('revenueAccountChartHint');
    const chartCanvas = document.getElementById('revenueAccountChart');
    const tableBody = document.getElementById('revenueAccountTableBody');
    const fromInput = document.getElementById('revAccountFromDate');
    const toInput = document.getElementById('revAccountToDate');

    if (!hint || !chartCanvas || !fromInput || !toInput) {
        return;
    }

    try {
        const query = new URLSearchParams();
        query.set('limit', '5');

        if (fromInput.value) {
            query.set('fromDate', fromInput.value);
        }

        if (toInput.value) {
            query.set('toDate', toInput.value);
        }

        const response = await fetch(`/api/dashboard/revenue-account-summary?${query.toString()}`, {
            headers: {
                'Accept': 'application/json'
            }
        });

        if (!response.ok) {
            throw new Error('Failed to load revenue account data.');
        }

        const payload = await response.json();
        const items = Array.isArray(payload.items) ? payload.items : [];
        const grandTotal = payload.grandTotal || 0;

        hint.innerText = `Total: $${Number(grandTotal).toLocaleString()} for ${items.length} account(s).`;
        hint.classList.remove('text-muted');
        hint.classList.add('text-success', 'fw-bold');

        if (items.length === 0) {
            hint.innerText = 'No revenue account data available for selected filters.';
            return;
        }

        const labels = items.map(x => x.revenueAccount);
        const amounts = items.map(x => x.totalAmount);

        if (revenueAccountChart) {
            revenueAccountChart.destroy();
        }

        revenueAccountChart = new Chart(chartCanvas, {
            type: 'bar',
            data: {
                labels,
                datasets: [{
                    label: 'Collected Amount',
                    data: amounts,
                    backgroundColor: '#8b5cf6'
                }]
            },
            options: {
                indexAxis: 'y',
                plugins: {
                    legend: { display: false }
                },
                scales: {
                    x: { beginAtZero: true }
                }
            }
        });

        // Populate the datagrid table below the chart
        tableBody.innerHTML = '';
        items.forEach(item => {
            const tr = document.createElement('tr');
            tr.innerHTML = `
                <td>${item.revenueAccount}</td>
                <td class="text-end fw-bold">$${Number(item.totalAmount).toLocaleString()}</td>
            `;
            tableBody.appendChild(tr);
        });

        setupPagination('revenueAccountTable', 'revenueAccountPagination', 5);
    } catch (error) {
        hint.innerText = 'Unable to load revenue account data right now.';
    }
}

let checkpointChart = null;

async function loadCheckpointChart() {
    const hint = document.getElementById('checkpointChartHint');
    const chartCanvas = document.getElementById('checkpointChart');
    const fromInput = document.getElementById('checkpointFromDate');
    const toInput = document.getElementById('checkpointToDate');

    if (!hint || !chartCanvas || !fromInput || !toInput) {
        return;
    }

    try {
        const query = new URLSearchParams();
        query.set('limit', '5');

        if (fromInput.value) {
            query.set('fromDate', fromInput.value);
        }

        if (toInput.value) {
            query.set('toDate', toInput.value);
        }

        const response = await fetch(`/api/dashboard/top-checkpoints?${query.toString()}`, {
            headers: {
                'Accept': 'application/json'
            }
        });

        if (!response.ok) {
            throw new Error('Failed to load checkpoint chart data.');
        }

        const payload = await response.json();
        const items = Array.isArray(payload.items) ? payload.items : [];

        if (items.length === 0) {
            hint.innerText = 'No checkpoint data available.';
            return;
        }

        const labels = items.map(x => x.checkpoint);
        const amounts = items.map(x => x.totalAmount);

        if (checkpointChart) {
            checkpointChart.destroy();
        }

        checkpointChart = new Chart(chartCanvas, {
            type: 'bar',
            data: {
                labels,
                datasets: [{
                    label: 'Collected Amount',
                    data: amounts,
                    backgroundColor: '#0f766e'
                }]
            },
            options: {
                indexAxis: 'y',
                plugins: {
                    legend: { display: false }
                },
                scales: {
                    x: { beginAtZero: true }
                }
            }
        });

        hint.innerText = 'Top checkpoints for selected date range.';
        hint.classList.remove('text-muted');
        hint.classList.add('text-success');
    } catch (error) {
        hint.innerText = 'Unable to load checkpoint performance right now.';
    }
}

function setDefaultCheckpointDateRange() {
    const fromInput = document.getElementById('checkpointFromDate');
    const toInput = document.getElementById('checkpointToDate');

    if (!fromInput || !toInput) {
        return;
    }

    const today = new Date();
    const weekStart = new Date(today);
    weekStart.setDate(today.getDate() - 6);

    fromInput.value = formatDateInputValue(weekStart);
    toInput.value = formatDateInputValue(today);
}

/* =========================
   RECENT PAYMENTS SEARCH
========================= */
document.getElementById("paymentSearch").addEventListener("keyup", function () {
    const value = this.value.toLowerCase();
    document.querySelectorAll("#paymentsTable tbody tr").forEach(row => {
        row.style.display = row.innerText.toLowerCase().includes(value) ? "" : "none";
    });
});

/* =========================
   PAGINATION FUNCTION
========================= */
function setupPagination(tableId, paginationId, rowsPerPage) {
    const table = document.getElementById(tableId);
    const pagination = document.getElementById(paginationId);
    const rows = Array.from(table.querySelectorAll("tbody tr"));

    let currentPage = 1;
    const totalPages = Math.ceil(rows.length / rowsPerPage);

    function render() {
        rows.forEach((row, index) => {
            row.style.display =
                index >= (currentPage - 1) * rowsPerPage &&
                index < currentPage * rowsPerPage ? "" : "none";
        });

        pagination.innerHTML = "";
        for (let i = 1; i <= totalPages; i++) {
            const li = document.createElement("li");
            li.className = "page-item " + (i === currentPage ? "active" : "");
            const a = document.createElement("a");
            a.className = "page-link";
            a.href = "#";
            a.innerText = i;
            a.onclick = e => {
                e.preventDefault();
                currentPage = i;
                render();
            };
            li.appendChild(a);
            pagination.appendChild(li);
        }
    }

    render();
}

/* =========================
   INIT PAGINATION
========================= */
// Payments table -> 10 rows
setupPagination("paymentsTable", "paymentsPagination", 10);

// Movement table -> 4 rows
setupPagination("movementTable", "movementPagination", 4);

setDefaultCheckpointDateRange();

document.getElementById('checkpointApplyBtn')?.addEventListener('click', loadCheckpointChart);
document.getElementById('checkpointResetBtn')?.addEventListener('click', () => {
    setDefaultCheckpointDateRange();
    loadCheckpointChart();
});

loadCheckpointChart();

// Revenue Account chart
setDefaultRevAccountDateRange();
document.getElementById('revAccountApplyBtn')?.addEventListener('click', loadRevenueAccountChart);
document.getElementById('revAccountResetBtn')?.addEventListener('click', () => {
    setDefaultRevAccountDateRange();
    loadRevenueAccountChart();
});
loadRevenueAccountChart();
</script>
