@page
@model VehicleTax.Web.Pages.RevenueAccounts.IndexModel
@{
    ViewData["Title"] = "Revenue Accounts";
}

<div class="module-page">

    <!-- SUCCESS ALERT -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="module-header mb-3">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <h3 class="fw-bold mb-1">Revenue Accounts</h3>
                <div class="sub">Manage revenue accounts that movements are linked to.</div>
            </div>
            <a asp-page="Create" class="btn btn-light module-action-btn">
                <i class="bi bi-plus-circle"></i> Add Revenue Account
            </a>
        </div>
    </div>

    <!-- SEARCH + FILTER -->
    <form method="get" class="card module-filter-card p-3 mb-3">
        <div class="row g-2">
            <div class="col-md-3">
                <input asp-for="SearchCode"
                       class="form-control"
                       placeholder="Search by Account Code..." />
            </div>
            <div class="col-md-3">
                <input asp-for="SearchName"
                       class="form-control"
                       placeholder="Search by Account Name..." />
            </div>
            <div class="col-md-3">
                <select asp-for="Status" class="form-select">
                    <option value="">All Status</option>
                    <option value="active">Active</option>
                    <option value="inactive">Inactive</option>
                </select>
            </div>
            <div class="col-md-3 d-flex align-items-end gap-2">
                <button class="btn btn-primary w-100 module-action-btn">
                    Apply
                </button>
                <a asp-page="./Index" class="btn btn-outline-secondary w-100 module-action-btn">Reset</a>
            </div>
        </div>
    </form>

    <!-- TABLE -->
    <div class="card module-table-card border-0">
        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Account Code</th>
                        <th>Account Name</th>
                        <th>Description</th>
                        <th>Status</th>
                        <th class="text-center" style="width:180px">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Accounts.Any())
                    {
                        int i = (Model.PageNumber - 1) * Model.PageSize + 1;
                        foreach (var item in Model.Accounts)
                        {
                            <tr>
                                <td class="fw-semibold">@item.AccountCode</td>
                                <td class="fw-semibold">@item.AccountName</td>
                                <td>@(item.Description ?? "")</td>
                                <td class="text-center">
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactive</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <a asp-page="Edit"
                                       asp-route-id="@item.Id"
                                       class="btn btn-sm btn-outline-warning me-1 module-action-btn">
                                        Edit
                                    </a>
                                    <a asp-page="Delete"
                                       asp-route-id="@item.Id"
                                       class="btn btn-sm btn-outline-danger module-action-btn">
                                        Delete
                                    </a>
                                </td>
                            </tr>
                            i++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted">
                                No revenue accounts found
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- PAGINATION -->
    @if (Model.TotalPages > 1)
    {
        <nav class="mt-3">
            <ul class="pagination justify-content-center">
                @for (int p = 1; p <= Model.TotalPages; p++)
                {
                    <li class="page-item @(p == Model.PageNumber ? "active" : "")">
                        <a class="page-link"
                           href="?searchCode=@Model.SearchCode&searchName=@Model.SearchName&status=@Model.Status&pageNumber=@p">
                            @p
                        </a>
                    </li>
                }
            </ul>
        </nav>
    }

</div>
