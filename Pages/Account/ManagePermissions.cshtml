@page
@model VehicleTax.Web.Pages.Account.ManagePermissionsModel
@{
    ViewData["Title"] = L["Manage Permissions"];
    var isUser = !Model.ByRole;
    var u = Model.ActiveUser;
}

<style>
    .pm-hero { background: linear-gradient(135deg, #0b57d0, #1e3a8a); color: #fff; border-radius: 18px; padding: 22px 24px; }
    .pm-hero .text-white-50 { color: rgba(255,255,255,.75) !important; }
    .pm-scope { display: inline-flex; background: rgba(255,255,255,.15); border-radius: 12px; padding: 4px; gap: 4px; }
    .pm-scope a { color: #fff; text-decoration: none; padding: 7px 16px; border-radius: 9px; font-weight: 700; font-size: 14px; }
    .pm-scope a.active { background: #fff; color: #0b57d0; }
    .pm-pills { display: flex; flex-wrap: wrap; gap: 8px; }
    .pm-pill { border: 1px solid #e2e8f0; background: #fff; border-radius: 999px; padding: 6px 14px; font-weight: 600; font-size: 14px;
               color: #334155; text-decoration: none; }
    .pm-pill.active { background: #0b57d0; border-color: #0b57d0; color: #fff; }
    .pm-module { border: 1px solid #e2e8f0; border-radius: 16px; background: #fff; overflow: hidden; }
    .pm-module-head { display: flex; align-items: center; gap: 10px; padding: 14px 16px; border-bottom: 1px solid #f1f5f9; }
    .pm-module-head .pm-icon { width: 36px; height: 36px; border-radius: 10px; display: grid; place-items: center; background: #eef4ff; color: #0b57d0; }
    .pm-count { font-size: 12px; font-weight: 700; color: #64748b; background: #f1f5f9; border-radius: 999px; padding: 3px 10px; }
    .pm-row { display: flex; align-items: center; gap: 12px; padding: 11px 16px; border-bottom: 1px solid #f8fafc; }
    .pm-row:last-child { border-bottom: 0; }
    .pm-row.sub { padding-left: 34px; }
    .pm-row .pm-label { flex: 1; min-width: 0; }
    .pm-row .pm-key { font-family: ui-monospace, monospace; font-size: 11px; color: #94a3b8; }
    .pm-seg { display: inline-flex; border: 1px solid #e2e8f0; border-radius: 10px; overflow: hidden; flex-shrink: 0; }
    .pm-seg input { display: none; }
    .pm-seg label { padding: 5px 11px; font-size: 12px; font-weight: 700; color: #64748b; cursor: pointer; border-right: 1px solid #e2e8f0; margin: 0; }
    .pm-seg label:last-of-type { border-right: 0; }
    .pm-seg input:checked + label.inherit { background: #f1f5f9; color: #0f172a; }
    .pm-seg input:checked + label.allow { background: #16a34a; color: #fff; }
    .pm-seg input:checked + label.deny { background: #dc2626; color: #fff; }
    .pm-result { font-size: 12px; font-weight: 700; border-radius: 999px; padding: 3px 10px; white-space: nowrap; flex-shrink: 0; min-width: 104px; text-align: center; }
    .pm-result.yes { background: #dcfce7; color: #15803d; }
    .pm-result.no { background: #f1f5f9; color: #94a3b8; }
    .pm-role-has { font-size: 11px; color: #64748b; white-space: nowrap; }
    .pm-switch .form-check-input { width: 2.6em; height: 1.35em; cursor: pointer; }
    .pm-savebar { position: sticky; bottom: 0; z-index: 10; background: rgba(255,255,255,.96); backdrop-filter: blur(6px);
                  border: 1px solid #e2e8f0; border-radius: 16px; padding: 12px 16px; box-shadow: 0 -4px 20px rgba(15,23,42,.08); }
    @@media (max-width: 576px) {
        .pm-row { flex-wrap: wrap; }
        .pm-row .pm-label { flex-basis: 100%; }
    }
</style>

<div class="container py-4">
    <div class="pm-hero mb-3">
        <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
            <div>
                <h3 class="fw-bold mb-1"><i class="bi bi-shield-lock me-2"></i>@L["Manage Permissions"]</h3>
                <div class="text-white-50">@L["Give or take access by role, or override it for one user."]</div>
            </div>
            <div class="d-flex gap-2">
                <a class="btn btn-light btn-sm" asp-page="/Account/PermissionHistory"><i class="bi bi-clock-history me-1"></i>@L["Change History"]</a>
                <a class="btn btn-outline-light btn-sm" asp-page="/Account/Users"><i class="bi bi-people me-1"></i>@L["Users"]</a>
            </div>
        </div>
        <div class="pm-scope mt-3">
            <a class="@(isUser ? "" : "active")" asp-page="/Account/ManagePermissions" asp-route-role="@Model.ActiveRole"><i class="bi bi-diagram-3 me-1"></i>@L["By Role"]</a>
            <a class="@(isUser ? "active" : "")" asp-page="/Account/ManagePermissions" asp-route-userId="@(u?.Id ?? Model.Users.FirstOrDefault()?.Id ?? 0)"><i class="bi bi-person me-1"></i>@L["By User"]</a>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div class="alert alert-success d-flex align-items-center gap-2"><i class="bi bi-check-circle-fill"></i>@Model.Message</div>
    }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger d-flex align-items-center gap-2"><i class="bi bi-exclamation-triangle-fill"></i>@Model.ErrorMessage</div>
    }

    <!-- Who is being edited -->
    <div class="card border-0 shadow-sm mb-3" style="border-radius:16px;">
        <div class="card-body">
            @if (isUser)
            {
                <form method="get" class="row g-2 align-items-end">
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold text-muted mb-1">@L["User"]</label>
                        <select class="form-select" name="userId" onchange="this.form.submit()">
                            @foreach (var x in Model.Users)
                            {
                                <option value="@x.Id" selected="@(x.Id == u?.Id ? "selected" : null)">
                                    @x.Username@(string.IsNullOrWhiteSpace(x.FullName) ? "" : " · " + x.FullName) (@L[x.Role])
                                </option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6 small text-muted">
                        <i class="bi bi-info-circle me-1"></i>
                        @L["Inherit uses the role's setting. Allow or Deny overrides it for this user only."]
                        <a asp-page="/Account/ManagePermissions" asp-route-role="@u?.Role">@L["Edit the role"] (@L[u?.Role ?? ""])</a>
                    </div>
                </form>
            }
            else
            {
                <div class="small fw-semibold text-muted mb-2">@L["Role"]</div>
                <div class="pm-pills">
                    @foreach (var r in Model.Roles)
                    {
                        <a class="pm-pill @(r == Model.ActiveRole ? "active" : "")" asp-page="/Account/ManagePermissions" asp-route-role="@r">@L[r]</a>
                    }
                </div>
            }
        </div>
    </div>

    <form method="post" id="permForm" asp-page-handler="@(isUser ? "UserSave" : "RoleSave")"
          asp-route-role="@Model.ActiveRole" asp-route-userId="@(u?.Id ?? 0)">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
            <h5 class="fw-bold mb-0">
                @if (isUser)
                {
                    <span><i class="bi bi-person-circle me-1 text-primary"></i>@(string.IsNullOrWhiteSpace(u!.FullName) ? u.Username : u.FullName)</span>
                    <span class="badge bg-primary-subtle text-primary ms-1">@L[u.Role]</span>
                }
                else
                {
                    <span><i class="bi bi-diagram-3 me-1 text-primary"></i>@L["Role"]: @L[Model.ActiveRole]</span>
                }
            </h5>
            <div class="d-flex gap-2 align-items-center">
                <input id="pmSearch" class="form-control form-control-sm" style="width:220px" placeholder="@L["Search permissions…"]" />
                <span class="pm-count" id="pmTotal"></span>
            </div>
        </div>

        @if (Model.ActiveIsAdmin)
        {
            <div class="alert alert-info py-2 small"><i class="bi bi-lock-fill me-1"></i>@L["Admins always keep dashboard, user and permission management, so access can never be lost."]</div>
        }

        <div class="row g-3 mb-3">
            @foreach (var m in Model.Modules)
            {
                <div class="col-lg-6">
                    <div class="pm-module h-100" data-module>
                        <div class="pm-module-head">
                            <span class="pm-icon"><i class="bi @m.Icon"></i></span>
                            <span class="fw-bold flex-grow-1">@L[m.Name]</span>
                            <span class="pm-count" data-module-count></span>
                        </div>
                        @foreach (var p in m.Permissions)
                        {
                            <div class="pm-row @(p.RequiresKey != null ? "sub" : "")" data-row data-key="@p.Key"
                                 data-requires="@p.RequiresKey" data-role-has="@(p.RoleHas ? "1" : "0")" data-locked="@(p.Locked ? "1" : "0")"
                                 data-search="@(L[p.Label] + " " + p.Key + " " + L[m.Name]).ToLowerInvariant()">
                                <div class="pm-label">
                                    <div class="fw-semibold">
                                        @if (p.RequiresKey != null) { <i class="bi bi-arrow-return-right text-muted me-1"></i> }
                                        @L[p.Label]
                                        @if (p.Critical) { <i class="bi bi-exclamation-octagon text-danger ms-1" title="@L["Sensitive permission"]"></i> }
                                        @if (p.Locked) { <i class="bi bi-lock-fill text-primary ms-1" title="@L["Always granted for Admins"]"></i> }
                                    </div>
                                    <div class="pm-key">@p.Key</div>
                                </div>
                                @if (isUser)
                                {
                                    <span class="pm-role-has d-none d-md-inline">@L["Role"]: @(p.RoleHas ? "✓" : "—")</span>
                                    <div class="pm-seg" role="radiogroup">
                                        @foreach (var (val, label) in new[] { ("inherit", L["Inherit"]), ("allow", L["Allow"]), ("deny", L["Deny"]) })
                                        {
                                            var id = $"o_{p.Key.Replace('.', '_')}_{val}";
                                            <input type="radio" id="@id" name="choice_@p.Key" value="@val" checked="@(p.Override == val)"
                                                   data-original="@(p.Override == val ? "1" : "0")" disabled="@p.Locked" />
                                            <label for="@id" class="@val">@label</label>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="form-check form-switch pm-switch m-0">
                                        <input class="form-check-input" type="checkbox" role="switch" name="selected" value="@p.Key"
                                               checked="@(p.RoleHas || p.Locked)" disabled="@p.Locked"
                                               data-original="@((p.RoleHas || p.Locked) ? "1" : "0")" />
                                    </div>
                                }
                                <span class="pm-result" data-result></span>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        <div class="pm-savebar d-flex flex-wrap justify-content-between align-items-center gap-2">
            <span id="pmDirty" class="text-muted small">@L["No changes"]</span>
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-outline-secondary" onclick="window.location.reload()"><i class="bi bi-arrow-counterclockwise me-1"></i>@L["Reset"]</button>
                <button type="submit" class="btn btn-primary px-4" id="pmSave" disabled><i class="bi bi-check2-circle me-1"></i>@L["Save Changes"]</button>
            </div>
        </div>
    </form>
</div>

<script>
(function () {
    var isUser = @(isUser ? "true" : "false");
    var T = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new Dictionary<string, string>
    {
        ["has"] = L["Has access"], ["no"] = L["No access"], ["needsView"] = L["Needs View"],
        ["changes"] = L["unsaved changes"], ["none"] = L["No changes"], ["of"] = L["of"],
        ["confirm"] = L["Save these permission changes? They take effect immediately."],
    }));
    var form = document.getElementById('permForm');
    var rows = Array.from(form.querySelectorAll('[data-row]'));
    var byKey = {};
    rows.forEach(function (r) { byKey[r.dataset.key] = r; });

    // Does the user/role hold this key, ignoring the View dependency?
    function own(r) {
        if (r.dataset.locked === '1') return true;
        if (!isUser) return r.querySelector('input[type=checkbox]').checked;
        var v = r.querySelector('input[type=radio]:checked').value;
        return v === 'allow' ? true : v === 'deny' ? false : r.dataset.roleHas === '1';
    }
    // Effective: actions also need the page's View permission (same rule as the server).
    function effective(r) {
        if (!own(r)) return false;
        var req = r.dataset.requires;
        return !req || !byKey[req] || own(byKey[req]);
    }

    function refresh() {
        var dirty = 0, granted = 0;
        rows.forEach(function (r) {
            var eff = effective(r), badge = r.querySelector('[data-result]');
            if (eff) granted++;
            badge.className = 'pm-result ' + (eff ? 'yes' : 'no');
            badge.textContent = eff ? '✓ ' + T.has : (own(r) ? T.needsView : T.no);
            r.querySelectorAll('input').forEach(function (i) {
                if ((i.type === 'checkbox' && (i.checked ? '1' : '0') !== i.dataset.original) ||
                    (i.type === 'radio' && i.checked && i.dataset.original !== '1')) dirty++;
            });
        });
        document.querySelectorAll('[data-module]').forEach(function (m) {
            var mr = m.querySelectorAll('[data-row]');
            var g = Array.from(mr).filter(effective).length;
            m.querySelector('[data-module-count]').textContent = g + ' / ' + mr.length;
        });
        document.getElementById('pmTotal').textContent = granted + ' ' + T.of + ' ' + rows.length;
        var d = document.getElementById('pmDirty');
        d.textContent = dirty ? '● ' + dirty + ' ' + T.changes : T.none;
        d.className = dirty ? 'fw-bold text-danger small' : 'text-muted small';
        document.getElementById('pmSave').disabled = !dirty;
    }
    form.addEventListener('change', refresh);
    refresh();

    document.getElementById('pmSearch').addEventListener('input', function () {
        var q = this.value.trim().toLowerCase();
        rows.forEach(function (r) { r.style.display = !q || r.dataset.search.indexOf(q) >= 0 ? '' : 'none'; });
    });

    form.addEventListener('submit', function (e) {
        if (!confirm(T.confirm)) { e.preventDefault(); return; }
        form.querySelectorAll('input[data-generated]').forEach(function (n) { n.remove(); });
        if (isUser) {
            // Send the complete set of Allow/Deny choices; anything else inherits.
            rows.forEach(function (r) {
                var c = r.querySelector('input[type=radio]:checked');
                if (!c || c.value === 'inherit' || c.disabled) return;
                var h = document.createElement('input');
                h.type = 'hidden'; h.dataset.generated = '1';
                h.name = 'overrideMap[' + r.dataset.key + ']';
                h.value = c.value === 'allow' ? '2' : '3';
                form.appendChild(h);
            });
        } else {
            // Disabled (locked) switches are not submitted; add them explicitly.
            form.querySelectorAll('input[type=checkbox][disabled]').forEach(function (i) {
                var h = document.createElement('input');
                h.type = 'hidden'; h.dataset.generated = '1'; h.name = 'selected'; h.value = i.value;
                form.appendChild(h);
            });
        }
    });
})();
</script>
