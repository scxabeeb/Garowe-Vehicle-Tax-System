@page
@model VehicleTax.Web.Pages.Account.PermissionHistoryModel
@{
    ViewData["Title"] = L["Permission Change History"];
    Layout = "_Layout";
}
<div class="container-fluid py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <h2 class="mb-0">@L["Permission Change History"]</h2>
        <a class="btn btn-outline-secondary" asp-page="/Account/ManagePermissions">← Permission Manager</a>
    </div>

    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div class="alert alert-success">@Model.Message</div>
    }

    <form method="get" class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="row g-2 align-items-end">
                <div class="col-md-3">
                    <label class="form-label small mb-0">@L["Target Type"]</label>
                    <select class="form-select" asp-for="Target">
                        <option value="0">@L["All"]</option>
                        <option value="1">@L["Roles"]</option>
                        <option value="2">@L["Users"]</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small mb-0">@L["Permission"]</label>
                    <input class="form-control" asp-for="Permission" placeholder="@L["e.g. Payments.Approve"]" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small mb-0">@L["Changed By"]</label>
                    <input class="form-control" asp-for="ChangedBy" placeholder="@L["Username"]" />
                </div>
                <div class="col-md-1">
                    <button class="btn btn-primary w-100" type="submit">@L["Search"]</button>
                </div>
            </div>
        </div>
    </form>

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light"><tr>
                    <th>@L["When"]</th><th>@L["Changed By"]</th><th>@L["Target"]</th><th>@L["Permission"]</th>
                    <th>@L["Previous"]</th><th>@L["New"]</th><th>@L["Details"]</th>
                </tr></thead>
                <tbody>
                @foreach (var r in Model.Rows)
                {
                    <tr>
                        <td>@AppTime.ToLocal(r.When).ToString("dd MMM yyyy HH:mm")</td>
                        <td>@(r.ByUser ?? "-")</td>
                        <td>
                            <span class="badge @(r.TargetType == "Role" ? "bg-primary" : "bg-secondary")">@r.TargetType</span>
                            <span class="ms-1 fw-semibold">@r.Target</span>
                        </td>
                        <td>
                            <div class="fw-semibold">@r.Permission</div>
                            <div class="small text-muted">@(string.IsNullOrEmpty(r.Module) ? "" : (r.Module + " → " + r.Page + (string.IsNullOrEmpty(r.Page) ? "" : "")))</div>
                        </td>
                        <td><span class="badge text-bg-light">@r.OldValue</span></td>
                        <td>
                            @if (r.NewValue == "Granted")
                            {
                                <span class="badge bg-success">@L["Granted"]</span>
                            }
                            else if (r.NewValue == "Revoked")
                            {
                                <span class="badge bg-danger">@L["Revoked"]</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">@r.NewValue</span>
                            }
                        </td>
                        <td class="small text-muted">@r.Details</td>
                    </tr>
                }
                @if (!Model.Rows.Any())
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">@L["No permission changes recorded."]</td></tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>