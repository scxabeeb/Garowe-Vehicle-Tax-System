@page
@model VehicleTax.Web.Pages.Account.RegisterModel
@{
    ViewData["Title"] = L["Register User"];
}

<div class="account-admin-page">
<div class="reg-header mb-3">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div>
            <h4 class="mb-1 admin-header-title"><i class="bi bi-person-plus"></i> @L["Register New User"]</h4>
            <div class="sub">@L["Create a new account and assign the initial role."]</div>
        </div>
        <a asp-page="/Account/Users" class="btn btn-light btn-sm admin-btn">
            <i class="bi bi-arrow-left"></i> @L["Back to Users"]
        </a>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="reg-card">
            <div class="reg-card-head fw-bold">@L["User Details"]</div>
            <div class="reg-card-body">
                <form method="post">
                    <div asp-validation-summary="All" class="alert alert-danger"></div>

                    <div class="mb-3">
                        <label class="form-label">@L["Username"]</label>
                        <input asp-for="Username" class="form-control" placeholder="@L["Enter username"]" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">@L["Full Name"]</label>
                        <input asp-for="FullName" class="form-control" placeholder="@L["Enter full name"]" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">@L["Phone"]</label>
                        <input asp-for="Phone" class="form-control" placeholder="@L["Enter phone number"]" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">@L["Password"]</label>
                        <input asp-for="Password" type="password" class="form-control" placeholder="@L["Enter password"]" />
                    </div>

                    <div class="mb-4">
                        <label class="form-label">@L["Role"]</label>
                        <select asp-for="Role" class="form-select">
                            <option value="">@L["Select Role"]</option>
                            <option value="Admin">@L["Admin"]</option>
                            <option value="Collector">@L["Collector"]</option>
                            <option value="Viewer">@L["Viewer"]</option>
                            <option value="Auditor">@L["Auditor"]</option>
                        </select>
                    </div>

                    <div class="mb-4">
                        <label class="form-label">@L["Checkpoint"]</label>
                        <select asp-for="CheckpointId" asp-items="Model.Checkpoints" class="form-select">
                            <option value="">@L["No checkpoint"]</option>
                        </select>
                    </div>

                    <div class="d-grid gap-2 d-md-flex">
                        <button class="btn btn-success w-100 admin-btn">
                            <i class="bi bi-check-circle"></i> @L["Create User"]
                        </button>
                        <a asp-page="/Account/Users" class="btn btn-outline-secondary w-100 admin-btn">
                            <i class="bi bi-x-circle"></i> @L["Cancel"]
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
</div>