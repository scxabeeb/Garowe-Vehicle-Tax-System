@page
@model UsersModel
@{
    ViewData["Title"] = L["Users"];

    var totalUsers = Model.Users.Count;
    var adminUsers = Model.Users.Count(u => string.Equals(u.User.Role, "Admin", StringComparison.OrdinalIgnoreCase));
    var lockedUsers = Model.Users.Count(u => u.User.IsLocked);
}

<div class="account-admin-page">
<div class="users-header mb-3">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div>
            <h4 class="mb-1 admin-header-title"><i class="bi bi-people"></i> @L["User Administration"]</h4>
            <div class="sub">@L["Manage user accounts, permissions, and access visibility."]</div>
        </div>
        <div class="d-flex gap-2">
            <a asp-page="/Checkpoints/Index" class="btn btn-outline-light btn-sm admin-btn">
                <i class="bi bi-geo-alt"></i> @L["Checkpoints"]
            </a>
            <a asp-page="/Account/Register" class="btn btn-light btn-sm admin-btn">
                <i class="bi bi-person-plus"></i> @L["Register User"]
            </a>
            <a asp-page="/Account/UserSecurity" class="btn btn-outline-light btn-sm admin-btn">
                <i class="bi bi-shield-lock"></i> @L["User Security"]
            </a>
        </div>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-4">
        <div class="stat-card">
            <div class="small text-muted">@L["Total Users"]</div>
            <div class="fs-4 fw-bold">@totalUsers</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card">
            <div class="small text-muted">@L["Admin Users"]</div>
            <div class="fs-4 fw-bold">@adminUsers</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card">
            <div class="small text-muted">@L["Locked Users"]</div>
            <div class="fs-4 fw-bold text-danger">@lockedUsers</div>
        </div>
    </div>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

@if (TempData["Message"] != null)
{
    <div class="alert alert-success">
        @TempData["Message"]
    </div>
}

<div class="users-table-card">
    <div class="table-responsive">
        <table class="table table-bordered table-striped align-middle mb-0 users-table">
            <thead class="table-dark">
                <tr>
                    <th>@L["Username"]</th>
                    <th>@L["Full Name"]</th>
                    <th>@L["Phone"]</th>
                    <th>@L["Role"]</th>
                    <th>@L["Checkpoint"]</th>
                    <th>@L["Status"]</th>
                    <th>@L["Permissions"]</th>
                    <th>@L["Can See Pages"]</th>
                    <th style="min-width:220px;">@L["Manage"]</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var u in Model.Users)
                {
                    var permissions = (u.User.Permissions ?? string.Empty)
                        .Split(',', StringSplitOptions.RemoveEmptyEntries)
                        .Select(p => p.Trim())
                        .Where(p => !string.IsNullOrWhiteSpace(p))
                        .ToList();

                    <tr>
                        <td data-label="Username" class="fw-semibold">@u.User.Username</td>
                        <td data-label="Full Name">@(string.IsNullOrWhiteSpace(u.User.FullName) ? "-" : u.User.FullName)</td>
                        <td data-label="Phone">@(string.IsNullOrWhiteSpace(u.User.Phone) ? "-" : u.User.Phone)</td>
                        <td data-label="Role">
                            <span class="badge bg-info text-dark">@u.User.Role</span>
                        </td>
                        <td data-label="Checkpoint">@(u.User.Checkpoint?.Name ?? "Not assigned")</td>
                        <td data-label="Status">
                            @if (u.User.IsLocked)
                            {
                                <span class="badge bg-danger">@L["Locked"]</span>
                            }
                            else
                            {
                                <span class="badge bg-success">@L["Active"]</span>
                            }
                        </td>
                        <td data-label="Permissions" style="word-break: break-word; min-width:220px;">
                            @if (permissions.Any())
                            {
                                <div class="d-flex flex-wrap gap-1">
                                    @foreach (var perm in permissions)
                                    {
                                        <span class="badge perm-badge">@perm</span>
                                    }
                                </div>
                            }
                            else
                            {
                                <span class="text-muted">@L["No permissions assigned"]</span>
                            }
                        </td>
                        <td data-label="Can See Pages" class="pages-text" style="min-width:220px;">
                            @u.VisiblePagesText
                        </td>
                        <td data-label="Action">
                            <div class="d-grid gap-1">
                                <a class="btn btn-sm btn-primary admin-btn"
                                   asp-page="/Account/ManagePermissions"
                                   asp-route-userId="@u.User.Id">
                                    <i class="bi bi-sliders"></i> @L["Permissions"]
                                </a>

                                          <a class="btn btn-sm btn-warning admin-btn"
                                   asp-page="/Account/EditUser"
                                   asp-route-id="@u.User.Id">
                                    <i class="bi bi-pencil"></i> @L["Edit"]
                                </a>

                                        <form method="post"
                                              asp-page-handler="ToggleActive"
                                              asp-route-id="@u.User.Id"
                                              onsubmit="return confirm('Are you sure you want to change this user status?');">
                                            @if (u.User.IsLocked)
                                            {
                                                <button type="submit" class="btn btn-sm btn-success w-100 admin-btn">
                                                    <i class="bi bi-check-circle"></i> @L["Set Active"]
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="submit" class="btn btn-sm btn-outline-danger w-100 admin-btn">
                                                    <i class="bi bi-pause-circle"></i> @L["Set Inactive"]
                                                </button>
                                            }
                                        </form>

                                <form method="post"
                                      asp-page-handler="Delete"
                                      asp-route-id="@u.User.Id"
                                      onsubmit="return confirm('Are you sure you want to delete this user?');">
                                    <button type="submit" class="btn btn-sm btn-danger w-100 admin-btn">
                                        <i class="bi bi-trash"></i> @L["Delete"]
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
</div>
