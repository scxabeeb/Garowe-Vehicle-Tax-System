@page
@model UsersModel
@using VehicleTax.Web.Security
@{
    ViewData["Title"] = L["User Management"];
    var my = Model.MyPermissions;
    bool can(string k) => my.Contains(k);
    var roles = Model.Users.Select(x => x.User.Role).Where(r => !string.IsNullOrWhiteSpace(r)).Distinct().OrderBy(r => r).ToList();
    string roleColor(string? r) => (r ?? "").ToLowerInvariant() switch
    {
        "admin" => "#dc2626", "collector" => "#16a34a", "auditor" => "#d97706", "viewer" => "#64748b",
        "accountant" => "#7c3aed", "manager" => "#0891b2", _ => "#0b57d0"
    };
    string initials(string? name, string user)
    {
        var parts = (string.IsNullOrWhiteSpace(name) ? user : name).Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return string.Concat(parts.Take(2).Select(p => char.ToUpperInvariant(p[0])));
    }
}

<style>
    .um-hero { background: linear-gradient(135deg, #0b57d0, #1e3a8a); color: #fff; border-radius: 18px; padding: 22px 24px; }
    .um-kpi { border: 1px solid #e2e8f0; border-radius: 16px; background: #fff; padding: 14px 16px; display: flex; gap: 12px; align-items: center; }
    .um-kpi .ic { width: 42px; height: 42px; border-radius: 12px; display: grid; place-items: center; font-size: 1.2rem; }
    .um-kpi .v { font-size: 1.5rem; font-weight: 800; line-height: 1; }
    .um-kpi .l { font-size: 12px; color: #64748b; font-weight: 600; }
    .um-card { border: 1px solid #e2e8f0; border-radius: 16px; background: #fff; overflow: hidden; }
    .um-chip { border: 1px solid #e2e8f0; background: #fff; border-radius: 999px; padding: 5px 13px; font-size: 13px; font-weight: 600; color: #334155; cursor: pointer; }
    .um-chip.active { background: #0b57d0; border-color: #0b57d0; color: #fff; }
    .um-table td, .um-table th { vertical-align: middle; }
    .um-table thead th { font-size: 12px; text-transform: uppercase; letter-spacing: .04em; color: #64748b; background: #f8fafc; border-bottom: 1px solid #e2e8f0; }
    .um-avatar { width: 40px; height: 40px; border-radius: 12px; display: grid; place-items: center; color: #fff; font-weight: 800; flex-shrink: 0; }
    .um-role { font-size: 12px; font-weight: 700; border-radius: 999px; padding: 3px 10px; }
    .um-status { font-size: 12px; font-weight: 700; border-radius: 999px; padding: 3px 10px 3px 6px; display: inline-flex; align-items: center; white-space: nowrap; }
    .um-status::before { content: ""; width: 7px; height: 7px; border-radius: 50%; background: currentColor; margin-right: 6px; }
    .um-mod { width: 26px; height: 26px; border-radius: 8px; display: inline-grid; place-items: center; background: #eef4ff; color: #0b57d0; font-size: 13px; }
    .um-act { width: 34px; height: 34px; border-radius: 10px; display: inline-grid; place-items: center; border: 1px solid #e2e8f0; background: #fff; color: #334155; }
    .um-act:hover { background: #f1f5f9; }
    .um-act.danger { color: #dc2626; }
    .um-switch { width: 2.4em !important; height: 1.25em; cursor: pointer; margin: 0 !important; float: none !important; }
    .um-switch:not(:checked) { background-color: #fecaca; border-color: #fca5a5; }
    .um-switch:checked { background-color: #16a34a; border-color: #16a34a; }
    .form-switch .form-check-label.um-status { cursor: pointer; }
    .um-toggle { height: 34px; padding: 0 12px; border-radius: 10px; display: inline-flex; align-items: center; gap: 6px; font-size: .82rem; font-weight: 600; border: 1px solid; vertical-align: middle; }
    .um-toggle.off { background: #fef2f2; color: #b91c1c; border-color: #fecaca; }
    .um-toggle.off:hover { background: #fee2e2; }
    .um-toggle.on { background: #f0fdf4; color: #15803d; border-color: #bbf7d0; }
    .um-toggle.on:hover { background: #dcfce7; }
</style>

<div class="container py-4">
    <div class="um-hero mb-3 d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <h3 class="fw-bold mb-1"><i class="bi bi-people me-2"></i>@L["User Management"]</h3>
            <div style="opacity:.8">@L["Manage user accounts, permissions, and access visibility."]</div>
        </div>
        <div class="d-flex gap-2">
            @if (can(AppPermissions.Keys.RolesManagePermissions))
            {
                <a class="btn btn-outline-light" asp-page="/Account/ManagePermissions"><i class="bi bi-shield-lock me-1"></i>@L["Manage Permissions"]</a>
            }
            @if (can(AppPermissions.Keys.UsersCreate))
            {
                <a class="btn btn-light fw-semibold" asp-page="/Account/Register"><i class="bi bi-person-plus me-1"></i>@L["New User"]</a>
            }
        </div>
    </div>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success d-flex align-items-center gap-2"><i class="bi bi-check-circle-fill"></i>@TempData["Message"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger d-flex align-items-center gap-2"><i class="bi bi-exclamation-triangle-fill"></i>@TempData["Error"]</div>
    }

    <div class="row g-3 mb-3">
        @{
            var kpis = new[]
            {
                (L["Total Users"], Model.Users.Count.ToString(), "bi-people", "#0b57d0", "#eef4ff"),
                (L["Active"], Model.Users.Count(x => !x.User.IsLocked).ToString(), "bi-person-check", "#16a34a", "#dcfce7"),
                (L["Inactive"], Model.Users.Count(x => x.User.IsLocked).ToString(), "bi-person-x", "#dc2626", "#fee2e2"),
                (L["Roles"], roles.Count.ToString(), "bi-diagram-3", "#7c3aed", "#ede9fe"),
            };
        }
        @foreach (var k in kpis)
        {
            <div class="col-6 col-lg-3">
                <div class="um-kpi">
                    <span class="ic" style="background:@k.Item5;color:@k.Item4"><i class="bi @k.Item3"></i></span>
                    <div><div class="v">@k.Item2</div><div class="l">@k.Item1</div></div>
                </div>
            </div>
        }
    </div>

    <div class="um-card">
        <div class="p-3 d-flex flex-wrap gap-2 align-items-center border-bottom">
            <div class="position-relative" style="min-width:240px;flex:1;max-width:360px;">
                <i class="bi bi-search position-absolute text-muted" style="left:12px;top:9px;"></i>
                <input id="umSearch" class="form-control ps-5" placeholder="@L["Search name, username, phone…"]" />
            </div>
            <div class="d-flex flex-wrap gap-2" id="umRoles">
                <span class="um-chip active" data-role="">@L["All"]</span>
                @foreach (var r in roles)
                {
                    <span class="um-chip" data-role="@r.ToLowerInvariant()">@L[r]</span>
                }
            </div>
            <select id="umStatus" class="form-select ms-auto" style="width:auto;">
                <option value="">@L["All Status"]</option>
                <option value="active">@L["Active"]</option>
                <option value="inactive">@L["Inactive"]</option>
            </select>
        </div>

        <div class="table-responsive">
            <table class="table um-table mb-0">
                <thead>
                    <tr>
                        <th>@L["User"]</th>
                        <th>@L["Role"]</th>
                        <th>@L["Checkpoint"]</th>
                        <th>@L["Status"]</th>
                        <th>@L["Access"]</th>
                        <th class="text-end">@L["Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Users)
                    {
                        var x = row.User;
                        var isMe = string.Equals(User.Identity?.Name, x.Username, StringComparison.OrdinalIgnoreCase);
                        <tr data-user data-role="@((x.Role ?? "").ToLowerInvariant())" data-status="@(x.IsLocked ? "inactive" : "active")"
                            data-search="@($"{x.Username} {x.FullName} {x.Phone} {x.Role}".ToLowerInvariant())">
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="um-avatar" style="background:@roleColor(x.Role)">@initials(x.FullName, x.Username)</span>
                                    <div>
                                        <div class="fw-bold">@(string.IsNullOrWhiteSpace(x.FullName) ? x.Username : x.FullName)
                                            @if (isMe) { <span class="badge bg-primary-subtle text-primary ms-1">@L["You"]</span> }
                                        </div>
                                        <div class="small text-muted">@@@x.Username · System ID @x.Id@(string.IsNullOrWhiteSpace(x.Phone) ? "" : " · " + x.Phone)</div>
                                    </div>
                                </div>
                            </td>
                            <td><span class="um-role" style="background:@(roleColor(x.Role))1a;color:@roleColor(x.Role)">@L[x.Role ?? "-"]</span></td>
                            <td>@(x.Checkpoint?.Name ?? "—")</td>
                            <td>
                                @if (can(AppPermissions.Keys.UsersEdit) && !isMe)
                                {
                                    @* Click the switch to change the status; the page asks first. *@
                                    <form method="post" asp-page-handler="ToggleActive" asp-route-id="@x.Id" class="m-0"
                                          onsubmit="return confirm('@(x.IsLocked ? L["Set this user Active? They can log in again."] : L["Set this user Inactive? They will be signed out and cannot log in on the web or the app."])');">
                                        <div class="form-check form-switch m-0 p-0 d-flex align-items-center gap-2" title="@L[x.IsLocked ? "Set Active" : "Set Inactive"]">
                                            <input class="form-check-input um-switch" type="checkbox" role="switch" id="umSw@(x.Id)"
                                                   checked="@(x.IsLocked ? null : "checked")"
                                                   onchange="if (!this.form.requestSubmit) { this.form.submit(); } else { this.form.requestSubmit(); } this.checked = !this.checked;" />
                                            <label class="form-check-label um-status m-0" for="umSw@(x.Id)"
                                                   style="@(x.IsLocked ? "background:#fee2e2;color:#b91c1c" : "background:#dcfce7;color:#15803d")">@L[x.IsLocked ? "Inactive" : "Active"]</label>
                                        </div>
                                    </form>
                                }
                                else if (x.IsLocked)
                                {
                                    <span class="um-status" style="background:#fee2e2;color:#b91c1c">@L["Inactive"]</span>
                                }
                                else
                                {
                                    <span class="um-status" style="background:#dcfce7;color:#15803d">@L["Active"]</span>
                                }
                            </td>
                            <td>
                                <div class="d-flex align-items-center gap-1 flex-wrap">
                                    @foreach (var m in row.Modules)
                                    {
                                        <span class="um-mod" title="@L[m.Name]"><i class="bi @m.Icon"></i></span>
                                    }
                                    <span class="small text-muted ms-1">@row.PermissionCount @L["permissions"]</span>
                                    @if (row.HasOverrides)
                                    {
                                        <span class="badge bg-warning-subtle text-warning-emphasis" title="@L["Has user-specific overrides"]">@L["Custom"]</span>
                                    }
                                </div>
                            </td>
                            <td class="text-end text-nowrap">
                                @if (can(AppPermissions.Keys.UsersEdit))
                                {
                                    <a class="um-act" title="@L["Edit"]" asp-page="/Account/EditUser" asp-route-id="@x.Id"><i class="bi bi-pencil"></i></a>
                                }
                                @if (can(AppPermissions.Keys.RolesManagePermissions))
                                {
                                    <a class="um-act" title="@L["Permissions"]" asp-page="/Account/ManagePermissions" asp-route-userId="@x.Id"><i class="bi bi-shield-lock"></i></a>
                                }
                                @if (can(AppPermissions.Keys.UsersEdit) && !isMe)
                                {
                                    <form method="post" asp-page-handler="ToggleActive" asp-route-id="@x.Id" class="d-inline"
                                          onsubmit="return confirm('@(x.IsLocked ? L["Set this user Active? They can log in again."] : L["Set this user Inactive? They will be signed out and cannot log in on the web or the app."])');">
                                        @if (x.IsLocked)
                                        {
                                            <button class="um-toggle on" type="submit"><i class="bi bi-person-check"></i>@L["Set Active"]</button>
                                        }
                                        else
                                        {
                                            <button class="um-toggle off" type="submit"><i class="bi bi-person-x"></i>@L["Set Inactive"]</button>
                                        }
                                    </form>
                                }
                                @if (can(AppPermissions.Keys.UsersDelete) && !isMe)
                                {
                                    <form method="post" asp-page-handler="Delete" asp-route-id="@x.Id" class="d-inline"
                                          onsubmit="return confirm('@L["Delete this user? This cannot be undone."]');">
                                        <button class="um-act danger" type="submit" title="@L["Delete"]"><i class="bi bi-trash"></i></button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <div id="umEmpty" class="text-center text-muted p-4" style="display:none;">@L["No users found."]</div>
        </div>
    </div>
</div>

<script>
(function () {
    var role = '', rows = document.querySelectorAll('[data-user]');
    function apply() {
        var q = document.getElementById('umSearch').value.trim().toLowerCase();
        var st = document.getElementById('umStatus').value, shown = 0;
        rows.forEach(function (r) {
            var ok = (!q || r.dataset.search.indexOf(q) >= 0) && (!role || r.dataset.role === role) && (!st || r.dataset.status === st);
            r.style.display = ok ? '' : 'none'; if (ok) shown++;
        });
        document.getElementById('umEmpty').style.display = shown ? 'none' : '';
    }
    document.getElementById('umSearch').addEventListener('input', apply);
    document.getElementById('umStatus').addEventListener('change', apply);
    document.querySelectorAll('#umRoles .um-chip').forEach(function (c) {
        c.addEventListener('click', function () {
            document.querySelectorAll('#umRoles .um-chip').forEach(function (x) { x.classList.remove('active'); });
            c.classList.add('active'); role = c.dataset.role; apply();
        });
    });
})();
</script>
