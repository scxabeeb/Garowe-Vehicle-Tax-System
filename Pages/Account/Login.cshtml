@page
@model VehicleTax.Web.Pages.Account.LoginModel
@{
    Layout = "_LoginLayout";
    ViewData["Title"] = L["Login"];
}

<div class="card border-0 shadow-lg"
     style="max-width:360px;
            width:100%;
            border-radius:16px;
            background:white;">

    <div class="card-body p-4">

        <div class="text-end mb-1">
            @{ ViewData["LangSwitchDark"] = false; }
            <partial name="_LangSwitch" view-data="ViewData" />
        </div>

        <div class="text-center mb-3">
            <img src="/images/Logo.jpeg"
                 width="70"
                 height="70"
                 class="mb-2 rounded-circle shadow-sm" />

            <h6 class="fw-bold mb-0">@L["Garowe Municipality"]</h6>
            <small class="text-muted">@L["Vehicle Tax System"]</small>
        </div>

        <form method="post">

            <div class="mb-3">
                <div class="input-group">
                    <span class="input-group-text bg-white">
                        <i class="bi bi-person text-primary"></i>
                    </span>
                    <input asp-for="Username"
                           class="form-control"
                           placeholder="@L["Username"]"
                           required />
                </div>
            </div>

            <div class="mb-4">
                <div class="input-group">
                    <span class="input-group-text bg-white">
                        <i class="bi bi-lock text-primary"></i>
                    </span>
                    <input asp-for="Password"
                           type="password"
                           id="loginPassword"
                           class="form-control border-end-0"
                           placeholder="@L["Password"]"
                           autocomplete="current-password"
                           required />
                    <button type="button" class="input-group-text bg-white" id="togglePassword"
                            title="@L["Show password"]" aria-label="@L["Show password"]"
                            data-show="@L["Show password"]" data-hide="@L["Hide password"]">
                        <i class="bi bi-eye text-secondary"></i>
                    </button>
                </div>
            </div>

            <button type="submit"
                    class="btn btn-primary w-100 fw-semibold">
                @L["Login"]
            </button>

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger text-center mt-3 mb-0 py-2 small">
                    @Model.ErrorMessage
                </div>
            }
        </form>

    </div>
</div>

<div class="text-white-50 small mt-3">
    © @VehicleTax.Web.AppTime.Now.Year @L["Garowe Municipality"]
</div>

<script>
    (function () {
        var input = document.getElementById('loginPassword'), btn = document.getElementById('togglePassword');
        btn.addEventListener('click', function () {
            var show = input.type === 'password';
            input.type = show ? 'text' : 'password';
            btn.firstElementChild.className = 'bi ' + (show ? 'bi-eye-slash' : 'bi-eye') + ' text-secondary';
            btn.title = btn.ariaLabel = show ? btn.dataset.hide : btn.dataset.show;
            input.focus();
        });
    })();
</script>
