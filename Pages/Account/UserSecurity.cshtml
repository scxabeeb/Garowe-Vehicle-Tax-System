@using VehicleTax.Web.Security

<h3 class="mb-4">User Security Management</h3>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success">@TempData["Message"]</div>
}

<!-- STEP 1: OPERATION -->
<div class="card shadow p-4 mb-4 col-md-6">
    <h5>Security Operation</h5>

    <form method="get">
        <div class="mb-3">
            <label class="form-label">Operation</label>
            <select class="form-select" name="operation" required>
                <option value="">-- Select Operation --</option>

                @if (Model.CanAccess(SecurityOperation.AccountStatus))
                {
                    <option value="AccountStatus">Account Lock / Unlock</option>
                }

                @if (Model.CanAccess(SecurityOperation.PasswordReset))
                {
                    <option value="PasswordReset">Password Reset</option>
                }
            </select>
        </div>

        <button class="btn btn-primary">Continue</button>
    </form>
</div>

<!-- STEP 2: USER -->
@if (Model.Operation != SecurityOperation.None)
{
    <div class="card shadow p-4 mb-4 col-md-6">
        <h5>Select User</h5>

        <form method="get">
            <input type="hidden" name="operation" value="@Model.Operation" />

            <div class="mb-3">
                <label class="form-label">User</label>
                <select class="form-select" name="id" required>
                    <option value="">-- Select User --</option>
                    @foreach (var u in Model.AllUsers)
                    {
                        <option value="@u.Id">@u.Username (@u.Role)</option>
                    }
                </select>
            </div>

            <button class="btn btn-success">Load User</button>
        </form>
    </div>
}

