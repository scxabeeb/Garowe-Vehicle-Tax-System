@page
@model VehicleTax.Web.Pages.Reports.TaxMovementModel

<div class="module-page">
<div class="module-header mb-4">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div>
            <h3 class="fw-bold mb-1">@L["Tax Amount by Traffida Report"]</h3>
            <div class="sub">@L["Analyze collected tax grouped by traffida with date filters."]</div>
        </div>
    </div>
</div>

<form method="get" class="card module-filter-card p-3 mb-3">
    <div class="row g-2">
        <div class="col-md-3">
            <label class="form-label">@L["From Date"]</label>
            <input type="date" asp-for="FromDate" class="form-control" />
        </div>

        <div class="col-md-3">
            <label class="form-label">@L["To Date"]</label>
            <input type="date" asp-for="ToDate" class="form-control" />
        </div>

        <div class="col-md-3">
            <label class="form-label">@L["Traffida"]</label>
            <select asp-for="MovementId" asp-items="Model.Movements" class="form-select">
                <option value="">@L["All Traffida"]</option>
            </select>
        </div>

        <div class="col-md-3">
            <label class="form-label">@L["Page Size"]</label>
            <select asp-for="PageSize" class="form-select">
                <option value="10">10</option>
                <option value="20" selected>20</option>
                <option value="50">50</option>
                <option value="100">100</option>
                <option value="999999">@L["All"]</option>
            </select>
        </div>

        <div class="col-md-12 d-flex align-items-end gap-2">
            <button type="submit" class="btn btn-primary w-100 module-action-btn">@L["Filter"]</button>
            <a asp-page="./TaxMovement" class="btn btn-secondary w-100 module-action-btn">@L["Reset"]</a>
            <a asp-page-handler="Export"
               asp-route-FromDate="@Model.FromDate"
               asp-route-ToDate="@Model.ToDate"
               asp-route-MovementId="@Model.MovementId"
               class="btn btn-success w-100 module-action-btn">
                @L["Export CSV"]
            </a>
        </div>
    </div>
</form>

<div class="card module-kpi-card mb-3">
    <div class="card-body text-center">
        <div class="module-kpi-title">@L["Total Tax Collected"]</div>
        <h2 class="module-kpi-value text-success">
            $@Model.TotalTax.ToString("N0")
        </h2>
    </div>
</div>

<div class="card module-table-card">
    <div class="card-header fw-bold">
        @L["Tax Amount Linked With Traffida"]
    </div>
    <div class="card-body p-0">
        <table class="table table-striped mb-0">
            <thead class="table-dark">
                <tr>
                    <th>@L["Traffida"]</th>
                    <th>@L["Total Payments"]</th>
                    <th>@L["Total Amount"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.MovementTotals)
                {
                    <tr>
                        <td>@item.MovementName</td>
                        <td>@item.TotalPayments</td>
                        <td>$@item.TotalAmount.ToString("N0")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Pagination -->
<nav class="mt-3">
    <ul class="pagination justify-content-center">
        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                <a class="page-link"
                   asp-route-PageNumber="@i"
                   asp-route-PageSize="@Model.PageSize"
                   asp-route-FromDate="@Model.FromDate"
                   asp-route-ToDate="@Model.ToDate"
                   asp-route-MovementId="@Model.MovementId">
                    @i
                </a>
            </li>
        }
    </ul>
</nav>

</div>
