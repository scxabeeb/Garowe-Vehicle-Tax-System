@page
@model VehicleTax.Web.Pages.Reports.GolisAuditHistoryModel

<div class="container mt-4">
    <h3 class="fw-bold mb-4">
        <i class="bi bi-clock-history"></i>
        @L["Golis Audit History"]
    </h3>

    <div class="card shadow-sm border-0 mb-3">
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">@L["Search"]</label>
                    <input type="text" name="search" value="@Model.Search" class="form-control" placeholder="@L["Statement number, notes..."]" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">@L["Status"]</label>
                    <select name="statusFilter" class="form-select">
                        <option value="" selected="@(Model.StatusFilter == null ? "selected" : null)">@L["All"]</option>
                        <option value="Draft" selected="@(Model.StatusFilter == AuditStatus.Draft ? "selected" : null)">@L["Draft"]</option>
                        <option value="Finalized" selected="@(Model.StatusFilter == AuditStatus.Finalized ? "selected" : null)">@L["Finalized"]</option>
                        <option value="Reopened" selected="@(Model.StatusFilter == AuditStatus.Reopened ? "selected" : null)">@L["Reopened"]</option>
                    </select>
                </div>
                <div class="col-md-3 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary me-2">
                        <i class="bi bi-search"></i> @L["Filter"]
                    </button>
                    <a asp-page="./GolisAuditHistory" class="btn btn-secondary">@L["Reset"]</a>
                </div>
                <div class="col-md-2 d-flex align-items-end justify-content-end">
                    <a asp-page="./GolisAudit" class="btn btn-success">
                        <i class="bi bi-plus-circle"></i> @L["New Audit"]
                    </a>
                </div>
            </form>
        </div>
    </div>

    @{
        ViewData["DetailCount"] = Model.Audits.Count;
        var auditGroups = new List<VehicleTax.Web.Services.CountGroup>
        {
            new(L["Audits by Status"], "bi-clipboard-check",
                VehicleTax.Web.Services.ReportDetails.CountBy(Model.Audits, a => a.Status.ToString())),
        };
        var golisTotal = Model.Audits.Sum(a => a.TotalGolisAmount);
        var systemTotal = Model.Audits.Sum(a => a.TotalSystemAmount);
    }
    <partial name="_ReportViewToggle" />

    <div data-report-view="summary">
        <div class="row g-3 mb-3">
            <div class="col-md-4"><div class="card shadow-sm border-0 text-center"><div class="card-body">
                <div class="text-muted small">@L["Golis Total"]</div><div class="fs-4 fw-bold">$@golisTotal.ToString("N0")</div>
            </div></div></div>
            <div class="col-md-4"><div class="card shadow-sm border-0 text-center"><div class="card-body">
                <div class="text-muted small">@L["System Total"]</div><div class="fs-4 fw-bold">$@systemTotal.ToString("N0")</div>
            </div></div></div>
            <div class="col-md-4"><div class="card shadow-sm border-0 text-center"><div class="card-body">
                <div class="text-muted small">@L["Difference"]</div>
                <div class="fs-4 fw-bold @(golisTotal - systemTotal == 0 ? "text-success" : "text-danger")">$@((golisTotal - systemTotal).ToString("N0"))</div>
            </div></div></div>
        </div>
        <partial name="_CountGroups" model="auditGroups" />
    </div>

    <div data-report-view="details">
    <div class="card shadow-sm border-0">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-striped table-sm align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>@L["System ID"]</th>
                            <th>@L["Statement Number"]</th>
                            <th>@L["Period"]</th>
                            <th class="text-end">@L["Golis Total"]</th>
                            <th class="text-end">@L["System Total"]</th>
                            <th class="text-end">@L["Difference"]</th>
                            <th>@L["Matched"]</th>
                            <th>@L["Unmatched"]</th>
                            <th>@L["Auditor"]</th>
                            <th>@L["Audit Date"]</th>
                            <th>@L["Status"]</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var a in Model.Audits)
                        {
                            <tr>
                                <td>@a.Id</td>
                                <td>@a.StatementNumber</td>
                                <td>@a.AuditPeriodFrom.ToString("dd MMM yyyy") - @a.AuditPeriodTo.ToString("dd MMM yyyy")</td>
                                <td class="text-end">$@a.TotalGolisAmount.ToString("N0")</td>
                                <td class="text-end">$@a.TotalSystemAmount.ToString("N0")</td>
                                <td class="text-end @(a.Difference == 0 ? "text-success" : "text-danger")">$@a.Difference.ToString("N0")</td>
                                <td>@a.MatchedCount</td>
                                <td>@(a.TotalGolisTransactions - a.MatchedCount)</td>
                                <td>@(a.FinalizedByUser?.Username ?? a.CreatedByUser?.Username ?? "-")</td>
                                <td>@(VehicleTax.Web.AppTime.ToLocal(a.FinalizedAt ?? a.CreatedAt).ToString("dd MMM yyyy HH:mm"))</td>
                                <td>
                                    @if (a.Status == AuditStatus.Finalized)
                                    {
                                        <span class="badge bg-success">@L["Finalized"]</span>
                                    }
                                    else if (a.Status == AuditStatus.Reopened)
                                    {
                                        <span class="badge bg-warning text-dark">@L["Reopened"]</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@L["Draft"]</span>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex gap-1">
                                        <a asp-page="./GolisAudit" asp-route-auditId="@a.Id" class="btn btn-sm btn-primary">
                                            <i class="bi bi-eye"></i> @L["View"]
                                        </a>
                                        <form method="post" asp-page="./GolisAudit" asp-page-handler="DeleteAudit" asp-route-auditId="@a.Id" onsubmit="return confirm('Delete this entire audit?');">
                                            <button type="submit" class="btn btn-sm btn-danger">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    </div>
</div>
