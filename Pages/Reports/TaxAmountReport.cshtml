@page
@model VehicleTax.Web.Pages.Reports.TaxAmountReportModel

<h3 class="mb-3">
    <i class="bi bi-cash-stack text-success"></i> @L["Tax Amount Schedule"]
</h3>

<form method="get" class="row g-2 mb-3">
    <input type="hidden" name="PageSize" value="@Model.Pager.PageSize" />

    <!-- Search -->
    <div class="col-md-4">
        <input type="text"
               name="Search"
               value="@Model.Search"
               class="form-control"
               placeholder="@L["Search car type or tariff..."]" />
    </div>

    <!-- Car Type Filter -->
    <div class="col-md-3">
        <select name="CarTypeId" class="form-select">
            <option value="">@L["All Car Types"]</option>
            @foreach (var ct in Model.CarTypes)
            {
                <option value="@ct.Id" selected="@(Model.CarTypeId == ct.Id ? "selected" : null)">
                    @ct.Name
                </option>
            }
        </select>
    </div>

    <!-- Movement Filter (by NAME, unique, no duplicates) -->
    <div class="col-md-3">
        <select name="MovementName" class="form-select">
            <option value="">@L["All Tariffs"]</option>
            @foreach (var mv in Model.Movements)
            {
                var isSelected = string.Equals(Model.MovementName, mv.Name, StringComparison.OrdinalIgnoreCase);
                <option value="@mv.Name" selected="@(isSelected ? "selected" : null)">
                    @mv.Name
                </option>
            }
        </select>
    </div>

    <!-- Filter Button -->
    <div class="col-md-2 d-grid">
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-funnel-fill"></i> @L["Filter"]
        </button>
    </div>
</form>

<!-- Export Button -->
<a asp-page-handler="ExportCsv"
   asp-route-carTypeId="@Model.CarTypeId"
   asp-route-movementName="@Model.MovementName"
   asp-route-search="@Model.Search"
   class="btn btn-success mb-3">
    <i class="bi bi-file-earmark-excel"></i> @L["Export to CSV"]
</a>

@{ ViewData["DetailCount"] = Model.TotalCount; }
<partial name="_ReportViewToggle" />

<div data-report-view="summary">
    <partial name="_CountGroups" model="Model.SummaryGroups" />
</div>

<div data-report-view="details">
<div class="table-responsive">
    <table class="table table-bordered table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>@L["System ID"]</th>
                <th>@L["Car Type"]</th>
                <th>@L["Tariff"]</th>
                <th>@L["Amount"]</th>
                <th>@L["Status"]</th>
            </tr>
        </thead>
        <tbody>
        @if (Model.TaxAmounts.Any())
        {
            int i = Model.Pager.From;
            foreach (var t in Model.TaxAmounts)
            {
                string badgeClass = t.Movement?.Name switch
                {
                    "Registration" => "bg-primary",
                    "Renewal" => "bg-success",
                    "Transfer" => "bg-warning text-dark",
                    "Inspection" => "bg-info text-dark",
                    "Penalty" => "bg-danger",
                    _ => "bg-secondary"
                };

                <tr>
                    <td class="fw-semibold">@t.Id</td>
                    <td>@t.CarType?.Name</td>
                    <td>
                        <span class="badge @badgeClass">
                            @t.Movement?.Name
                        </span>
                    </td>
                    <td class="fw-bold text-success">
                        $@t.Amount.ToString("N0")
                    </td>
                    <td>
                        <span class="badge @(t.Movement?.IsActive == false ? "bg-secondary" : "bg-success")">@L[t.Movement?.IsActive == false ? "Inactive" : "Active"]</span>
                        @if (Model.DuplicateIds.Contains(t.Id))
                        {
                            <span class="badge bg-danger" title="@L["The same car type and tariff has more than one tax amount."]">@L["Duplicate"]</span>
                        }
                    </td>
                </tr>
                i++;
            }
        }
        else
        {
            <tr>
                <td colspan="5" class="text-center text-muted">
                    @L["No records found."]
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

<!-- Pagination -->
<partial name="_Pager" model="Model.Pager" />
</div>
