@page
@model VehicleTax.Web.Pages.Reports.AccountTariffsModel
@{
    ViewData["Title"] = L["Revenue Account Tariffs"];
    ViewData["DetailCount"] = Model.Accounts.Sum(a => a.Rows);
    ViewData["SummaryHint"] = L["Tariffs and amounts per account"];
    string money(decimal? m) => m.HasValue ? "$" + m.Value.ToString("N2") : "—";
}
<style>
    .at-hero { background: linear-gradient(135deg, #0b57d0, #1e3a8a); color: #fff; border-radius: 18px; padding: 20px 24px; }
    .at-card { border: 1px solid #e2e8f0; border-radius: 16px; background: #fff; overflow: hidden; }
    .at-card .head { padding: 12px 16px; border-bottom: 1px solid #f1f5f9; display: flex; flex-wrap: wrap; gap: 8px; align-items: center; justify-content: space-between; }
    .at-table thead th { font-size: 12px; text-transform: uppercase; letter-spacing: .04em; color: #64748b; background: #f8fafc; white-space: nowrap; }
    .at-table td { vertical-align: middle; }
    .at-price { display: inline-flex; align-items: center; gap: 6px; border: 1px solid #e2e8f0; border-radius: 999px; padding: 3px 4px 3px 10px; margin: 2px; font-size: 13px; background: #fff; }
    .at-price b { background: #eef4ff; color: #0b57d0; border-radius: 999px; padding: 1px 8px; }
    .at-price.none b { background: #fee2e2; color: #b91c1c; }
    .at-price.off { opacity: .55; text-decoration: line-through; }
    .at-acc-code { font-weight: 800; color: #0b57d0; }
    @@media print { .at-noprint { display: none !important; } .at-card { break-inside: avoid; } }
</style>

<div class="container py-4">
    <div class="at-hero mb-3 d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <h3 class="fw-bold mb-1"><i class="bi bi-wallet2 me-2"></i>@L["Revenue Account Tariffs"]</h3>
            <div style="opacity:.85">@L["Each revenue account with its tariffs and the tax amount per car type."]</div>
        </div>
        <div class="d-flex gap-2 at-noprint">
            <button type="button" class="btn btn-outline-light" onclick="window.print()"><i class="bi bi-printer"></i></button>
            <a class="btn btn-light fw-semibold" asp-page-handler="Export"
               asp-route-AccountId="@Model.AccountId" asp-route-Status="@Model.Status" asp-route-Search="@Model.Search">
                <i class="bi bi-file-earmark-spreadsheet me-1"></i>@L["Export CSV"]
            </a>
        </div>
    </div>

    <form method="get" class="at-card mb-3 at-noprint">
        <div class="p-3 row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label small fw-semibold mb-1">@L["Revenue Account"]</label>
                <select name="AccountId" class="form-select">
                    <option value="">@L["All accounts"]</option>
                    @foreach (var a in Model.AllAccounts)
                    {
                        <option value="@a.Id" selected="@(a.Id == Model.AccountId ? "selected" : null)">@a.DisplayName</option>
                    }
                    <option value="-1" selected="@(Model.AccountId == -1 ? "selected" : null)">@L["No revenue account"]</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold mb-1">@L["Status"]</label>
                <select name="Status" class="form-select">
                    <option value="active" selected="@(Model.Status == "active" ? "selected" : null)">@L["Active"]</option>
                    <option value="inactive" selected="@(Model.Status == "inactive" ? "selected" : null)">@L["Inactive"]</option>
                    <option value="all" selected="@(Model.Status == "all" ? "selected" : null)">@L["All"]</option>
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label small fw-semibold mb-1">@L["Search"]</label>
                <input name="Search" value="@Model.Search" class="form-control" placeholder="@L["Tariff or car type"]" />
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button class="btn btn-primary flex-grow-1"><i class="bi bi-funnel me-1"></i>@L["Filter"]</button>
                <a class="btn btn-outline-secondary" asp-page="/Reports/AccountTariffs" title="@L["Reset"]"><i class="bi bi-x-lg"></i></a>
            </div>
        </div>
    </form>

    <partial name="_ReportViewToggle" />

    @* ---------- SUMMARY ---------- *@
    <div data-report-view="summary">
        <div class="at-card">
            <div class="table-responsive">
                <table class="table at-table mb-0">
                    <thead>
                        <tr>
                            <th>@L["Revenue Account"]</th>
                            <th class="text-end">@L["Tariffs"]</th>
                            <th class="text-end">@L["Car types priced"]</th>
                            <th class="text-end">@L["Missing amount"]</th>
                            <th class="text-end">@L["Lowest"]</th>
                            <th class="text-end">@L["Highest"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var a in Model.Accounts)
                        {
                            <tr class="@(a.Id == null ? "table-warning" : "")">
                                <td>
                                    @if (a.Id == null)
                                    {
                                        <span class="fw-bold text-warning-emphasis"><i class="bi bi-exclamation-triangle me-1"></i>@L["No revenue account"]</span>
                                    }
                                    else
                                    {
                                        <span class="at-acc-code">@a.Code</span> <span class="fw-semibold">@a.Name</span>
                                    }
                                </td>
                                <td class="text-end fw-semibold">@a.Tariffs.Count</td>
                                <td class="text-end">@a.Priced / @a.Rows</td>
                                <td class="text-end @(a.Rows - a.Priced > 0 ? "text-danger fw-bold" : "")">@(a.Rows - a.Priced)</td>
                                <td class="text-end">@money(a.Min)</td>
                                <td class="text-end">@money(a.Max)</td>
                            </tr>
                        }
                        @if (!Model.Accounts.Any())
                        {
                            <tr><td colspan="6" class="text-center text-muted py-4">@L["No tariffs found"]</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @* ---------- DETAILS ---------- *@
    <div data-report-view="details">
        @foreach (var a in Model.Accounts)
        {
            <div class="at-card mb-3">
                <div class="head" style="@(a.Id == null ? "background:#fffbeb" : "")">
                    <div>
                        @if (a.Id == null)
                        {
                            <span class="fw-bold text-warning-emphasis"><i class="bi bi-exclamation-triangle me-1"></i>@L["No revenue account"]</span>
                            <div class="small text-muted">@L["Link these tariffs to an account in Data & Setup → Tariff."]</div>
                        }
                        else
                        {
                            <span class="at-acc-code fs-5">@a.Code</span> <span class="fw-bold fs-5">@a.Name</span>
                            @if (!a.IsActive) { <span class="badge bg-secondary ms-1">@L["Inactive"]</span> }
                        }
                    </div>
                    <div class="small text-muted">@a.Tariffs.Count @L["tariffs"] · @a.Rows @L["car types"]</div>
                </div>
                @if (a.Tariffs.Any())
                {
                    <div class="table-responsive">
                        <table class="table at-table mb-0">
                            <thead>
                                <tr>
                                    <th style="width:22%">@L["Tariff"]</th>
                                    <th>@L["Car Type"] · @L["Amount"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var t in a.Tariffs)
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-bold">@t.Name</div>
                                            @if (!t.AnyActive) { <span class="badge bg-secondary">@L["Inactive"]</span> }
                                            @if (t.Missing > 0) { <span class="badge bg-danger-subtle text-danger">@t.Missing @L["without amount"]</span> }
                                        </td>
                                        <td>
                                            @foreach (var p in t.Prices)
                                            {
                                                <span class="at-price @(p.Amount == null ? "none" : "") @(p.IsActive ? "" : "off")" title="System ID @p.MovementId">
                                                    @p.CarType <b>@(p.Amount == null ? L["no amount"].ToString() : money(p.Amount))</b>
                                                </span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="p-3 text-muted small">@L["No tariffs linked to this account."]</div>
                }
            </div>
        }
    </div>
</div>
