@page
@model VehicleTax.Web.Pages.Reports.IndexModel

<div class="module-page">
<div class="module-header mb-4">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div>
            <h3 class="mb-1 fw-bold">Reports</h3>
            <div class="sub">Review revenue, operations, and collector performance with filters.</div>
        </div>
    </div>
</div>

<form method="get" class="card module-filter-card p-3 mb-4">
    <div class="row g-3">

        <div class="col-md-3">
            <label class="form-label">From Date</label>
            <input type="date" asp-for="FromDate" class="form-control" />
        </div>

        <div class="col-md-3">
            <label class="form-label">To Date</label>
            <input type="date" asp-for="ToDate" class="form-control" />
        </div>

        <div class="col-md-3">
            <label class="form-label">Plate Number</label>
            <input asp-for="PlateNumber" class="form-control" />
        </div>

        <div class="col-md-3">
            <label class="form-label">Car Type</label>
            <select asp-for="CarTypeId"
                    asp-items="Model.CarTypes"
                    class="form-select">
                <option value="">All</option>
            </select>
        </div>

        <div class="col-md-3">
            <label class="form-label">Movement</label>
            <select asp-for="MovementId"
                    asp-items="Model.Movements"
                    class="form-select">
                <option value="">All</option>
            </select>
        </div>

        <div class="col-md-3">
            <label class="form-label">Collector</label>
            <select asp-for="CollectorId"
                    asp-items="Model.Collectors"
                    class="form-select">
                <option value="">All</option>
            </select>
        </div>

        <div class="col-md-6 d-flex align-items-end gap-2">
            <button class="btn btn-primary w-100 module-action-btn">Apply Filters</button>
            <a asp-page="./Index" class="btn btn-secondary w-100 module-action-btn">Reset</a>
        </div>
    </div>
</form>

<!-- EXPORT -->
<div class="d-flex justify-content-end mb-2">
    <a class="btn btn-success module-action-btn"
       asp-page-handler="ExportExcel"
       asp-route-FromDate="@Model.FromDate"
       asp-route-ToDate="@Model.ToDate"
       asp-route-PlateNumber="@Model.PlateNumber"
       asp-route-CarTypeId="@Model.CarTypeId"
       asp-route-MovementId="@Model.MovementId"
       asp-route-CollectorId="@Model.CollectorId">
        Export to Excel
    </a>
</div>

<!-- SUMMARY -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card module-kpi-card border-0 text-center">
            <div class="card-body">
                <div class="module-kpi-title">Total Vehicles</div>
                <h3 class="module-kpi-value text-primary">@Model.TotalVehicles</h3>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card module-kpi-card border-0 text-center">
            <div class="card-body">
                <div class="module-kpi-title">Total Payments</div>
                <h3 class="module-kpi-value text-warning">@Model.TotalPayments</h3>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card module-kpi-card border-0 text-center">
            <div class="card-body">
                <div class="module-kpi-title">Total Collected</div>
                <h3 class="module-kpi-value text-success">@Model.TotalAmount.ToString("N0")</h3>
            </div>
        </div>
    </div>
</div>

<!-- INFOGRAPHIC REPORTS -->
<div class="row g-3 mb-4">
    <div class="col-lg-6">
        <div class="card module-panel-card h-100">
            <div class="card-body">
                <h5 class="fw-bold mb-3">
                    <i class="bi bi-diagram-3"></i> Top Movements
                </h5>
                @if (Model.MovementSummaries.Any())
                {
                    var maxMovementAmount = Model.MovementSummaries.Max(x => x.TotalAmount);
                    foreach (var m in Model.MovementSummaries)
                    {
                        var pct = maxMovementAmount > 0 ? (m.TotalAmount / maxMovementAmount) * 100 : 0;
                        <div class="mb-3">
                            <div class="d-flex justify-content-between small mb-1">
                                <span class="fw-semibold">@m.MovementName (@m.Count)</span>
                                <span>@m.TotalAmount.ToString("N0")</span>
                            </div>
                            <div class="progress" role="progressbar" aria-label="Movement amount">
                                <div class="progress-bar bg-primary" style="width:@pct.ToString("0.#")%"></div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p class="text-muted mb-0">No movement data for selected filters.</p>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card module-panel-card h-100">
            <div class="card-body">
                <h5 class="fw-bold mb-3">
                    <i class="bi bi-truck"></i> Top Car Types
                </h5>
                @if (Model.CarTypeSummaries.Any())
                {
                    var maxCarTypeAmount = Model.CarTypeSummaries.Max(x => x.TotalAmount);
                    foreach (var c in Model.CarTypeSummaries)
                    {
                        var pct = maxCarTypeAmount > 0 ? (c.TotalAmount / maxCarTypeAmount) * 100 : 0;
                        <div class="mb-3">
                            <div class="d-flex justify-content-between small mb-1">
                                <span class="fw-semibold">@c.CarTypeName (@c.Count)</span>
                                <span>@c.TotalAmount.ToString("N0")</span>
                            </div>
                            <div class="progress" role="progressbar" aria-label="Car type amount">
                                <div class="progress-bar bg-success" style="width:@pct.ToString("0.#")%"></div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p class="text-muted mb-0">No car type data for selected filters.</p>
                }
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-lg-6">
        <div class="card module-panel-card h-100">
            <div class="card-body">
                <h5 class="fw-bold mb-3">
                    <i class="bi bi-people"></i> Collector Performance
                </h5>
                @if (Model.CollectorSummaries.Any())
                {
                    var maxCollectorAmount = Model.CollectorSummaries.Max(x => x.TotalAmount);
                    foreach (var c in Model.CollectorSummaries.Take(5))
                    {
                        var pct = maxCollectorAmount > 0 ? (c.TotalAmount / maxCollectorAmount) * 100 : 0;
                        <div class="mb-3">
                            <div class="d-flex justify-content-between small mb-1">
                                <span class="fw-semibold">@c.CollectorName (@c.TotalPayments)</span>
                                <span>@c.TotalAmount.ToString("N0")</span>
                            </div>
                            <div class="progress" role="progressbar" aria-label="Collector amount">
                                <div class="progress-bar bg-warning" style="width:@pct.ToString("0.#")%"></div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p class="text-muted mb-0">No collector data for selected filters.</p>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card module-panel-card h-100">
            <div class="card-body">
                <h5 class="fw-bold mb-3">
                    <i class="bi bi-graph-up-arrow"></i> Daily Collection (Last 7 Days)
                </h5>
                @if (Model.DailySummaries.Any())
                {
                    var maxDailyAmount = Model.DailySummaries.Max(x => x.TotalAmount);
                    foreach (var d in Model.DailySummaries)
                    {
                        var pct = maxDailyAmount > 0 ? (d.TotalAmount / maxDailyAmount) * 100 : 0;
                        <div class="mb-3">
                            <div class="d-flex justify-content-between small mb-1">
                                <span class="fw-semibold">@d.Date.ToString("dd MMM")</span>
                                <span>@d.TotalAmount.ToString("N0")</span>
                            </div>
                            <div class="progress" role="progressbar" aria-label="Daily collection">
                                <div class="progress-bar bg-info" style="width:@pct.ToString("0.#")%"></div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p class="text-muted mb-0">No daily collection data available.</p>
                }
            </div>
        </div>
    </div>
</div>

<!-- PAGE SIZE (EXTEND ONLY) -->
<form method="get" class="d-flex justify-content-between align-items-center mb-2">

    <input type="hidden" name="FromDate" value="@Model.FromDate" />
    <input type="hidden" name="ToDate" value="@Model.ToDate" />
    <input type="hidden" name="PlateNumber" value="@Model.PlateNumber" />
    <input type="hidden" name="CarTypeId" value="@Model.CarTypeId" />
    <input type="hidden" name="MovementId" value="@Model.MovementId" />
    <input type="hidden" name="CollectorId" value="@Model.CollectorId" />

    <div class="d-flex align-items-center gap-2">
        <label class="fw-bold">Show</label>

        <select name="PageSize"
                class="form-select form-select-sm w-auto"
                onchange="this.form.submit()">

            @if (Model.PageSize == 10)
            { <option value="10" selected>10</option> }
            else
            { <option value="10">10</option> }

            @if (Model.PageSize == 20)
            { <option value="20" selected>20</option> }
            else
            { <option value="20">20</option> }

            @if (Model.PageSize == 50)
            { <option value="50" selected>50</option> }
            else
            { <option value="50">50</option> }

            @if (Model.PageSize == 100)
            { <option value="100" selected>100</option> }
            else
            { <option value="100">100</option> }

            @if (Model.PageSize == 200)
            { <option value="200" selected>200</option> }
            else
            { <option value="200">200</option> }

            @if (Model.PageSize == -1)
            { <option value="-1" selected>All</option> }
            else
            { <option value="-1">All</option> }

        </select>
    </div>
</form>

<!-- PAYMENTS TABLE (UNCHANGED) -->
<div class="card module-table-card">
    <div class="card-body p-0">
        <table class="table table-bordered table-striped table-hover mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Date</th>
                    <th>Plate</th>
                    <th>Owner</th>
                    <th>Mobile</th>
                    <th>Car Type</th>
                    <th>Movement</th>
                    <th>Collector</th>
                    <th>Receipt No</th>
                    <th class="text-end">Amount</th>
                </tr>
            </thead>
            <tbody>
            @if (Model.Payments.Any())
            {
                foreach (var p in Model.Payments)
                {
                    <tr>
                        <td>@p.PaidAt.ToString("yyyy-MM-dd")</td>
                        <td>@p.Vehicle?.PlateNumber</td>
                        <td>@p.Vehicle?.OwnerName</td>
                        <td>@p.Vehicle?.Mobile</td>
                        <td>@p.Vehicle?.CarType?.Name</td>
                        <td>@(p.Movement?.Name ?? p.MovementType)</td>
                        <td>@(p.Collector?.Username ?? p.ReceiptReference?.UsedBy ?? "Unassigned")</td>
                        <td>@p.InvoiceNumber</td>
                        <td class="text-end">@p.Amount.ToString("N0")</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="9" class="text-center text-muted">No payments found</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

<!-- PAGINATION (ADDED ONLY) -->
@if (Model.TotalPages > 1 && Model.PageSize != -1)
{
    <nav class="mt-3">
        <ul class="pagination justify-content-center">

            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                    <a class="page-link"
                       asp-page="./Index"
                       asp-route-CurrentPage="@i"
                       asp-route-PageSize="@Model.PageSize"
                       asp-route-FromDate="@Model.FromDate"
                       asp-route-ToDate="@Model.ToDate"
                       asp-route-PlateNumber="@Model.PlateNumber"
                       asp-route-CarTypeId="@Model.CarTypeId"
                       asp-route-MovementId="@Model.MovementId"
                       asp-route-CollectorId="@Model.CollectorId">
                        @i
                    </a>
                </li>
            }

        </ul>
    </nav>
}

</div>
