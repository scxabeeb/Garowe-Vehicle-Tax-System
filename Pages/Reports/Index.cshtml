@page
@model VehicleTax.Web.Pages.Reports.IndexModel
@{ ViewData["Title"] = L["Collections Dashboard"]; }

<div class="module-page">
<div class="module-header mb-4">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div>
            <h3 class="mb-1 fw-bold">@L["Reports"]</h3>
            <div class="sub">@L["Review revenue, operations, and collector performance with filters."]</div>
        </div>
    </div>
</div>

<form method="get" class="card module-filter-card p-3 mb-4">
    <div class="row g-3">

        <div class="col-md-3">
            <label class="form-label">@L["From Date"]</label>
            <input type="date" asp-for="FromDate" class="form-control" />
        </div>

        <div class="col-md-3">
            <label class="form-label">@L["To Date"]</label>
            <input type="date" asp-for="ToDate" class="form-control" />
        </div>

        <div class="col-md-3">
            <label class="form-label">@L["Plate Number"]</label>
            <input asp-for="PlateNumber" class="form-control" />
        </div>

        <div class="col-md-3">
            <label class="form-label">@L["Car Type"]</label>
            <select asp-for="CarTypeId"
                    asp-items="Model.CarTypes"
                    class="form-select">
                <option value="">@L["All"]</option>
            </select>
        </div>

        <div class="col-md-3">
            <label class="form-label">@L["Tariff"]</label>
            <select asp-for="MovementId"
                    asp-items="Model.Movements"
                    class="form-select">
                <option value="">@L["All"]</option>
            </select>
        </div>

        <div class="col-md-3">
            <label class="form-label">@L["Revenue Account"]</label>
            <select asp-for="RevenueAccountId"
                    asp-items="Model.RevenueAccounts"
                    class="form-select">
                <option value="">@L["All Revenue Accounts"]</option>
            </select>
        </div>

        <div class="col-md-3">
            <label class="form-label">@L["Golis Bill No"]</label>
            <input type="text" asp-for="GolisBillNo" class="form-control" placeholder="@L["Search by bill no..."]" />
        </div>

        <div class="col-md-3">
            <label class="form-label">@L["Collector"]</label>
            <select asp-for="CollectorId"
                    asp-items="Model.Collectors"
                    class="form-select">
                <option value="">@L["All"]</option>
            </select>
        </div>

        <div class="col-md-3">
            <label class="form-label">@L["Checkpoint"]</label>
            <select asp-for="CheckpointId"
                    asp-items="Model.Checkpoints"
                    class="form-select">
                <option value="">@L["All"]</option>
            </select>
        </div>

        <div class="col-md-6 d-flex align-items-end gap-2">
            <button class="btn btn-primary w-100 module-action-btn">@L["Apply Filters"]</button>
            <a asp-page="./Index" class="btn btn-secondary w-100 module-action-btn">@L["Reset"]</a>
        </div>
    </div>
</form>

<!-- EXPORT / PRINT -->
<div class="d-flex justify-content-end flex-wrap gap-2 mb-2 d-print-none">
    <button type="button" class="btn btn-outline-primary module-action-btn" onclick="printPayments(true)">
        <i class="bi bi-printer me-1"></i>@L["Print / PDF – filtered"]
    </button>
    <button type="button" class="btn btn-outline-secondary module-action-btn" onclick="printPayments(false)">
        <i class="bi bi-printer me-1"></i>@L["Print / PDF – all payments"]
    </button>
    <script>
        // Opens every matching payment (all pages) ready to print or save as PDF.
        function printPayments(filtered) {
            var u = new URL(location.href);
            if (!filtered) u.search = '';
            ['handler', 'CurrentPage'].forEach(function (k) { u.searchParams.delete(k); });
            u.searchParams.set('PageSize', '0');
            u.searchParams.set('view', 'details');
            u.searchParams.set('print', '1');
            window.open(u.pathname + u.search, '_blank');
        }
    </script>
    <a class="btn btn-success module-action-btn"
       asp-page-handler="ExportExcel"
       asp-route-FromDate="@Model.FromDate"
       asp-route-ToDate="@Model.ToDate"
       asp-route-PlateNumber="@Model.PlateNumber"
       asp-route-CarTypeId="@Model.CarTypeId"
       asp-route-MovementId="@Model.MovementId"
                       asp-route-RevenueAccountId="@Model.RevenueAccountId"
                       asp-route-CollectorId="@Model.CollectorId"
                       asp-route-CheckpointId="@Model.CheckpointId"
                       asp-route-GolisBillNo="@Model.GolisBillNo">
        @L["Export to Excel"]
    </a>
</div>

@{ ViewData["DetailCount"] = Model.TotalPayments; }
<partial name="_ReportViewToggle" />

<div data-report-view="summary">
<!-- SUMMARY -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card module-kpi-card border-0 text-center">
            <div class="card-body">
                <div class="module-kpi-title">@L["Total Vehicles"]</div>
                <h3 class="module-kpi-value text-primary">@Model.TotalVehicles</h3>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card module-kpi-card border-0 text-center">
            <div class="card-body">
                <div class="module-kpi-title">@L["Total Payments"]</div>
                <h3 class="module-kpi-value text-warning">@Model.TotalPayments</h3>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card module-kpi-card border-0 text-center">
            <div class="card-body">
                <div class="module-kpi-title">@L["Total Collected"]</div>
                <h3 class="module-kpi-value text-success">$@Model.TotalAmount.ToString("N0")</h3>
                <div class="module-kpi-sub">@L["Revenue Account Collections"]</div>
            </div>
        </div>
    </div>
</div>

<!-- REVENUE ACCOUNT SUMMARY -->
<div class="row g-3 mb-4">
    <div class="col-lg-12">
        <div class="card module-panel-card h-100">
            <div class="card-body">
                <h5 class="fw-bold mb-3">
                    <i class="bi bi-wallet2"></i> @L["Collections by Revenue Account"]
                </h5>
                @if (Model.RevenueAccountSummaries.Any())
                {
                    var maxAccountAmount = Model.RevenueAccountSummaries.Max(x => x.TotalAmount);
                    foreach (var ra in Model.RevenueAccountSummaries)
                    {
                        var pct = maxAccountAmount > 0 ? (ra.TotalAmount / maxAccountAmount) * 100 : 0;
                        <div class="mb-3">
                            <div class="d-flex justify-content-between small mb-1">
                                <span class="fw-semibold">@($"{ra.AccountCode} - {ra.AccountName}") (@ra.TotalPayments)</span>
                                <span>$@ra.TotalAmount.ToString("N0")</span>
                            </div>
                            <div class="progress" role="progressbar" aria-label="@L["Revenue account amount"]">
                                <div class="progress-bar bg-info" style="width:@pct.ToString("0.#")%"></div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p class="text-muted mb-0">@L["No revenue account data for selected filters."]</p>
                }
            </div>
        </div>
    </div>
</div>

<!-- INFOGRAPHIC REPORTS -->
<div class="row g-3 mb-4">
    <div class="col-lg-6">
        <div class="card module-panel-card h-100">
            <div class="card-body">
                <h5 class="fw-bold mb-3">
                    <i class="bi bi-diagram-3"></i> @L["Top Tariff"]
                </h5>
                @if (Model.MovementSummaries.Any())
                {
                    var maxMovementAmount = Model.MovementSummaries.Max(x => x.TotalAmount);
                    foreach (var m in Model.MovementSummaries)
                    {
                        var pct = maxMovementAmount > 0 ? (m.TotalAmount / maxMovementAmount) * 100 : 0;
                        <div class="mb-3">
                            <div class="d-flex justify-content-between small mb-1">
                                <span class="fw-semibold">@m.MovementName (@m.Count)</span>
                                <span>$@m.TotalAmount.ToString("N0")</span>
                            </div>
                            <div class="progress" role="progressbar" aria-label="@L["Tariff amount"]">
                                <div class="progress-bar bg-primary" style="width:@pct.ToString("0.#")%"></div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p class="text-muted mb-0">@L["No tariff data for selected filters."]</p>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card module-panel-card h-100">
            <div class="card-body">
                <h5 class="fw-bold mb-3">
                    <i class="bi bi-truck"></i> @L["Top Car Types"]
                </h5>
                @if (Model.CarTypeSummaries.Any())
                {
                    var maxCarTypeAmount = Model.CarTypeSummaries.Max(x => x.TotalAmount);
                    foreach (var c in Model.CarTypeSummaries)
                    {
                        var pct = maxCarTypeAmount > 0 ? (c.TotalAmount / maxCarTypeAmount) * 100 : 0;
                        <div class="mb-3">
                            <div class="d-flex justify-content-between small mb-1">
                                <span class="fw-semibold">@c.CarTypeName (@c.Count)</span>
                                <span>$@c.TotalAmount.ToString("N0")</span>
                            </div>
                            <div class="progress" role="progressbar" aria-label="@L["Car type amount"]">
                                <div class="progress-bar bg-success" style="width:@pct.ToString("0.#")%"></div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p class="text-muted mb-0">@L["No car type data for selected filters."]</p>
                }
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-lg-4">
        <div class="card module-panel-card h-100">
            <div class="card-body">
                <h5 class="fw-bold mb-3">
                    <i class="bi bi-people"></i> @L["Collector Performance"]
                </h5>
                @if (Model.CollectorSummaries.Any())
                {
                    var maxCollectorAmount = Model.CollectorSummaries.Max(x => x.TotalAmount);
                    foreach (var c in Model.CollectorSummaries.Take(5))
                    {
                        var pct = maxCollectorAmount > 0 ? (c.TotalAmount / maxCollectorAmount) * 100 : 0;
                        <div class="mb-3">
                            <div class="d-flex justify-content-between small mb-1">
                                <span class="fw-semibold">@c.CollectorName (@c.TotalPayments)</span>
                                <span>$@c.TotalAmount.ToString("N0")</span>
                            </div>
                            <div class="progress" role="progressbar" aria-label="@L["Collector amount"]">
                                <div class="progress-bar bg-warning" style="width:@pct.ToString("0.#")%"></div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p class="text-muted mb-0">@L["No collector data for selected filters."]</p>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card module-panel-card h-100">
            <div class="card-body">
                <h5 class="fw-bold mb-3">
                    <i class="bi bi-geo-alt"></i> @L["Checkpoint Performance"]
                </h5>
                @if (Model.CheckpointSummaries.Any())
                {
                    var maxCheckpointAmount = Model.CheckpointSummaries.Max(x => x.TotalAmount);
                    foreach (var c in Model.CheckpointSummaries.Take(5))
                    {
                        var pct = maxCheckpointAmount > 0 ? (c.TotalAmount / maxCheckpointAmount) * 100 : 0;
                        <div class="mb-3">
                            <div class="d-flex justify-content-between small mb-1">
                                <span class="fw-semibold">@c.CheckpointName (@c.TotalPayments)</span>
                                <span>$@c.TotalAmount.ToString("N0")</span>
                            </div>
                            <div class="progress" role="progressbar" aria-label="@L["Checkpoint amount"]">
                                <div class="progress-bar bg-secondary" style="width:@pct.ToString("0.#")%"></div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p class="text-muted mb-0">@L["No checkpoint data for selected filters."]</p>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card module-panel-card h-100">
            <div class="card-body">
                <h5 class="fw-bold mb-3">
                    <i class="bi bi-graph-up-arrow"></i> Daily Collection (Last 7 Days)
                </h5>
                @if (Model.DailySummaries.Any())
                {
                    var maxDailyAmount = Model.DailySummaries.Max(x => x.TotalAmount);
                    foreach (var d in Model.DailySummaries)
                    {
                        var pct = maxDailyAmount > 0 ? (d.TotalAmount / maxDailyAmount) * 100 : 0;
                        <div class="mb-3">
                            <div class="d-flex justify-content-between small mb-1">
                                <span class="fw-semibold">@d.Date.ToString("dd MMM")</span>
                                <span>$@d.TotalAmount.ToString("N0")</span>
                            </div>
                            <div class="progress" role="progressbar" aria-label="@L["Daily collection"]">
                                <div class="progress-bar bg-info" style="width:@pct.ToString("0.#")%"></div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p class="text-muted mb-0">@L["No daily collection data available."]</p>
                }
            </div>
        </div>
    </div>
</div>

</div>

<div data-report-view="details">
<!-- PAGE SIZE (EXTEND ONLY) -->
<form method="get" class="d-flex justify-content-between align-items-center mb-2">

    <input type="hidden" name="FromDate" value="@Model.FromDate" />
    <input type="hidden" name="ToDate" value="@Model.ToDate" />
    <input type="hidden" name="PlateNumber" value="@Model.PlateNumber" />
    <input type="hidden" name="CarTypeId" value="@Model.CarTypeId" />
    <input type="hidden" name="MovementId" value="@Model.MovementId" />
    <input type="hidden" name="RevenueAccountId" value="@Model.RevenueAccountId" />
    <input type="hidden" name="CollectorId" value="@Model.CollectorId" />
    <input type="hidden" name="CheckpointId" value="@Model.CheckpointId" />
    <input type="hidden" name="GolisBillNo" value="@Model.GolisBillNo" />

    <input type="hidden" name="PageSize" value="@Model.Pager.PageSize" />
</form>

<!-- PAYMENTS TABLE -->
<div class="card module-table-card">
    <div class="card-body p-0">
        <table class="table table-bordered table-striped table-hover mb-0">
            <thead class="table-dark">
                <tr>
                    <th>@L["System ID"]</th>
                    <th>@L["Date"]</th>
                    <th>@L["Plate"]</th>
                    <th>@L["Owner"]</th>
                    <th>@L["Mobile"]</th>
                    <th>@L["Car Type"]</th>
                    <th>@L["Tariff"]</th>
                    <th>@L["Revenue Account"]</th>
                    <th>@L["Collector"]</th>
                    <th>@L["Checkpoint"]</th>
                    <th>@L["Receipt No"]</th>
                    <th>@L["Golis Bill No"]</th>
                    <th class="text-end">@L["Amount"]</th>
                </tr>
            </thead>
            <tbody>
            @if (Model.Payments.Any())
            {
                foreach (var p in Model.Payments)
                {
                    <tr>
                        <td class="fw-semibold">@p.Id</td>
                        <td class="text-nowrap">@VehicleTax.Web.AppTime.ToLocal(p.PaidAt).ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@p.Vehicle?.PlateNumber</td>
                        <td>@p.Vehicle?.OwnerName</td>
                        <td>@p.Vehicle?.Mobile</td>
                        <td>@p.Vehicle?.CarType?.Name</td>
                        <td>@(p.Movement?.Name ?? p.MovementType)</td>
                        <td>@(p.Movement?.RevenueAccount != null ? $"{p.Movement.RevenueAccount.AccountCode} - {p.Movement.RevenueAccount.AccountName}" : "-")</td>
                        <td>@(p.Collector?.Username ?? p.ReceiptReference?.UsedBy ?? "Unassigned")</td>
                        <td>@(p.Checkpoint?.Name ?? "Unassigned")</td>
                        <td>@p.InvoiceNumber</td>
                        <td>@(string.IsNullOrWhiteSpace(p.TransactionId) ? "-" : p.TransactionId)</td>
                        <td class="text-end">$@p.Amount.ToString("N0")</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="13" class="text-center text-muted">@L["No payments found"]</td>
                </tr>
            }
            </tbody>
            @if (Model.Payments.Any())
            {
                <tfoot class="table-light">
                    <tr>
                        <td colspan="11" class="fw-bold text-end">@L["TOTAL"]</td>
                        <td class="fw-bold text-center">@Model.TotalPayments</td>
                        <td class="text-end fw-bold">$@Model.TotalAmount.ToString("N0")</td>
                    </tr>
                </tfoot>
            }
        </table>
    </div>
</div>

<!-- PAGINATION -->
<partial name="_Pager" model="Model.Pager" />
</div>

</div>
