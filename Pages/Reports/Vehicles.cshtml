@page
@model VehicleTax.Web.Pages.Reports.VehiclesModel
@{
    ViewData["Title"] = L["Vehicle Report"];
}

<h3 class="fw-bold mb-4">@L["Vehicle Report"]</h3>

<form method="get" class="card p-3 shadow-sm mb-4">
    <div class="row g-3">

        <div class="col-md-2">
            <label class="form-label">@L["Plate Number"]</label>
            <input asp-for="PlateNumber" class="form-control" />
        </div>

        <div class="col-md-2">
            <label class="form-label">@L["Owner Name"]</label>
            <input asp-for="OwnerName" class="form-control" />
        </div>

        <div class="col-md-2">
            <label class="form-label">@L["Mobile"]</label>
            <input asp-for="Mobile" class="form-control" />
        </div>

        <div class="col-md-2">
            <label class="form-label">@L["Car Type"]</label>
            <select asp-for="CarTypeId" asp-items="Model.CarTypes" class="form-select">
                <option value="">@L["All"]</option>
            </select>
        </div>

        <input type="hidden" name="PageSize" value="@Model.Pager.PageSize" />

        <div class="col-md-1 d-flex align-items-end">
            <button class="btn btn-primary w-100">@L["Filter"]</button>
        </div>

        <div class="col-md-1 d-flex align-items-end">
            <a asp-page-handler="ExportCsv"
               asp-route-plateNumber="@Model.PlateNumber"
               asp-route-ownerName="@Model.OwnerName"
               asp-route-mobile="@Model.Mobile"
               asp-route-carTypeId="@Model.CarTypeId"
               class="btn btn-success w-100">
                CSV
            </a>
        </div>

    </div>
</form>

@{ ViewData["DetailCount"] = Model.TotalRecords; }
<partial name="_ReportViewToggle" />

<div data-report-view="summary">
<div class="row mb-3">
    <div class="col-md-4">
        <div class="card text-center shadow-sm">
            <div class="card-body">
                <h6>@L["Total Vehicles"]</h6>
                <h4>@Model.TotalRecords</h4>
            </div>
        </div>
    </div>
</div>

<partial name="_CountGroups" model="Model.SummaryGroups" />
</div>

<div data-report-view="details">
<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>@L["System ID"]</th>
            <th>@L["Plate"]</th>
            <th>@L["Owner"]</th>
            <th>@L["Mobile"]</th>
            <th>@L["Car Type"]</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Vehicles.Any())
        {
            <tr>
                <td colspan="5" class="text-center text-muted">
                    @L["No vehicles found for the selected filters."]
                </td>
            </tr>
        }
        else
        {
            foreach (var v in Model.Vehicles)
            {
                <tr>
                    <td class="fw-semibold">@v.Id</td>
                    <td>@v.PlateNumber</td>
                    <td>@v.OwnerName</td>
                    <td>@v.Mobile</td>
                    <td>@v.CarType?.Name</td>
                </tr>
            }
        }
    </tbody>
</table>

<partial name="_Pager" model="Model.Pager" />
</div>
