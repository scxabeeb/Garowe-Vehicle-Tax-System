@page
@model VehicleTax.Web.Pages.Reports.CheckpointReportModel

<div class="container mt-4">

    <div class="report-banner">
        <div class="d-flex align-items-center gap-3">
            <div style="width: 58px; height: 58px; border-radius: 50%; background: linear-gradient(145deg, #1f4ed3 0%, #0f2b73 100%); display: flex; align-items: center; justify-content: center;">
                <i class="bi bi-shield-check fs-4 text-white"></i>
            </div>
            <div>
                <div class="fw-bold" style="font-size:1.05rem;">@L["Garowe Local Government"]</div>
                <div class="text-muted">@L["Checkpoint Collection Report"]</div>
            </div>
        </div>
        <div class="text-muted small d-none d-md-block">
            @VehicleTax.Web.AppTime.Now.ToString("dd MMM yyyy")
        </div>
    </div>

    <!-- FILTERS -->
    <form method="get" class="card shadow-sm border-0 mb-3">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">@L["From Date"]</label>
                    <input type="date" asp-for="FromDate" class="form-control" />
                </div>

                <div class="col-md-3">
                    <label class="form-label">@L["To Date"]</label>
                    <input type="date" asp-for="ToDate" class="form-control" />
                </div>

                <div class="col-md-3">
                    <label class="form-label">@L["Checkpoint"]</label>
                    <select asp-for="CheckpointId"
                            asp-items="Model.CheckpointList"
                            class="form-select">
                        <option value="">@L["All Checkpoints"]</option>
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="form-label">@L["Golis Bill No"]</label>
                    <input type="text" asp-for="GolisBillNo" class="form-control"
                           placeholder="@L["Search by bill no..."]" />
                </div>

                <div class="col-md-3 d-flex align-items-end gap-2">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-search"></i> @L["Apply Filters"]
                    </button>
                    <a asp-page="/Reports/CheckpointReport" class="btn btn-secondary w-100">
                        <i class="bi bi-arrow-counterclockwise"></i> @L["Reset"]
                    </a>
                </div>
            </div>
        </div>
    </form>

    @{ ViewData["DetailCount"] = Model.TotalPayments; }
    <partial name="_ReportViewToggle" />

    <div data-report-view="summary">
    <!-- SUMMARY CARDS -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card shadow-sm border-0 text-center h-100">
                <div class="card-body">
                    <div class="text-muted small fw-semibold">@L["Checkpoints"]</div>
                    <h3 class="fw-bold mb-0 text-primary">@Model.TotalCheckpoints</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 text-center h-100">
                <div class="card-body">
                    <div class="text-muted small fw-semibold">@L["Total Payments"]</div>
                    <h3 class="fw-bold mb-0 text-warning">@Model.TotalPayments</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 text-center h-100">
                <div class="card-body">
                    <div class="text-muted small fw-semibold">@L["Total Collected"]</div>
                    <h3 class="fw-bold mb-0 text-success">$@Model.TotalAmount.ToString("N0")</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 text-center h-100">
                <div class="card-body">
                    <div class="text-muted small fw-semibold">@L["Avg / Payment"]</div>
                    <h3 class="fw-bold mb-0 text-info">$@(Model.TotalPayments > 0 ? (Model.TotalAmount / Model.TotalPayments).ToString("N0") : "0")</h3>
                </div>
            </div>
        </div>
    </div>

    <!-- CHECKPOINTS: one clean bar per checkpoint; click to see its payments -->
    <style>
        .cp-row { display: grid; grid-template-columns: 28px minmax(140px, 1.2fr) 3fr auto; gap: 12px; align-items: center;
            padding: 12px 14px; border-top: 1px solid #f1f5f9; color: inherit; text-decoration: none; transition: background .15s; }
        .cp-row:hover { background: #f8fbff; color: inherit; }
        .cp-row:first-child { border-top: none; }
        .cp-rank { width: 28px; height: 28px; border-radius: 8px; display: grid; place-items: center; background: #eef4ff; color: #0b57d0; font-weight: 800; font-size: 13px; }
        .cp-bar { height: 10px; border-radius: 999px; background: #eef2f7; overflow: hidden; }
        .cp-bar > span { display: block; height: 100%; border-radius: 999px; background: #0b57d0; }
        .cp-meta { font-size: 12px; color: #64748b; }
        .cp-amt { font-weight: 800; font-size: 1.05rem; text-align: right; white-space: nowrap; }
        @@media (max-width: 640px) { .cp-row { grid-template-columns: 28px 1fr auto; } .cp-row .cp-barcell { grid-column: 2 / 4; } }
    </style>
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-0">
            <div class="d-flex justify-content-between align-items-center px-3 pt-3 pb-2">
                <h6 class="fw-bold mb-0"><i class="bi bi-geo-alt me-1"></i>@L["Checkpoints"]</h6>
                <span class="small text-muted">@L["Click a checkpoint to see its payments."]</span>
            </div>
            @if (!Model.CheckpointSummaries.Any())
            {
                <div class="text-center text-muted py-4">@L["No checkpoint data for selected filters."]</div>
            }
            @for (int i = 0; i < Model.CheckpointSummaries.Count; i++)
            {
                var cs = Model.CheckpointSummaries[i];
                var avg = cs.TotalPayments > 0 ? cs.TotalAmount / cs.TotalPayments : 0m;
                var share = Model.TotalAmount > 0 ? cs.TotalAmount / Model.TotalAmount * 100 : 0m;
                <a class="cp-row" data-view-fixed asp-page="/Reports/CheckpointReport"
                   asp-route-CheckpointId="@(cs.Id > 0 ? cs.Id : null)"
                   asp-route-FromDate="@Model.FromDate?.ToString("yyyy-MM-dd")" asp-route-ToDate="@Model.ToDate?.ToString("yyyy-MM-dd")"
                   asp-route-GolisBillNo="@Model.GolisBillNo" asp-route-view="details">
                    <span class="cp-rank">@(i + 1)</span>
                    <div>
                        <div class="fw-bold">@cs.Name</div>
                        <div class="cp-meta">@cs.TotalPayments @L["payments"] · @L["Avg"] $@avg.ToString("N0")</div>
                    </div>
                    <div class="cp-barcell">
                        <div class="cp-bar"><span style="width:@share.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)%"></span></div>
                        <div class="cp-meta mt-1">@share.ToString("0.0")% @L["of total"]</div>
                    </div>
                    <div class="cp-amt">$@cs.TotalAmount.ToString("N0") <i class="bi bi-chevron-right text-muted small"></i></div>
                </a>
            }
        </div>
    </div>

    <partial name="_PaymentSummaryBreakdown" model="Model.Breakdown" />
    </div>

    <div data-report-view="details">
    <!-- DETAILED PAYMENTS TABLE -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <h6 class="fw-bold mb-0">@L["Detailed Payments"]</h6>
                    @if (Model.CheckpointId.HasValue)
                    {
                        var cpName = Model.CheckpointSummaries.FirstOrDefault(c => c.Id == Model.CheckpointId)?.Name;
                        <a class="badge rounded-pill bg-primary-subtle text-primary text-decoration-none" title="@L["Show all checkpoints"]"
                           asp-page="/Reports/CheckpointReport" asp-route-FromDate="@Model.FromDate?.ToString("yyyy-MM-dd")" asp-route-ToDate="@Model.ToDate?.ToString("yyyy-MM-dd")"
                           asp-route-GolisBillNo="@Model.GolisBillNo" asp-route-view="details">
                            <i class="bi bi-geo-alt"></i> @(cpName ?? L["Checkpoint"]) <i class="bi bi-x"></i>
                        </a>
                    }
                </div>
                <a asp-page-handler="ExportCsv"
                   asp-route-FromDate="@Model.FromDate?.ToString("yyyy-MM-dd")"
                   asp-route-ToDate="@Model.ToDate?.ToString("yyyy-MM-dd")"
                   asp-route-CheckpointId="@Model.CheckpointId"
                   asp-route-GolisBillNo="@Model.GolisBillNo"
                   class="btn btn-success btn-sm">
                     <i class="bi bi-file-earmark-download"></i> @L["Export to CSV"]
                </a>
            </div>

            

            <div class="table-responsive">
                <table class="table table-bordered table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>@L["System ID"]</th>
                            <th>@L["Ref No."]</th>
                            <th>@L["Date"]</th>
                            <th>@L["Plate"]</th>
                            <th>@L["Owner"]</th>
                            <th>@L["Tariff"]</th>
                            <th>@L["Collector"]</th>
                            <th>@L["Checkpoint"]</th>
                            <th>@L["Payment Method"]</th>
                            <th>@L["Receipt No"]</th>
                            <th>@L["Golis Bill No"]</th>
                            <th class="text-end">@L["Amount"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.Payments)
                        {
                            <tr class="@(p.IsReverted ? "table-danger" : "")">
                                <td class="fw-semibold">@p.Id</td>
                                <td>@(p.ReferenceNo?.ToString() ?? "-")</td>
                                <td>@VehicleTax.Web.AppTime.ToLocal(p.PaidAt).ToString("dd MMM yyyy HH:mm")</td>
                                <td>@p.Vehicle?.PlateNumber</td>
                                <td>@p.Vehicle?.OwnerName</td>
                                <td>@(p.Movement?.Name ?? p.MovementType)</td>
                                <td>@(p.Collector?.Username ?? p.ReceiptReference?.UsedBy ?? "Unassigned")</td>
                                <td><span class="badge bg-secondary">@(p.Checkpoint?.Name ?? "Unassigned")</span></td>
                                <td>@(string.IsNullOrWhiteSpace(p.PaymentMethod) ? "-" : p.PaymentMethod)</td>
                                <td class="text-nowrap">
                                    <a asp-page="/Payments/Receipt" asp-route-paymentId="@p.Id" class="text-decoration-none fw-semibold" target="_blank">@p.InvoiceNumber</a>
                                </td>
                                <td>@(string.IsNullOrWhiteSpace(p.TransactionId) ? "-" : p.TransactionId)</td>
                                <td class="text-end fw-bold">$@p.Amount.ToString("N0")</td>
                            </tr>
                        }
                        @if (!Model.Payments.Any())
                        {
                            <tr>
                                <td colspan="12" class="text-center text-muted">@L["No payments found for the selected filters."]</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            <partial name="_Pager" model="Model.Pager" />
        </div>
    </div>
    </div>
</div>

