@page
@model VehicleTax.Web.Pages.Reports.UsersReportModel

<h3 class="mb-3">
    <i class="bi bi-people-fill text-primary"></i> @L["Users Report"]
</h3>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-4">
        <input type="text" name="Search" value="@Model.Search"
               class="form-control"
               placeholder="@L["Search username, name, phone, role or permission..."]" />
    </div>

    <div class="col-md-3">
        <select name="Role" class="form-select">
            <option value="">@L["All Roles"]</option>
            <option value="Admin" selected="@(Model.Role == "Admin" ? "selected" : null)">@L["Admin"]</option>
            <option value="Collector" selected="@(Model.Role == "Collector" ? "selected" : null)">@L["Collector"]</option>
            <option value="Viewer" selected="@(Model.Role == "Viewer" ? "selected" : null)">@L["Viewer"]</option>
            <option value="Auditor" selected="@(Model.Role == "Auditor" ? "selected" : null)">@L["Auditor"]</option>
        </select>
    </div>

    <div class="col-md-3">
        <select name="Status" class="form-select">
            <option value="">@L["All Status"]</option>
            <option value="Active" selected="@(Model.Status == "Active" ? "selected" : null)">@L["Active"]</option>
            <option value="Locked" selected="@(Model.Status == "Locked" ? "selected" : null)">@L["Locked"]</option>
        </select>
    </div>

    <div class="col-md-2 d-grid">
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-funnel-fill"></i> @L["Filter"]
        </button>
    </div>
</form>

<a asp-page-handler="ExportCsv"
   asp-route-search="@Model.Search"
   asp-route-role="@Model.Role"
   asp-route-status="@Model.Status"
   class="btn btn-success mb-3">
    <i class="bi bi-file-earmark-excel"></i> @L["Export to CSV"]
</a>

@{ ViewData["DetailCount"] = Model.TotalCount; }
<partial name="_ReportViewToggle" />

<div data-report-view="summary">
    <div class="row g-3 mb-3">
        <div class="col-md-4">
            <div class="card text-center shadow-sm border-0">
                <div class="card-body">
                    <h6 class="text-muted">@L["Total Users"]</h6>
                    <h4 class="fw-bold mb-0">@Model.TotalCount</h4>
                </div>
            </div>
        </div>
    </div>
    <partial name="_CountGroups" model="Model.SummaryGroups" />
</div>

<div data-report-view="details">
<div class="table-responsive">
    <table class="table table-bordered table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>@L["System ID"]</th>
                <th>@L["Username"]</th>
                <th>@L["Full Name"]</th>
                <th>@L["Phone"]</th>
                <th>@L["Role"]</th>
                <th>@L["Permissions"]</th>
                <th>@L["Status"]</th>
            </tr>
        </thead>
        <tbody>
        @if (Model.Users.Any())
        {
            int i = (Model.PageNumber - 1) * 10 + 1;
            foreach (var user in Model.Users)
            {
                string badgeClass = user.Role switch
                {
                    "Admin" => "bg-danger",
                    "Collector" => "bg-success",
                    "Viewer" => "bg-secondary",
                    "Auditor" => "bg-warning text-dark",
                    _ => "bg-info"
                };

                <tr>
                    <td class="fw-semibold">@user.Id</td>
                    <td>@user.Username</td>
                    <td>@user.FullName</td>
                    <td>@user.Phone</td>
                    <td>
                        <span class="badge @badgeClass">@L[user.Role]</span>
                    </td>
                    <td>
                        <small class="text-muted">@user.Permissions</small>
                    </td>
                    <td>
                        @if (user.IsLocked)
                        {
                            <span class="badge bg-danger">@L["Locked"]</span>
                        }
                        else
                        {
                            <span class="badge bg-success">@L["Active"]</span>
                        }
                    </td>
                </tr>
                i++;
            }
        }
        else
        {
            <tr>
                <td colspan="7" class="text-center text-muted">
                    @L["No users found."]
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

<nav>
    <ul class="pagination justify-content-center">
        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                <a class="page-link"
                   href="?PageNumber=@i&Search=@Model.Search&Role=@Model.Role&Status=@Model.Status">
                    @i
                </a>
            </li>
        }
    </ul>
</nav>
</div>
