@page
@model VehicleTax.Web.Pages.Reports.TaxMovementCarTypeModel

<h3 class="fw-bold mb-4">@L["Tax Amount by Tariff & Car Type"]</h3>

<form method="get" class="card p-3 mb-3 shadow-sm">
    <div class="row g-2">
        <div class="col-md-3">
            <label class="form-label">@L["From Date"]</label>
            <input type="date" asp-for="FromDate" class="form-control" />
        </div>

        <div class="col-md-3">
            <label class="form-label">@L["To Date"]</label>
            <input type="date" asp-for="ToDate" class="form-control" />
        </div>

        <div class="col-md-3">
            <label class="form-label">@L["Tariff Name"]</label>
            <select asp-for="MovementName" asp-items="Model.Movements" class="form-select">
                <option value="">@L["All Tariffs"]</option>
            </select>
        </div>

        <div class="col-md-3">
            <label class="form-label">@L["Page Size"]</label>
            <select asp-for="PageSize" class="form-select">
                <option value="10">10</option>
                <option value="20" selected>20</option>
                <option value="50">50</option>
                <option value="100">100</option>
                <option value="999999">@L["All"]</option>
            </select>
        </div>

        <div class="col-md-12 d-flex align-items-end gap-2">
            <button type="submit" class="btn btn-primary w-100">@L["Filter"]</button>
            <a asp-page="./TaxMovementCarType" class="btn btn-secondary w-100">@L["Reset"]</a>
            <a asp-page-handler="Export"
               asp-route-FromDate="@Model.FromDate"
               asp-route-ToDate="@Model.ToDate"
                    asp-route-MovementName="@Model.MovementName"
               asp-route-CarTypeId="@Model.CarTypeId"
               class="btn btn-success w-100">
                @L["Export CSV"]
            </a>
        </div>
    </div>
</form>

@{ ViewData["DetailCount"] = Model.DetailRows.Count; }
<partial name="_ReportViewToggle" />

<div data-report-view="summary">

<div class="card shadow-sm mb-3">
    <div class="card-body text-center">
        <h5 class="text-muted">@L["Total Tax Collected"]</h5>
        <h2 class="fw-bold text-success">
            $@Model.TotalTax.ToString("N0")
        </h2>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header fw-bold">
        Tax Amount Linked With Movement & Car Type
    </div>
    <div class="card-body p-0">
        <table class="table table-striped mb-0">
            <thead class="table-dark">
                <tr>
                    <th>@L["Tariff"]</th>
                    <th>@L["Car Type"]</th>
                    <th>@L["Total Payments"]</th>
                    <th>@L["Total Amount"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.ReportData)
                {
                    <tr>
                        <td>@item.MovementName</td>
                        <td>@item.CarTypeName</td>
                        <td>@item.TotalPayments</td>
                        <td>$@item.TotalAmount.ToString("N0")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Pagination -->
<nav class="mt-3">
    <ul class="pagination justify-content-center">
        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                <a class="page-link"
                   asp-route-PageNumber="@i"
                   asp-route-PageSize="@Model.PageSize"
                   asp-route-FromDate="@Model.FromDate"
                   asp-route-ToDate="@Model.ToDate"
                   asp-route-MovementName="@Model.MovementName"
                   asp-route-CarTypeId="@Model.CarTypeId">
                    @i
                </a>
            </li>
        }
    </ul>
</nav>

<partial name="_PaymentSummaryBreakdown" model="Model.Breakdown" />
</div>

<div data-report-view="details">
    <partial name="_PaymentDetailsTable" model="Model.DetailRows" />
</div>
