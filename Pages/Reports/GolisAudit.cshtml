@page
@model VehicleTax.Web.Pages.Reports.GolisAuditModel

@{
    var statusClass = new Dictionary<string, string>
    {
        { "Matched", "success" },
        { "NotInSystem", "danger" },
        { "AmountMismatch", "warning" },
        { "Duplicate", "info" },
        { "SystemOnly", "primary" },
        { "NeedsReview", "secondary" }
    };
}

<div class="container mt-4">
    <h3 class="fw-bold mb-4">
        <i class="bi bi-shield-check"></i>
        @L["Golis Transaction Audit"]
    </h3>

    @if (Model.Audit == null)
    {
        <!-- CREATE AUDIT -->
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <h5 class="fw-bold mb-3">@L["Create New Golis Audit"]</h5>
                <form method="post" asp-page-handler="Create">
                    <div class="row g-3">
                        <div class="col-md-3">
                            <label class="form-label">@L["Statement Number"]</label>
                            <input type="text" asp-for="Input.StatementNumber" class="form-control" required />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">@L["From Date"]</label>
                            <input type="date" asp-for="Input.FromDate" class="form-control" required />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">@L["To Date"]</label>
                            <input type="date" asp-for="Input.ToDate" class="form-control" required />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">@L["Statement Total"]</label>
                            <input type="number" step="0.01" asp-for="Input.StatementTotal" class="form-control" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">@L["Transaction Count"]</label>
                            <input type="number" asp-for="Input.StatementTransactionCount" class="form-control" />
                        </div>
                    </div>
                    <div class="row g-3 mt-1">
                        <div class="col-md-12">
                            <label class="form-label">@L["Notes"]</label>
                            <textarea asp-for="Input.Notes" class="form-control" rows="2"></textarea>
                        </div>
                    </div>
                    <div class="mt-3">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-plus-circle"></i> @L["Create Audit"]
                        </button>
                    </div>
                </form>
            </div>
        </div>
    }
    else
    {
        <!-- AUDIT HEADER -->
        <div class="card shadow-sm border-0 mb-3">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <h5 class="fw-bold mb-1">@L["Audit #"]@Model.Audit.Id - @Model.Audit.StatementNumber</h5>
                        <p class="text-muted mb-1">
                            @L["Period:"] @Model.Audit.AuditPeriodFrom.ToString("dd MMM yyyy") - @Model.Audit.AuditPeriodTo.ToString("dd MMM yyyy")
                        </p>
                        <p class="text-muted mb-0">
                            @L["Status:"]
                            @if (Model.Audit.Status == AuditStatus.Finalized)
                            {
                                <span class="badge bg-success">@L["Finalized"]</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">@L["Draft"]</span>
                            }
                        </p>
                    </div>
                    <div class="text-end">
                        <div class="btn-group">
                            @if (!Model.IsReadOnly)
                            {
                                <form method="post" asp-page-handler="Finalize" asp-route-auditId="@Model.Audit.Id" onsubmit="return confirm('Are you sure you want to finalize this audit?');">
                                    <button type="submit" class="btn btn-success">
                                        <i class="bi bi-check-circle"></i> @L["Finalize Audit"]
                                    </button>
                                </form>
                            }
                            else if (User.IsInRole("Admin"))
                            {
                                <form method="post" asp-page-handler="Reopen" asp-route-auditId="@Model.Audit.Id" onsubmit="return confirm('Reopen this audit?');">
                                    <button type="submit" class="btn btn-warning">
                                        <i class="bi bi-arrow-counterclockwise"></i> @L["Reopen"]
                                    </button>
                                </form>
                            }
                            <a asp-page="./GolisAuditHistory" class="btn btn-outline-secondary ms-2">@L["Audit History"]</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        ViewData["DetailCount"] = Model.GolisRows.Count + Model.SystemOnlyRows.Count;
        <partial name="_ReportViewToggle" />

        <div data-report-view="summary">
        <!-- DASHBOARD -->
        <div class="row g-3 mb-3">
            <div class="col-md-3">
                <div class="card shadow-sm border-0 text-center h-100">
                    <div class="card-body">
                        <div class="text-muted small fw-semibold">@L["Total Golis"]</div>
                        <h4 class="fw-bold mb-0">@Model.TotalGolisTransactions</h4>
                        <div class="text-muted small fw-semibold">$@Model.TotalGolisAmount.ToString("N0")</div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card shadow-sm border-0 text-center h-100">
                    <div class="card-body">
                        <div class="text-muted small fw-semibold">@L["Total System"]</div>
                        <h4 class="fw-bold mb-0">@Model.TotalSystemTransactions</h4>
                        <div class="text-muted small fw-semibold">$@Model.TotalSystemAmount.ToString("N0")</div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card shadow-sm border-0 text-center h-100">
                    <div class="card-body">
                        <div class="text-muted small fw-semibold">@L["Matched"]</div>
                        <h4 class="fw-bold mb-0 text-success">@Model.MatchedCount</h4>
                        <div class="text-muted small fw-semibold">$@Model.MatchedAmount.ToString("N0")</div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card shadow-sm border-0 text-center h-100">
                    <div class="card-body">
                        <div class="text-muted small fw-semibold">@L["Difference"]</div>
                        <h4 class="fw-bold mb-0 @(Model.Difference == 0 ? "text-success" : "text-danger")">$@Model.Difference.ToString("N0")</h4>
                        <div class="text-muted small fw-semibold">@L["Golis - System"]</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-md-2">
                <div class="card shadow-sm border-0 text-center h-100">
                    <div class="card-body">
                        <div class="text-muted small fw-semibold">@L["Not in System"]</div>
                        <h5 class="fw-bold mb-0 text-danger">@Model.NotInSystemCount</h5>
                        <div class="text-muted small fw-semibold">$@Model.NotInSystemAmount.ToString("N0")</div>
                    </div>
                </div>
            </div>
            <div class="col-md-2">
                <div class="card shadow-sm border-0 text-center h-100">
                    <div class="card-body">
                        <div class="text-muted small fw-semibold">@L["Amount Mismatch"]</div>
                        <h5 class="fw-bold mb-0 text-warning">@Model.AmountMismatchCount</h5>
                        <div class="text-muted small fw-semibold">$@Model.AmountMismatchAmount.ToString("N0")</div>
                    </div>
                </div>
            </div>
            <div class="col-md-2">
                <div class="card shadow-sm border-0 text-center h-100">
                    <div class="card-body">
                        <div class="text-muted small fw-semibold">@L["Duplicate"]</div>
                        <h5 class="fw-bold mb-0 text-info">@Model.DuplicateCount</h5>
                    </div>
                </div>
            </div>
            <div class="col-md-2">
                <div class="card shadow-sm border-0 text-center h-100">
                    <div class="card-body">
                        <div class="text-muted small fw-semibold">@L["System Only"]</div>
                        <h5 class="fw-bold mb-0 text-primary">@Model.SystemOnlyCount</h5>
                        <div class="text-muted small fw-semibold">$@Model.SystemOnlyAmount.ToString("N0")</div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body d-flex align-items-center justify-content-center">
                        <form method="post" asp-page-handler="Reconcile" asp-route-auditId="@Model.Audit.Id" class="me-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-arrow-repeat"></i> @L["Reconcile"]
                            </button>
                        </form>
                        <a href="?auditId=@Model.Audit.Id&handler=Export&type=golis" class="btn btn-outline-success me-2">
                            <i class="bi bi-file-earmark-excel"></i> @L["Export Golis"]
                        </a>
                        <a href="?auditId=@Model.Audit.Id&handler=Export&type=system" class="btn btn-outline-success">
                            <i class="bi bi-file-earmark-excel"></i> @L["Export System"]
                        </a>
                    </div>
                </div>
            </div>
        </div>

        </div>

        @if (!Model.IsReadOnly)
        {
            <!-- UPLOAD + ADD TRANSACTION -->
            <div class="card shadow-sm border-0 mb-3">
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <h6 class="fw-bold">@L["Upload Statement"]</h6>
                            <form method="post" asp-page-handler="Upload" enctype="multipart/form-data">
                                <input type="hidden" name="auditId" value="@Model.Audit.Id" />
                                <input type="file" name="uploadedFile" class="form-control mb-2" accept=".pdf,.xlsx,.xls,.csv,.png,.jpg,.jpeg" />
                                <button type="submit" class="btn btn-sm btn-primary">
                                    <i class="bi bi-upload"></i> @L["Upload"]
                                </button>
                            </form>
                        </div>
                        <div class="col-md-8">
                            <h6 class="fw-bold">@L["Add Golis Transaction"]</h6>
                            <form method="post" asp-page-handler="AddTransaction">
                                <div class="row g-2">
                                    <div class="col-md-2">
                                        <input type="text" name="transaction.Reference" class="form-control" placeholder="@L["Reference"]" required />
                                    </div>
                                    <div class="col-md-2">
                                        <input type="date" name="transaction.Date" class="form-control" required />
                                    </div>
                                    <div class="col-md-2">
                                        <input type="time" name="transaction.Time" class="form-control" />
                                    </div>
                                    <div class="col-md-2">
                                        <input type="text" name="transaction.MobileNumber" class="form-control" placeholder="@L["Mobile"]" />
                                    </div>
                                    <div class="col-md-2">
                                        <input type="number" step="0.01" name="transaction.Amount" class="form-control" placeholder="@L["Amount"]" required />
                                    </div>
                                    <div class="col-md-2">
                                        <input type="text" name="transaction.Description" class="form-control" placeholder="@L["Description"]" />
                                    </div>
                                </div>
                                <div class="mt-2">
                                    <button type="submit" class="btn btn-sm btn-primary">
                                        <i class="bi bi-plus-circle"></i> @L["Add Transaction"]
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- FILTERS -->
        <div class="card shadow-sm border-0 mb-3">
            <div class="card-body">
                <form method="get" class="row g-3">
                    <input type="hidden" name="auditId" value="@Model.Audit.Id" />
                    <div class="col-md-4">
                        <label class="form-label">@L["Search"]</label>
                        <input type="text" name="search" value="@Model.Search" class="form-control" placeholder="@L["Reference, mobile, description..."]" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">@L["Status Filter"]</label>
                        <select name="statusFilter" class="form-select">
                            <option value="All" selected="@(Model.StatusFilter == "All" ? "selected" : null)">@L["All"]</option>
                            <option value="Matched" selected="@(Model.StatusFilter == "Matched" ? "selected" : null)">@L["Matched"]</option>
                            <option value="NotInSystem" selected="@(Model.StatusFilter == "NotInSystem" ? "selected" : null)">@L["Not in System"]</option>
                            <option value="AmountMismatch" selected="@(Model.StatusFilter == "AmountMismatch" ? "selected" : null)">@L["Amount Mismatch"]</option>
                            <option value="Duplicate" selected="@(Model.StatusFilter == "Duplicate" ? "selected" : null)">@L["Duplicate"]</option>
                            <option value="NeedsReview" selected="@(Model.StatusFilter == "NeedsReview" ? "selected" : null)">@L["Needs Review"]</option>
                        </select>
                    </div>
                    <div class="col-md-3 d-flex align-items-end">
                        <button type="submit" class="btn btn-primary me-2">
                            <i class="bi bi-search"></i> @L["Filter"]
                        </button>
                        <a href="?auditId=@Model.Audit.Id" class="btn btn-secondary">@L["Reset"]</a>
                    </div>
                </form>
            </div>
        </div>

        <div data-report-view="details">
        <!-- GOLIS TRANSACTIONS TABLE -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body">
                <h5 class="fw-bold mb-3">@L["Golis Transactions"]</h5>
                <div class="table-responsive">
                    <table class="table table-bordered table-striped table-sm align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th>@L["Reference"]</th>
                                <th>@L["Date"]</th>
                                <th>@L["Mobile"]</th>
                                <th class="text-end">@L["Golis Amount"]</th>
                                <th>@L["System ID"]</th>
                                <th>@L["System Receipt"]</th>
                                <th class="text-end">@L["System Amount"]</th>
                                <th class="text-end">@L["Difference"]</th>
                                <th>@L["Status"]</th>
                                <th>@L["Notes"]</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Model.GolisRows)
                            {
                                <tr class="table-@statusClass.GetValueOrDefault(row.Status, "light")">
                                    <td>@row.Reference</td>
                                    <td>@row.Date.ToString("dd MMM yyyy") @(string.IsNullOrEmpty(row.Time) ? "" : $"{@row.Time}")</td>
                                    <td>@row.Mobile</td>
                                    <td class="text-end">$@row.Amount.ToString("N0")</td>
                                    <td class="fw-semibold">@(row.SystemId?.ToString() ?? "-")</td>
                                    <td>@row.SystemReceipt</td>
                                    <td class="text-end">$@row.SystemAmount.ToString("N0")</td>
                                    <td class="text-end">$@row.Difference.ToString("N0")</td>
                                    <td>
                                        <span class="badge bg-@statusClass.GetValueOrDefault(row.Status, "secondary")">@row.Status</span>
                                    </td>
                                    <td>@row.Notes</td>
                                <td>
                                    @if (!Model.IsReadOnly)
                                    {
                                        <div class="d-flex gap-1">
                                            <button type="button" class="btn btn-sm btn-warning" data-bs-toggle="modal" data-bs-target="#editModal-@row.Id">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                            <form method="post" asp-page-handler="DeleteTransaction" asp-route-transactionId="@row.Id" onsubmit="return confirm('Delete this transaction?');">
                                                <button type="submit" class="btn btn-sm btn-danger">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    }
                                </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        </div>

        <!-- EDIT MODALS -->
        @if (!Model.IsReadOnly)
        {
            @foreach (var row in Model.GolisRows)
            {
                <div class="modal fade" id="editModal-@row.Id" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog modal-lg">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title">@L["Edit Golis Transaction"]</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@L["Close"]"></button>
                            </div>
                            <form method="post" asp-page-handler="EditTransaction" asp-route-transactionId="@row.Id">
                                <div class="modal-body">
                                    <div class="row g-3">
                                        <div class="col-md-3">
                                            <label class="form-label">@L["Reference"]</label>
                                            <input type="text" name="transaction.Reference" value="@row.Reference" class="form-control" required />
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label">@L["Date"]</label>
                                            <input type="date" name="transaction.Date" value="@row.Date.ToString("yyyy-MM-dd")" class="form-control" required />
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label">@L["Time"]</label>
                                            <input type="time" name="transaction.Time" value="@row.Time" class="form-control" />
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label">@L["Mobile"]</label>
                                            <input type="text" name="transaction.MobileNumber" value="@row.Mobile" class="form-control" />
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label">@L["Amount"]</label>
                                            <input type="number" step="0.01" name="transaction.Amount" value="@row.Amount" class="form-control" required />
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label">@L["Description"]</label>
                                            <input type="text" name="transaction.Description" value="@row.Description" class="form-control" />
                                        </div>
                                        <div class="col-md-12">
                                            <label class="form-label">@L["Notes"]</label>
                                            <textarea name="transaction.Notes" class="form-control" rows="2">@row.Notes</textarea>
                                        </div>
                                    </div>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@L["Cancel"]</button>
                                    <button type="submit" class="btn btn-primary">@L["Save Changes"]</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            }
        }

        <div data-report-view="details">
        <!-- SYSTEM-ONLY TRANSACTIONS -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body">
                <h5 class="fw-bold mb-3">@L["System-Only Transactions"]</h5>
                <div class="table-responsive">
                    <table class="table table-bordered table-striped table-sm align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th>@L["System ID"]</th>
                                <th>@L["System Receipt"]</th>
                                <th>@L["Date"]</th>
                                <th>@L["Plate"]</th>
                                <th class="text-end">@L["Amount"]</th>
                                <th>@L["Golis Reference"]</th>
                                <th>@L["Status"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Model.SystemOnlyRows)
                            {
                                <tr>
                                    <td class="fw-semibold">@row.SystemId</td>
                                    <td>@row.ReceiptNumber</td>
                                    <td>@row.Date.ToString("dd MMM yyyy HH:mm")</td>
                                    <td>@row.Plate</td>
                                    <td class="text-end">$@row.Amount.ToString("N0")</td>
                                    <td>@row.GolisReference</td>
                                    <td><span class="badge bg-primary">@row.Status</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        </div>
    }
</div>
