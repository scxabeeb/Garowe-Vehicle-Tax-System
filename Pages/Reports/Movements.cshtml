@page
@model VehicleTax.Web.Pages.Reports.MovementsModel
@{
    ViewData["Title"] = L["Tariff Report"];
}

<h3 class="fw-bold mb-4">@L["Tariff Report"]</h3>

<form method="get" class="card p-3 shadow-sm mb-4">
    <div class="row g-3">

        <div class="col-md-3">
            <label class="form-label">@L["Tariff Name"]</label>
            <input asp-for="MovementName" class="form-control" />
        </div>

        <div class="col-md-3">
            <label class="form-label">@L["Car Type"]</label>
            <select asp-for="CarTypeId" asp-items="Model.CarTypes" class="form-select">
                <option value="">@L["All"]</option>
            </select>
        </div>

        <input type="hidden" name="PageSize" value="@Model.Pager.PageSize" />

        <div class="col-md-2 d-flex align-items-end">
            <button class="btn btn-primary w-100">@L["Filter"]</button>
        </div>

        <div class="col-md-2 d-flex align-items-end">
            <a asp-page-handler="ExportCsv"
               asp-route-movementName="@Model.MovementName"
               asp-route-carTypeId="@Model.CarTypeId"
               class="btn btn-success w-100">
                CSV
            </a>
        </div>

    </div>
</form>

@{ ViewData["DetailCount"] = Model.TotalRecords; }
<partial name="_ReportViewToggle" />

<div data-report-view="summary">
<div class="row mb-3">
    <div class="col-md-4">
        <div class="card text-center shadow-sm">
            <div class="card-body">
                <h6>@L["Total Tariffs"]</h6>
                <h4>@Model.TotalRecords</h4>
            </div>
        </div>
    </div>
</div>

<partial name="_CountGroups" model="Model.SummaryGroups" />
</div>

<div data-report-view="details">
<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>@L["System ID"]</th>
            <th>@L["Tariff"]</th>
            <th>@L["Car Type"]</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Movements.Any())
        {
            <tr>
                <td colspan="3" class="text-center text-muted">
                    @L["No tariff records found."]
                </td>
            </tr>
        }
        else
        {
            foreach (var m in Model.Movements)
            {
                <tr>
                    <td class="fw-semibold">@m.Id</td>
                    <td>@m.Name</td>
                    <td>@m.CarType?.Name</td>
                </tr>
            }
        }
    </tbody>
</table>

<partial name="_Pager" model="Model.Pager" />
</div>
