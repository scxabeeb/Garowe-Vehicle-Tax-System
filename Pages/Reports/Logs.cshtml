@page
@model VehicleTax.Web.Pages.Reports.LogsModel

<div class="container mt-4">

    <div class="report-banner">
        <div class="d-flex align-items-center gap-3">
            <img src="/images/Logo.jpeg" width="58" height="58" style="border-radius:50%;border:2px solid #b8c7ff;" />
            <div>
                <div class="fw-bold" style="font-size:1.05rem;">@L["Garowe Local Government"]</div>
                <div class="text-muted">System Logs & Transaction Audit Report</div>
            </div>
        </div>
        <div class="text-muted small d-none d-md-block">
            @VehicleTax.Web.AppTime.Now.ToString("dd MMM yyyy")
        </div>
    </div>

    <!-- FILTERS -->
    <form method="get" class="card shadow-sm border-0 mb-3">
        <div class="card-body">
            <div class="row g-3">

                <div class="col-md-3">
                    <label class="form-label">@L["From Date"]</label>
                    <input type="date" asp-for="FromDate" class="form-control" />
                </div>

                <div class="col-md-3">
                    <label class="form-label">@L["To Date"]</label>
                    <input type="date" asp-for="ToDate" class="form-control" />
                </div>

                <div class="col-md-3">
                    <label class="form-label">@L["Action"]</label>
                    <select asp-for="Action" class="form-select">
                        <option value="All">@L["All Actions"]</option>
                        <option value="Completed">@L["Completed Only"]</option>
                        <option value="Reverted">@L["Cancelled Only"]</option>
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="form-label">@L["Collector"]</label>
                    <select asp-for="CollectorId" asp-items="Model.Collectors" class="form-select">
                        <option value="">@L["All Collectors"]</option>
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="form-label">@L["Checkpoint"]</label>
                    <select asp-for="CheckpointId" asp-items="Model.Checkpoints" class="form-select">
                        <option value="">@L["All Checkpoints"]</option>
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="form-label">@L["Traffida"]</label>
                    <select asp-for="MovementId" asp-items="Model.Movements" class="form-select">
                        <option value="">@L["All Traffida"]</option>
                    </select>
                </div>

                <div class="col-md-3 d-flex align-items-end gap-2">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-search"></i> @L["Apply Filters"]
                    </button>
                    <a asp-page="/Reports/Logs" class="btn btn-outline-secondary w-100">
                        <i class="bi bi-arrow-counterclockwise"></i> @L["Reset"]
                    </a>
                </div>
            </div>
        </div>
    </form>

    @{ ViewData["DetailCount"] = Model.TotalTransactions; }
    <partial name="_ReportViewToggle" />

    <div data-report-view="summary">
    <!-- SUMMARY CARDS -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card shadow-sm border-0 text-center h-100">
                <div class="card-body">
                    <div class="text-muted small fw-semibold">@L["Total Transactions"]</div>
                    <h3 class="fw-bold mb-0 text-primary">@Model.TotalTransactions</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 text-center h-100">
                <div class="card-body">
                    <div class="text-muted small fw-semibold">@L["Completed"]</div>
                    <h3 class="fw-bold mb-0 text-success">@Model.CompletedCount</h3>
                    <div class="text-muted small fw-semibold">$@Model.TotalCompletedAmount.ToString("N0")</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 text-center h-100">
                <div class="card-body">
                    <div class="text-muted small fw-semibold">@L["Cancelled"]</div>
                    <h3 class="fw-bold mb-0 text-danger">@Model.RevertedCount</h3>
                    <div class="text-muted small fw-semibold">$@Model.TotalRevertedAmount.ToString("N0")</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 text-center h-100">
                <div class="card-body">
                    <div class="text-muted small fw-semibold">@L["Pages"]</div>
                    <h3 class="fw-bold mb-0 text-info">@Model.TotalPages</h3>
                    <div class="text-muted small fw-semibold">@L["Page"] @(Model.CurrentPage)</div>
                </div>
            </div>
        </div>
    </div>

    <partial name="_PaymentSummaryBreakdown" model="Model.Breakdown" />
    </div>

    <div data-report-view="details">
    <!-- EXPORT -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>

        </div>

        <a asp-page-handler="ExportCsv"
           asp-route-FromDate="@Model.FromDate"
           asp-route-ToDate="@Model.ToDate"
           asp-route-Action="@Model.Action"
           asp-route-CollectorId="@Model.CollectorId"
           asp-route-CheckpointId="@Model.CheckpointId"
           asp-route-MovementId="@Model.MovementId"
           class="btn btn-success btn-sm">
            <i class="bi bi-file-earmark-arrow-down"></i> @L["Export to CSV"]
        </a>
    </div>

    <!-- DETAILED LOG TABLE -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-bordered table-striped table-hover mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>@L["System ID"]</th>
                            <th width="120">@L["Date"]</th>
                            <th width="120">@L["Plate"]</th>
                            <th>@L["Owner"]</th>
                            <th>@L["Car Type"]</th>
                            <th>@L["Traffida"]</th>
                            <th>@L["Rev. Account"]</th>
                            <th>@L["Collector"]</th>
                            <th>@L["Checkpoint"]</th>
                            <th>@L["Payment Method"]</th>
                            <th>@L["Txn ID"]</th>
                            <th>@L["Receipt"]</th>
                            <th class="text-end">@L["Amount"]</th>
                            <th>@L["Status"]</th>
                            <th>@L["Cancelled By"]</th>
                            <th>@L["Cancel Reason"]</th>
                            <th>@L["Paid By"]</th>
                            <th>@L["Remarks"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in Model.Transactions)
                        {
                            <tr class="@(t.IsReverted ? "table-danger" : "")">
                                <td class="fw-semibold">@t.Id</td>
                                <td>@VehicleTax.Web.AppTime.ToLocal(t.PaidAt).ToString("dd MMM yyyy HH:mm")</td>
                                <td>@t.Vehicle?.PlateNumber</td>
                                <td>@t.Vehicle?.OwnerName</td>
                                <td>@t.Vehicle?.CarType?.Name</td>
                                <td>@(t.Movement?.Name ?? t.MovementType)</td>
                                <td>
                                    @if (t.Movement?.RevenueAccount != null)
                                    {
                                        <span class="small">@t.Movement.RevenueAccount.AccountCode - @t.Movement.RevenueAccount.AccountName</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>@(t.Collector?.Username ?? t.ReceiptReference?.UsedBy ?? "Unassigned")</td>
                                <td>
                                    <span class="badge bg-secondary">@(t.Checkpoint?.Name ?? "Unassigned")</span>
                                </td>
                                <td>@(string.IsNullOrWhiteSpace(t.PaymentMethod) ? "-" : t.PaymentMethod)</td>
                                <td class="font-monospace small">@(t.TransactionId ?? "-")</td>
                                <td>@(t.ReceiptReference?.ReferenceNumber ?? "-")</td>
                                <td class="text-end fw-bold">$@t.Amount.ToString("N0")</td>
                                <td>
                                    @if (t.IsReverted)
                                    {
                                        <span class="badge bg-danger">@L["Cancelled"]</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">@L["Completed"]</span>
                                    }
                                </td>
                                <td>@(string.IsNullOrWhiteSpace(t.RevertedByUser?.Username) ? "-" : t.RevertedByUser.Username)</td>
                                <td>@(string.IsNullOrWhiteSpace(t.RevertReason) ? "-" : t.RevertReason)</td>
                                <td>@(string.IsNullOrWhiteSpace(t.PaidBy) ? "-" : t.PaidBy)</td>
                                <td>@(string.IsNullOrWhiteSpace(t.Remarks) ? "-" : t.Remarks)</td>
                            </tr>
                        }
                        @if (!Model.Transactions.Any())
                        {
                            <tr>
                                <td colspan="18" class="text-center text-muted">@L["No transactions found for the selected filters."]</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <partial name="_Pager" model="Model.Pager" />
    </div>

    </div>

</div>
