@page
@model VehicleTax.Web.Pages.Reports.LogsModel

<div class="container mt-4">

    <div class="report-banner">
        <div class="d-flex align-items-center gap-3">
            <img src="/images/Logo.jpeg" width="58" height="58" style="border-radius:50%;border:2px solid #b8c7ff;" />
            <div>
                <div class="fw-bold" style="font-size:1.05rem;">Garowe Local Government</div>
                <div class="text-muted">System Logs & Transaction Audit Report</div>
            </div>
        </div>
        <div class="text-muted small d-none d-md-block">
            @VehicleTax.Web.AppTime.Now.ToString("dd MMM yyyy")
        </div>
    </div>

    <!-- FILTERS -->
    <form method="get" class="card shadow-sm border-0 mb-3">
        <div class="card-body">
            <div class="row g-3">

                <div class="col-md-3">
                    <label class="form-label">From Date</label>
                    <input type="date" asp-for="FromDate" class="form-control" />
                </div>

                <div class="col-md-3">
                    <label class="form-label">To Date</label>
                    <input type="date" asp-for="ToDate" class="form-control" />
                </div>

                <div class="col-md-3">
                    <label class="form-label">Action</label>
                    <select asp-for="Action" class="form-select">
                        <option value="All">All Actions</option>
                        <option value="Completed">Completed Only</option>
                        <option value="Reverted">Cancelled Only</option>
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="form-label">Collector</label>
                    <select asp-for="CollectorId" asp-items="Model.Collectors" class="form-select">
                        <option value="">All Collectors</option>
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="form-label">Checkpoint</label>
                    <select asp-for="CheckpointId" asp-items="Model.Checkpoints" class="form-select">
                        <option value="">All Checkpoints</option>
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="form-label">Movement</label>
                    <select asp-for="MovementId" asp-items="Model.Movements" class="form-select">
                        <option value="">All Movements</option>
                    </select>
                </div>

                <div class="col-md-3 d-flex align-items-end gap-2">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-search"></i> Apply Filters
                    </button>
                    <a asp-page="/Reports/Logs" class="btn btn-outline-secondary w-100">
                        <i class="bi bi-arrow-counterclockwise"></i> Reset
                    </a>
                </div>
            </div>
        </div>
    </form>

    <!-- SUMMARY CARDS -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card shadow-sm border-0 text-center h-100">
                <div class="card-body">
                    <div class="text-muted small fw-semibold">Total Transactions</div>
                    <h3 class="fw-bold mb-0 text-primary">@Model.TotalTransactions</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 text-center h-100">
                <div class="card-body">
                    <div class="text-muted small fw-semibold">Completed</div>
                    <h3 class="fw-bold mb-0 text-success">@Model.CompletedCount</h3>
                    <div class="text-muted small fw-semibold">$@Model.TotalCompletedAmount.ToString("N0")</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 text-center h-100">
                <div class="card-body">
                    <div class="text-muted small fw-semibold">Cancelled</div>
                    <h3 class="fw-bold mb-0 text-danger">@Model.RevertedCount</h3>
                    <div class="text-muted small fw-semibold">$@Model.TotalRevertedAmount.ToString("N0")</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 text-center h-100">
                <div class="card-body">
                    <div class="text-muted small fw-semibold">Pages</div>
                    <h3 class="fw-bold mb-0 text-info">@Model.TotalPages</h3>
                    <div class="text-muted small fw-semibold">Page @(Model.CurrentPage)</div>
                </div>
            </div>
        </div>
    </div>

    <!-- EXPORT -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <form method="get" class="d-inline-flex align-items-center gap-2">
                <input type="hidden" name="FromDate" value="@Model.FromDate" />
                <input type="hidden" name="ToDate" value="@Model.ToDate" />
                <input type="hidden" name="Action" value="@Model.Action" />
                <input type="hidden" name="CollectorId" value="@Model.CollectorId" />
                <input type="hidden" name="CheckpointId" value="@Model.CheckpointId" />
                <input type="hidden" name="MovementId" value="@Model.MovementId" />
                <label class="mb-0 small fw-semibold">Rows:</label>
                <select name="PageSize" class="form-select form-select-sm w-auto" onchange="this.form.submit()">
                    <option value="10" selected="@(Model.PageSize == 10 ? "selected" : null)">10</option>
                    <option value="20" selected="@(Model.PageSize == 20 ? "selected" : null)">20</option>
                    <option value="50" selected="@(Model.PageSize == 50 ? "selected" : null)">50</option>
                    <option value="100" selected="@(Model.PageSize == 100 ? "selected" : null)">100</option>
                    <option value="0" selected="@(Model.PageSize == 0 ? "selected" : null)">All</option>
                </select>
            </form>
        </div>

        <a asp-page-handler="ExportCsv"
           asp-route-FromDate="@Model.FromDate"
           asp-route-ToDate="@Model.ToDate"
           asp-route-Action="@Model.Action"
           asp-route-CollectorId="@Model.CollectorId"
           asp-route-CheckpointId="@Model.CheckpointId"
           asp-route-MovementId="@Model.MovementId"
           class="btn btn-success btn-sm">
            <i class="bi bi-file-earmark-arrow-down"></i> Export to CSV
        </a>
    </div>

    <!-- DETAILED LOG TABLE -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-bordered table-striped table-hover mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th width="120">Date</th>
                            <th width="120">Plate</th>
                            <th>Owner</th>
                            <th>Car Type</th>
                            <th>Movement</th>
                            <th>Rev. Account</th>
                            <th>Collector</th>
                            <th>Checkpoint</th>
                            <th>Payment Method</th>
                            <th>Txn ID</th>
                            <th>Receipt</th>
                            <th class="text-end">Amount</th>
                            <th>Status</th>
                            <th>Cancelled By</th>
                            <th>Cancel Reason</th>
                            <th>Paid By</th>
                            <th>Remarks</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in Model.Transactions)
                        {
                            <tr class="@(t.IsReverted ? "table-danger" : "")">
                                <td>@VehicleTax.Web.AppTime.ToLocal(t.PaidAt).ToString("dd MMM yyyy HH:mm")</td>
                                <td>@t.Vehicle?.PlateNumber</td>
                                <td>@t.Vehicle?.OwnerName</td>
                                <td>@t.Vehicle?.CarType?.Name</td>
                                <td>@(t.Movement?.Name ?? t.MovementType)</td>
                                <td>
                                    @if (t.Movement?.RevenueAccount != null)
                                    {
                                        <span class="small">@t.Movement.RevenueAccount.AccountCode - @t.Movement.RevenueAccount.AccountName</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>@(t.Collector?.Username ?? t.ReceiptReference?.UsedBy ?? "Unassigned")</td>
                                <td>
                                    <span class="badge bg-secondary">@(t.Checkpoint?.Name ?? "Unassigned")</span>
                                </td>
                                <td>@(string.IsNullOrWhiteSpace(t.PaymentMethod) ? "-" : t.PaymentMethod)</td>
                                <td class="font-monospace small">@(t.TransactionId ?? "-")</td>
                                <td>@(t.ReceiptReference?.ReferenceNumber ?? "-")</td>
                                <td class="text-end fw-bold">$@t.Amount.ToString("N0")</td>
                                <td>
                                    @if (t.IsReverted)
                                    {
                                        <span class="badge bg-danger">Cancelled</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">Completed</span>
                                    }
                                </td>
                                <td>@(string.IsNullOrWhiteSpace(t.RevertedByUser?.Username) ? "-" : t.RevertedByUser.Username)</td>
                                <td>@(string.IsNullOrWhiteSpace(t.RevertReason) ? "-" : t.RevertReason)</td>
                                <td>@(string.IsNullOrWhiteSpace(t.PaidBy) ? "-" : t.PaidBy)</td>
                                <td>@(string.IsNullOrWhiteSpace(t.Remarks) ? "-" : t.Remarks)</td>
                            </tr>
                        }
                        @if (!Model.Transactions.Any())
                        {
                            <tr>
                                <td colspan="17" class="text-center text-muted">No transactions found for the selected filters.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1 && Model.PageSize > 0)
    {
        <nav class="mt-3">
            <ul class="pagination justify-content-center">
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                        <a class="page-link"
                           asp-page="/Reports/Logs"
                           asp-route-FromDate="@Model.FromDate"
                           asp-route-ToDate="@Model.ToDate"
                           asp-route-Action="@Model.Action"
                           asp-route-CollectorId="@Model.CollectorId"
                           asp-route-CheckpointId="@Model.CheckpointId"
                           asp-route-MovementId="@Model.MovementId"
                           asp-route-CurrentPage="@i"
                           asp-route-PageSize="@Model.PageSize">
                            @i
                        </a>
                    </li>
                }
            </ul>
        </nav>
    }

</div>
