@page
@model VehicleTax.Web.Pages.Reports.SummaryModel

<div class="container mt-4">
    <h3 class="fw-bold mb-4">
        <i class="bi bi-file-earmark-bar-graph"></i>
        Summary Report
    </h3>

    <!-- FILTERS -->
    <form method="get" class="card shadow-sm border-0 mb-3">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">From Date</label>
                    <input type="date" asp-for="FromDate" class="form-control" />
                </div>

                <div class="col-md-3">
                    <label class="form-label">To Date</label>
                    <input type="date" asp-for="ToDate" class="form-control" />
                </div>

                <div class="col-md-2">
                    <label class="form-label">Collector</label>
                    <select asp-for="CollectorId" asp-items="Model.Collectors" class="form-select">
                        <option value="">All</option>
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label">Checkpoint</label>
                    <select asp-for="CheckpointId" asp-items="Model.Checkpoints" class="form-select">
                        <option value="">All</option>
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label">Movement</label>
                    <select asp-for="MovementId" asp-items="Model.Movements" class="form-select">
                        <option value="">All</option>
                    </select>
                </div>
            </div>

            <div class="mt-3 text-end">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-search"></i> Apply
                </button>
                <a asp-page="./Summary" class="btn btn-secondary">
                    Reset
                </a>
                <a asp-page-handler="ExportCsv"
                   asp-route-FromDate="@Model.FromDate"
                   asp-route-ToDate="@Model.ToDate"
                   asp-route-CollectorId="@Model.CollectorId"
                   asp-route-CheckpointId="@Model.CheckpointId"
                   asp-route-MovementId="@Model.MovementId"
                   class="btn btn-success">
                    <i class="bi bi-file-earmark-excel"></i> Export CSV
                </a>
            </div>
        </div>
    </form>

    <!-- SUMMARY KPIs -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card shadow-sm border-0 text-center h-100">
                <div class="card-body">
                    <div class="text-muted small fw-semibold">Total Transactions</div>
                    <h3 class="fw-bold mb-0 text-primary">@Model.TotalTransactions</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 text-center h-100">
                <div class="card-body">
                    <div class="text-muted small fw-semibold">Completed</div>
                    <h3 class="fw-bold mb-0 text-success">@Model.CompletedCount</h3>
                    <div class="text-muted small fw-semibold">$@Model.CompletedAmount.ToString("N0")</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 text-center h-100">
                <div class="card-body">
                    <div class="text-muted small fw-semibold">Cancelled</div>
                    <h3 class="fw-bold mb-0 text-danger">@Model.CancelledCount</h3>
                    <div class="text-muted small fw-semibold">$@Model.CancelledAmount.ToString("N0")</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 text-center h-100">
                <div class="card-body">
                    <div class="text-muted small fw-semibold">Net Amount</div>
                    <h3 class="fw-bold mb-0 text-info">$@Model.NetAmount.ToString("N0")</h3>
                </div>
            </div>
        </div>
    </div>

    <!-- BREAKDOWN TABLES -->
    <div class="row g-4 mb-4">
        <!-- STATUS -->
        <div class="col-lg-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h5 class="fw-bold mb-3">By Status</h5>
                    <div class="table-responsive">
                        <table class="table table-bordered table-striped table-sm mb-0">
                            <thead class="table-dark">
                                <tr>
                                    <th>Status</th>
                                    <th class="text-end">Count</th>
                                    <th class="text-end">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var s in Model.StatusSummaries)
                                {
                                    <tr>
                                        <td>@s.Status</td>
                                        <td class="text-end">@s.Count</td>
                                        <td class="text-end">$@s.Amount.ToString("N0")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- COLLECTOR -->
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h5 class="fw-bold mb-3">By Collector</h5>
                    <div class="table-responsive">
                        <table class="table table-bordered table-striped table-sm mb-0">
                            <thead class="table-dark">
                                <tr>
                                    <th>Collector</th>
                                    <th class="text-end">Completed</th>
                                    <th class="text-end">Completed Amount</th>
                                    <th class="text-end">Cancelled</th>
                                    <th class="text-end">Cancelled Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var c in Model.CollectorSummaries)
                                {
                                    <tr>
                                        <td>@c.CollectorName</td>
                                        <td class="text-end">@c.Completed</td>
                                        <td class="text-end">$@c.CompletedAmount.ToString("N0")</td>
                                        <td class="text-end">@c.Cancelled</td>
                                        <td class="text-end">$@c.CancelledAmount.ToString("N0")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <!-- MOVEMENT -->
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h5 class="fw-bold mb-3">By Movement</h5>
                    <div class="table-responsive">
                        <table class="table table-bordered table-striped table-sm mb-0">
                            <thead class="table-dark">
                                <tr>
                                    <th>Movement</th>
                                    <th class="text-end">Completed</th>
                                    <th class="text-end">Completed Amount</th>
                                    <th class="text-end">Cancelled</th>
                                    <th class="text-end">Cancelled Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var m in Model.MovementSummaries)
                                {
                                    <tr>
                                        <td>@m.MovementName</td>
                                        <td class="text-end">@m.Completed</td>
                                        <td class="text-end">$@m.CompletedAmount.ToString("N0")</td>
                                        <td class="text-end">@m.Cancelled</td>
                                        <td class="text-end">$@m.CancelledAmount.ToString("N0")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- CHECKPOINT -->
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h5 class="fw-bold mb-3">By Checkpoint</h5>
                    <div class="table-responsive">
                        <table class="table table-bordered table-striped table-sm mb-0">
                            <thead class="table-dark">
                                <tr>
                                    <th>Checkpoint</th>
                                    <th class="text-end">Completed</th>
                                    <th class="text-end">Completed Amount</th>
                                    <th class="text-end">Cancelled</th>
                                    <th class="text-end">Cancelled Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var c in Model.CheckpointSummaries)
                                {
                                    <tr>
                                        <td>@c.CheckpointName</td>
                                        <td class="text-end">@c.Completed</td>
                                        <td class="text-end">$@c.CompletedAmount.ToString("N0")</td>
                                        <td class="text-end">@c.Cancelled</td>
                                        <td class="text-end">$@c.CancelledAmount.ToString("N0")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
