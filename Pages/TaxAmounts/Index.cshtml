@page
@model VehicleTax.Web.Pages.TaxAmounts.IndexModel
@using VehicleTax.Web.Security
@{
    ViewData["Title"] = L["Tax Amounts"];
    var canEdit = Model.My.Contains(AppPermissions.Keys.SettingsEdit);
    string? acc(RevenueAccount? a) => a?.DisplayName;
}
<partial name="_ListStyles" />

<div class="container py-4">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show d-flex gap-2 align-items-center">
            <i class="bi bi-check-circle-fill"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="ls-hero mb-3 d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <h3 class="fw-bold mb-1"><i class="bi bi-cash-coin me-2"></i>@L["Tax Amounts"]<span class="count">@Model.AmountCount</span></h3>
            <div style="opacity:.85">@L["Manage tax amounts by car type and tariff"]</div>
        </div>
        @if (canEdit)
        {
            <a asp-page="Create" class="btn btn-light fw-semibold"><i class="bi bi-plus-circle me-1"></i>@L["Add Tax Amount"]</a>
        }
    </div>

    <form method="get" class="ls-card mb-3">
        <div class="p-3 row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small fw-semibold mb-1">@L["Search"]</label>
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                    <input name="Search" value="@Model.Search" class="form-control" placeholder="@L["Search car type or tariff..."]" />
                </div>
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label small fw-semibold mb-1">@L["Car Type"]</label>
                <select name="CarTypeId" class="form-select" onchange="this.form.submit()">
                    <option value="">@L["All car types"]</option>
                    @foreach (var c in Model.CarTypes)
                    {
                        <option value="@c.Id" selected="@(c.Id == Model.CarTypeId ? "selected" : null)">@c.Name</option>
                    }
                </select>
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label small fw-semibold mb-1">@L["Revenue Account"]</label>
                <select name="AccountId" class="form-select" onchange="this.form.submit()">
                    <option value="">@L["All accounts"]</option>
                    @foreach (var a in Model.Accounts)
                    {
                        <option value="@a.Id" selected="@(a.Id == Model.AccountId ? "selected" : null)">@a.DisplayName</option>
                    }
                    <option value="-1" selected="@(Model.AccountId == -1 ? "selected" : null)">@L["No revenue account"]</option>
                </select>
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label small fw-semibold mb-1">@L["Tariff status"]</label>
                <select name="Status" class="form-select" onchange="this.form.submit()">
                    <option value="all" selected="@(Model.Status == "all" ? "selected" : null)">@L["All"]</option>
                    <option value="active" selected="@(Model.Status == "active" ? "selected" : null)">@L["Active"]</option>
                    <option value="inactive" selected="@(Model.Status == "inactive" ? "selected" : null)">@L["Inactive"]</option>
                </select>
            </div>
            <input type="hidden" name="Show" value="@Model.Show" />
            <input type="hidden" name="PageSize" value="@Model.Pager.PageSize" />
            <div class="col-6 col-md-2 d-flex gap-2">
                <button class="btn btn-primary flex-grow-1"><i class="bi bi-funnel me-1"></i>@L["Filter"]</button>
                <a class="btn btn-outline-secondary" asp-page="./Index" title="@L["Reset"]"><i class="bi bi-x-lg"></i></a>
            </div>
        </div>
    </form>

    <div class="d-flex flex-wrap gap-2 mb-3">
        <a class="ls-chip @(Model.Show != "missing" ? "active" : "")" asp-route-Show="amounts"
           asp-route-Search="@Model.Search" asp-route-CarTypeId="@Model.CarTypeId" asp-route-AccountId="@Model.AccountId" asp-route-Status="@Model.Status" asp-route-PageSize="@Model.Pager.PageSize">
            <i class="bi bi-cash-coin"></i>@L["Amounts"] <span class="n">@Model.AmountCount</span>
        </a>
        <a class="ls-chip @(Model.Show == "missing" ? "active" : "")" asp-route-Show="missing"
           asp-route-Search="@Model.Search" asp-route-CarTypeId="@Model.CarTypeId" asp-route-AccountId="@Model.AccountId" asp-route-PageSize="@Model.Pager.PageSize">
            <i class="bi bi-exclamation-triangle" style="@(Model.MissingCount > 0 ? "color:#dc2626" : "")"></i>@L["Missing amounts"] <span class="n">@Model.MissingCount</span>
        </a>
    </div>

    <div class="ls-card">
        <div class="table-responsive">
            @if (Model.Show == "missing")
            {
                <table class="table ls-table mb-0">
                    <thead>
                        <tr>
                            <th>@L["Tariff"]</th>
                            <th>@L["Car Type"]</th>
                            <th>@L["Revenue Account"]</th>
                            <th class="text-end">@L["Amount"]</th>
                            <th class="text-end"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var m in Model.Missing)
                        {
                            <tr>
                                <td><div class="fw-bold">@m.Name</div><div class="small text-muted">System ID @m.Id</div></td>
                                <td><span class="ls-pill" style="background:#ecfeff;color:#0e7490">@m.CarType?.Name</span></td>
                                <td>@if (m.RevenueAccount != null) { <span class="ls-pill" style="background:#eef4ff;color:#0b57d0">@acc(m.RevenueAccount)</span> } else { <span class="ls-pill" style="background:#fef3c7;color:#92400e">@L["Not assigned"]</span> }</td>
                                <td class="text-end"><span class="ls-pill" style="background:#fee2e2;color:#b91c1c">@L["no amount"]</span></td>
                                <td class="text-end">
                                    @if (canEdit)
                                    {
                                        <a class="btn btn-sm btn-primary" asp-page="Create" asp-route-carTypeId="@m.CarTypeId" asp-route-movementId="@m.Id">
                                            <i class="bi bi-plus-lg me-1"></i>@L["Add amount"]
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                        @if (!Model.Missing.Any())
                        {
                            <tr><td colspan="5" class="ls-empty"><i class="bi bi-check2-circle" style="color:#15803d"></i>@L["Every active tariff has an amount."]</td></tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <table class="table ls-table mb-0">
                    <thead>
                        <tr>
                            <th>@L["Tariff"]</th>
                            <th>@L["Car Type"]</th>
                            <th>@L["Revenue Account"]</th>
                            <th class="text-end">@L["Amount"]</th>
                            <th>@L["Tariff status"]</th>
                            <th class="text-end">@L["Actions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in Model.Taxes)
                        {
                            var active = t.Movement?.IsActive ?? true;
                            <tr class="@(active ? "" : "text-muted")">
                                <td><div class="fw-bold">@t.Movement?.Name</div><div class="small text-muted">System ID @t.Id</div></td>
                                <td><span class="ls-pill" style="background:#ecfeff;color:#0e7490">@t.CarType?.Name</span></td>
                                <td>@if (t.Movement?.RevenueAccount != null) { <span class="ls-pill" style="background:#eef4ff;color:#0b57d0">@acc(t.Movement.RevenueAccount)</span> } else { <span class="ls-pill" style="background:#fef3c7;color:#92400e">@L["Not assigned"]</span> }</td>
                                <td class="text-end"><span class="fw-bold fs-5" style="color:#0b57d0">$@t.Amount.ToString("N2")</span></td>
                                <td>
                                    @if (active)
                                    {
                                        <span class="ls-pill" style="background:#dcfce7;color:#15803d"><i class="bi bi-circle-fill" style="font-size:7px"></i>@L["Active"]</span>
                                    }
                                    else
                                    {
                                        <span class="ls-pill" style="background:#f1f5f9;color:#64748b"><i class="bi bi-circle-fill" style="font-size:7px"></i>@L["Inactive"]</span>
                                    }
                                </td>
                                <td class="text-end text-nowrap">
                                    @if (canEdit)
                                    {
                                        <a class="ls-act" title="@L["Edit"]" asp-page="Edit" asp-route-id="@t.Id"><i class="bi bi-pencil"></i></a>
                                        <a class="ls-act danger" title="@L["Delete"]" asp-page="Delete" asp-route-id="@t.Id"><i class="bi bi-trash"></i></a>
                                    }
                                </td>
                            </tr>
                        }
                        @if (!Model.Taxes.Any())
                        {
                            <tr><td colspan="6" class="ls-empty"><i class="bi bi-cash-coin"></i>@L["No tax amounts found."]</td></tr>
                        }
                    </tbody>
                </table>
            }
        </div>
        <partial name="_Pager" model="Model.Pager" />
    </div>
</div>
