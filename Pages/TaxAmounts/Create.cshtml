@page
@model VehicleTax.Web.Pages.TaxAmounts.CreateModel

<div class="row justify-content-center">
    <div class="col-lg-7">

        <div class="card shadow-sm border-0">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">
                    <i class="bi bi-cash-coin"></i> @L["Register Tax Amount"]
                </h5>
            </div>

            <div class="card-body">

                <div asp-validation-summary="All" class="alert alert-danger"></div>

                <form method="post">

                    <!-- Car Type -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold">@L["Car Type"]</label>
                        <select asp-for="Tax.CarTypeId"
                                asp-items="Model.CarTypes"
                                class="form-select"
                                id="carTypeSelect">
                            <option value="">@L["Select Car Type"]</option>
                        </select>
                        <span asp-validation-for="Tax.CarTypeId" class="text-danger"></span>
                    </div>

                    <!-- Movement -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold">@L["Tariff"]</label>
                        <select asp-for="Tax.MovementId"
                                class="form-select"
                                id="movementSelect">
                            <option value="">-- @L["Select Tariff"] --</option>
                        </select>
                        <span asp-validation-for="Tax.MovementId" class="text-danger"></span>
                        <div class="form-text">@L["Only tariffs without an amount for this car type are listed."]</div>
                    </div>

                    <!-- Revenue Account (read-only, determined by Movement) -->
                    <div class="mb-3" id="revenueAccountSection" style="display:none;">
                        <label class="form-label fw-semibold">@L["Revenue Account"]</label>
                        <div class="form-control bg-light" id="revenueAccountDisplay">
                            --
                        </div>
                        <small class="text-muted">
                            <i class="bi bi-info-circle"></i>
                            @L["The Revenue Account is determined by the selected Tariff and cannot be changed here."]
                        </small>
                    </div>

                    <!-- Amount -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold">@L["Amount"]</label>
                        <input asp-for="Tax.Amount"
                               type="number"
                               step="0.01"
                               class="form-control" />
                        <span asp-validation-for="Tax.Amount" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-between mt-4">
                        <a asp-page="/TaxAmounts/Index" class="btn btn-outline-secondary">
                            @L["Back"]
                        </a>

                        <button type="submit" class="btn btn-success">
                            @L["Save"]
                        </button>
                    </div>

                </form>

            </div>
        </div>

    </div>
</div>

@section Scripts {
<script>
document.getElementById("carTypeSelect").addEventListener("change", function () {
    const carTypeId = this.value;
    const movementSelect = document.getElementById("movementSelect");
    const revenueSection = document.getElementById("revenueAccountSection");
    const revenueDisplay = document.getElementById("revenueAccountDisplay");

    movementSelect.innerHTML = '<option value="">Loading...</option>';
    revenueSection.style.display = 'none';

    if (!carTypeId) {
        movementSelect.innerHTML = '<option value="">-- @L["Select Tariff"] --</option>';
        return;
    }

    fetch(`?handler=Movements&carTypeId=${carTypeId}`)
        .then(res => res.json())
        .then(data => {
            if (!data.length) {
                movementSelect.innerHTML = '<option value="">@L["All tariffs for this car type already have an amount"]</option>';
                return;
            }
            movementSelect.innerHTML = '<option value="">-- @L["Select Tariff"] --</option>';
            data.forEach(m => {
                movementSelect.innerHTML += `<option value="${m.id}" data-revenue="${m.revenueAccountDisplay}">${m.name}</option>`;
            });
        });
});

document.getElementById("movementSelect").addEventListener("change", function () {
    const selected = this.options[this.selectedIndex];
    const revenueSection = document.getElementById("revenueAccountSection");
    const revenueDisplay = document.getElementById("revenueAccountDisplay");

    const display = selected.getAttribute("data-revenue");
    if (display && display.trim() !== "") {
        revenueDisplay.textContent = display;
        revenueSection.style.display = "block";
    } else {
        revenueDisplay.textContent = "—";
        revenueSection.style.display = "none";
    }
});
</script>

<partial name="_ValidationScriptsPartial" />
}
