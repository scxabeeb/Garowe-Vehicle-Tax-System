@page "{id:int}"
@model VehicleTax.Web.Pages.Vehicles.DeleteModel

<h3 class="text-danger">@L["Delete Vehicle"]</h3>

<div class="alert alert-warning">
    @L["Are you sure you want to delete this vehicle?"]
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

<div class="card p-3 mb-3">
    <p><strong>@L["Plate:"]</strong> @Model.Vehicle.PlateNumber</p>
    <p><strong>@L["Owner:"]</strong> @Model.Vehicle.OwnerName</p>
    <p><strong>@L["Car Type:"]</strong> @Model.Vehicle.CarType?.Name</p>
</div>

<form method="post">
    <button class="btn btn-danger">@L["Yes, Delete"]</button>
    <a asp-page="Index" class="btn btn-secondary ms-2">@L["Cancel"]</a>
</form>
