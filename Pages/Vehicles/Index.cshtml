@page
@model VehicleTax.Web.Pages.Vehicles.IndexModel
@using VehicleTax.Web.Security
@{
    ViewData["Title"] = L["Vehicles"];
    bool can(string k) => Model.My.Contains(k);
    string initials(string? name)
    {
        var parts = (name ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length == 0 ? "?" : string.Concat(parts.Take(2).Select(p => char.ToUpperInvariant(p[0])));
    }
    var today = VehicleTax.Web.AppTime.Today;
    var chips = new[]
    {
        ("all", L["All"].ToString(), Model.Total, "bi-car-front"),
        ("today", L["Paid today"].ToString(), Model.PaidTodayCount, "bi-check-circle"),
        ("nottoday", L["Not paid today"].ToString(), Model.Total - Model.PaidTodayCount, "bi-hourglass-split"),
        ("never", L["Never paid"].ToString(), Model.NeverPaidCount, "bi-dash-circle"),
    };
}
<partial name="_ListStyles" />

<div class="container py-4">
    <div class="ls-hero mb-3 d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <h3 class="fw-bold mb-1"><i class="bi bi-car-front me-2"></i>@L["Vehicles"]<span class="count">@Model.Total.ToString("N0")</span></h3>
            <div style="opacity:.85">@L["Browse, search, and manage registered vehicle records."]</div>
        </div>
        @if (can(AppPermissions.Keys.VehiclesCreate))
        {
            <a asp-page="Create" class="btn btn-light fw-semibold"><i class="bi bi-plus-circle me-1"></i>@L["Register Vehicle"]</a>
        }
    </div>

    <form method="get" class="ls-card mb-3">
        <div class="p-3 row g-2 align-items-end">
            <div class="col-md-5">
                <label class="form-label small fw-semibold mb-1">@L["Search"]</label>
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                    <input name="Search" value="@Model.Search" class="form-control" placeholder="@L["Plate, owner or mobile"]" />
                </div>
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label small fw-semibold mb-1">@L["Car Type"]</label>
                <select name="CarTypeId" class="form-select" onchange="this.form.submit()">
                    <option value="">@L["All car types"]</option>
                    @foreach (var c in Model.CarTypes)
                    {
                        <option value="@c.Id" selected="@(c.Id == Model.CarTypeId ? "selected" : null)">@c.Name</option>
                    }
                </select>
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label small fw-semibold mb-1">@L["Sort"]</label>
                <select name="Sort" class="form-select" onchange="this.form.submit()">
                    <option value="plate" selected="@(Model.Sort == "plate" ? "selected" : null)">@L["Plate A–Z"]</option>
                    <option value="newest" selected="@(Model.Sort == "newest" ? "selected" : null)">@L["Newest first"]</option>
                    <option value="owner" selected="@(Model.Sort == "owner" ? "selected" : null)">@L["Owner A–Z"]</option>
                </select>
            </div>
            <input type="hidden" name="Paid" value="@Model.Paid" />
            <input type="hidden" name="PageSize" value="@Model.Pager.PageSize" />
            <div class="col-md-2 d-flex gap-2">
                <button class="btn btn-primary flex-grow-1"><i class="bi bi-funnel me-1"></i>@L["Filter"]</button>
                <a class="btn btn-outline-secondary" asp-page="./Index" title="@L["Reset"]"><i class="bi bi-x-lg"></i></a>
            </div>
        </div>
    </form>

    <div class="d-flex flex-wrap gap-2 mb-3">
        @foreach (var (key, label, n, icon) in chips)
        {
            <a class="ls-chip @(Model.Paid == key ? "active" : "")" asp-route-Paid="@key"
               asp-route-Search="@Model.Search" asp-route-CarTypeId="@Model.CarTypeId" asp-route-Sort="@Model.Sort" asp-route-PageSize="@Model.Pager.PageSize">
                <i class="bi @icon"></i>@label <span class="n">@n.ToString("N0")</span>
            </a>
        }
    </div>

    <div class="ls-card">
        <div class="table-responsive">
            <table class="table ls-table mb-0">
                <thead>
                    <tr>
                        <th>@L["Plate"]</th>
                        <th>@L["Owner"]</th>
                        <th>@L["Mobile"]</th>
                        <th>@L["Car Type"]</th>
                        <th>@L["Last Paid"]</th>
                        <th class="text-end">@L["Payments"]</th>
                        <th class="text-end">@L["Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Rows)
                    {
                        var v = r.Vehicle;
                        var paidToday = r.LastPaid.HasValue && VehicleTax.Web.AppTime.ToLocal(r.LastPaid.Value).Date == today;
                        <tr>
                            <td><span class="ls-plate">@v.PlateNumber</span></td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="ls-avatar">@initials(v.OwnerName)</span>
                                    <span class="fw-semibold">@v.OwnerName</span>
                                </div>
                            </td>
                            <td class="text-nowrap">
                                @if (string.IsNullOrWhiteSpace(v.Mobile))
                                {
                                    <span class="text-muted">—</span>
                                }
                                else
                                {
                                    <a href="tel:@v.Mobile" class="text-decoration-none"><i class="bi bi-telephone me-1 text-muted"></i>@v.Mobile</a>
                                }
                            </td>
                            <td><span class="ls-pill" style="background:#ecfeff;color:#0e7490">@(v.CarType?.Name ?? "—")</span></td>
                            <td class="text-nowrap">
                                @if (paidToday)
                                {
                                    <span class="ls-pill" style="background:#dcfce7;color:#15803d"><i class="bi bi-check-circle-fill"></i>@L["Today"] @VehicleTax.Web.AppTime.ToLocal(r.LastPaid!.Value).ToString("HH:mm")</span>
                                }
                                else if (r.LastPaid.HasValue)
                                {
                                    <span class="small">@VehicleTax.Web.AppTime.ToLocal(r.LastPaid.Value).ToString("dd MMM yyyy")</span>
                                }
                                else
                                {
                                    <span class="ls-pill" style="background:#f1f5f9;color:#64748b">@L["Never"]</span>
                                }
                            </td>
                            <td class="text-end fw-semibold">@r.Payments</td>
                            <td class="text-end text-nowrap">
                                <a class="ls-act" title="@L["Payments"]" asp-page="/Payments/Index" asp-route-Search="@v.PlateNumber"><i class="bi bi-receipt"></i></a>
                                @if (can(AppPermissions.Keys.VehiclesEdit))
                                {
                                    <a class="ls-act" title="@L["Edit"]" asp-page="Edit" asp-route-id="@v.Id"><i class="bi bi-pencil"></i></a>
                                }
                                @if (can(AppPermissions.Keys.VehiclesDelete))
                                {
                                    <a class="ls-act danger" title="@L["Delete"]" asp-page="Delete" asp-route-id="@v.Id"><i class="bi bi-trash"></i></a>
                                }
                            </td>
                        </tr>
                    }
                    @if (!Model.Rows.Any())
                    {
                        <tr><td colspan="7" class="ls-empty"><i class="bi bi-car-front"></i>@L["No vehicles found."]</td></tr>
                    }
                </tbody>
            </table>
        </div>
        <partial name="_Pager" model="Model.Pager" />
    </div>
</div>
