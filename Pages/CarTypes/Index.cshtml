@page
@model VehicleTax.Web.Pages.CarTypes.IndexModel
@using VehicleTax.Web.Security
@{
    ViewData["Title"] = L["Car Types"];
    bool can(string k) => Model.My.Contains(k);
    var canEdit = can(AppPermissions.Keys.SettingsEdit);
    var palette = new[] { ("#0b57d0", "#eef4ff"), ("#0e7490", "#ecfeff"), ("#7c3aed", "#f5f3ff"), ("#15803d", "#f0fdf4"), ("#b45309", "#fffbeb"), ("#be185d", "#fdf2f8") };
}
<partial name="_ListStyles" />
<style>
    .ct-card { border: 1px solid #e2e8f0; border-radius: 18px; background: #fff; padding: 16px; height: 100%; display: flex; flex-direction: column; transition: box-shadow .15s, transform .15s; }
    .ct-card:hover { box-shadow: 0 8px 24px rgba(15,23,42,.08); transform: translateY(-2px); }
    .ct-icon { width: 46px; height: 46px; border-radius: 14px; display: grid; place-items: center; font-size: 1.35rem; flex-shrink: 0; }
    .ct-stat { background: #f8fafc; border-radius: 12px; padding: 8px 10px; text-align: center; }
    .ct-stat .v { font-weight: 800; font-size: 1.1rem; line-height: 1.1; }
    .ct-stat .l { font-size: 11px; color: #64748b; font-weight: 600; text-transform: uppercase; letter-spacing: .03em; }
</style>

<div class="container py-4">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show d-flex gap-2 align-items-center">
            <i class="bi bi-check-circle-fill"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="ls-hero mb-3 d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <h3 class="fw-bold mb-1"><i class="bi bi-truck me-2"></i>@L["Car Types"]<span class="count">@Model.TotalTypes</span></h3>
            <div style="opacity:.85">@L["Vehicle categories, with their vehicles, tariffs and tax amounts."]</div>
        </div>
        @if (canEdit)
        {
            <a asp-page="Create" class="btn btn-light fw-semibold"><i class="bi bi-plus-circle me-1"></i>@L["Add Car Type"]</a>
        }
    </div>

    <form method="get" class="ls-card mb-3">
        <div class="p-3 row g-2 align-items-end">
            <div class="col-md-7">
                <label class="form-label small fw-semibold mb-1">@L["Search"]</label>
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                    <input name="Search" value="@Model.Search" class="form-control" placeholder="@L["Search car type..."]" />
                </div>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold mb-1">@L["Sort"]</label>
                <select name="Sort" class="form-select" onchange="this.form.submit()">
                    <option value="name" selected="@(Model.Sort == "name" ? "selected" : null)">@L["Name A–Z"]</option>
                    <option value="vehicles" selected="@(Model.Sort == "vehicles" ? "selected" : null)">@L["Most vehicles"]</option>
                    <option value="tariffs" selected="@(Model.Sort == "tariffs" ? "selected" : null)">@L["Most tariffs"]</option>
                </select>
            </div>
            <input type="hidden" name="PageSize" value="@Model.Pager.PageSize" />
            <div class="col-md-2 d-flex gap-2">
                <button class="btn btn-primary flex-grow-1"><i class="bi bi-funnel me-1"></i>@L["Filter"]</button>
                <a class="btn btn-outline-secondary" asp-page="./Index" title="@L["Reset"]"><i class="bi bi-x-lg"></i></a>
            </div>
        </div>
    </form>

    @if (!Model.Cards.Any())
    {
        <div class="ls-card ls-empty"><i class="bi bi-truck"></i>@L["No car types found."]</div>
    }
    else
    {
        <div class="row g-3 mb-3">
            @foreach (var c in Model.Cards)
            {
                var (fg, bg) = palette[c.Type.Id % palette.Length];
                <div class="col-sm-6 col-lg-4 col-xl-3">
                    <div class="ct-card">
                        <div class="d-flex align-items-center gap-2 mb-3">
                            <span class="ct-icon" style="background:@bg;color:@fg"><i class="bi bi-truck"></i></span>
                            <div class="flex-grow-1 min-w-0">
                                <div class="fw-bold fs-6 text-truncate">@c.Type.Name</div>
                                <div class="small text-muted">System ID @c.Type.Id</div>
                            </div>
                            @if (c.Type.IsLocked)
                            {
                                <span class="ls-pill" style="background:#f1f5f9;color:#475569" title="@L["Locked: cannot be edited or deleted"]"><i class="bi bi-lock-fill"></i></span>
                            }
                        </div>
                        <div class="row g-2 mb-3">
                            <div class="col-4"><div class="ct-stat"><div class="v">@c.Vehicles</div><div class="l">@L["Vehicles"]</div></div></div>
                            <div class="col-4"><div class="ct-stat"><div class="v">@c.Tariffs</div><div class="l">@L["Tariffs"]</div></div></div>
                            <div class="col-4"><div class="ct-stat"><div class="v">@c.Priced</div><div class="l">@L["Priced"]</div></div></div>
                        </div>
                        <div class="small mb-3">
                            <span class="text-muted">@L["Tax amount"]:</span>
                            @if (c.Min.HasValue)
                            {
                                <span class="fw-bold">$@c.Min.Value.ToString("N2")@(c.Max != c.Min ? " – $" + c.Max!.Value.ToString("N2") : "")</span>
                            }
                            else
                            {
                                <span class="ls-pill" style="background:#fee2e2;color:#b91c1c">@L["no amount"]</span>
                            }
                        </div>
                        <div class="mt-auto d-flex gap-1 justify-content-end">
                            <a class="ls-act" title="@L["Vehicles"]" asp-page="/Vehicles/Index" asp-route-CarTypeId="@c.Type.Id"><i class="bi bi-car-front"></i></a>
                            <a class="ls-act" title="@L["Tariff"]" asp-page="/Movements/Index" asp-route-CarTypeId="@c.Type.Id"><i class="bi bi-signpost-split"></i></a>
                            @if (canEdit && !c.Type.IsLocked)
                            {
                                <a class="ls-act" title="@L["Edit"]" asp-page="Edit" asp-route-id="@c.Type.Id"><i class="bi bi-pencil"></i></a>
                                <a class="ls-act danger" title="@L["Delete"]" asp-page="Delete" asp-route-id="@c.Type.Id"><i class="bi bi-trash"></i></a>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
        @if (Model.Pager.TotalPages > 1)
        {
            <div class="ls-card"><partial name="_Pager" model="Model.Pager" /></div>
        }
    }
</div>
