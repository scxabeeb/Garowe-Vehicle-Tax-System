@page
@model VehicleTax.Web.Pages.Movements.IndexModel
@{
    ViewData["Title"] = L["Tariff"];
}

<div class="module-page">

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show">
            @L[TempData["Error"]!.ToString()!]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    <!-- SUCCESS ALERT -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="module-header mb-3">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <h3 class="fw-bold mb-1">@L["Tariff Types"]</h3>
                <div class="sub">@L["Manage tariff definitions and linked car types."]</div>
            </div>
            <a asp-page="Create" class="btn btn-light module-action-btn">
                <i class="bi bi-plus-circle"></i> @L["Add Tariff"]
            </a>
        </div>
    </div>

    <!-- SEARCH + STATUS -->
    <form method="get" class="card module-filter-card p-3 mb-3">
        <div class="row g-2 align-items-center">
            <div class="col-md-4">
                <input name="Search" value="@Model.Search" class="form-control" placeholder="@L["Search tariff, car type or account..."]" />
            </div>
            <input type="hidden" name="Status" value="@Model.Status" />
            <input type="hidden" name="PageSize" value="@Model.PageSize" />
            <div class="col-md-2">
                <button class="btn btn-primary w-100 module-action-btn"><i class="bi bi-search me-1"></i>@L["Search"]</button>
            </div>
            <div class="col-md-2">
                <a class="btn btn-outline-secondary w-100 module-action-btn"
                   asp-route-Search="@Model.Search" asp-route-Status="@Model.Status" asp-route-PageSize="@Model.PageSize"
                   asp-route-Sort="@(Model.Sort == "asc" ? "desc" : "asc")">
                    @L["Sort"] @(Model.Sort == "asc" ? "Z–A" : "A–Z")
                </a>
            </div>
            <div class="col-md-4 d-flex gap-2 justify-content-md-end flex-wrap">
                @foreach (var (key, label, n) in new[] { ("all", L["All"].ToString(), Model.ActiveCount + Model.InactiveCount), ("active", L["Active"].ToString(), Model.ActiveCount), ("inactive", L["Inactive"].ToString(), Model.InactiveCount) })
                {
                    <a class="btn btn-sm @(Model.Status == key ? "btn-primary" : "btn-outline-primary")"
                       asp-route-Search="@Model.Search" asp-route-Sort="@Model.Sort" asp-route-PageSize="@Model.PageSize" asp-route-Status="@key">
                        @label <span class="badge bg-light text-dark ms-1">@n</span>
                    </a>
                }
            </div>
        </div>
    </form>

    <!-- TABLE -->
    <div class="card module-table-card border-0">
        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width:40px"><input type="checkbox" class="form-check-input" id="tfAll" form="tfBulk" /></th>
                        <th style="width:60px">#</th>
                        <th>@L["Tariff Name"]</th>
                        <th>@L["Car Type"]</th>
                        <th>@L["Revenue Account"]</th>
                        <th>@L["Status"]</th>
                        <th class="text-center" style="width:180px">
                            @L["Actions"]
                        </th>
                    </tr>
                </thead>
                <tbody>
                @if (Model.Movements.Any())
                {
                    int i = Model.Pager.From;

                    foreach (var item in Model.Movements)
                    {
                        <tr class="@(item.IsActive ? "" : "table-secondary text-muted")">
                            <td><input type="checkbox" class="form-check-input tf-pick" name="ids" value="@item.Id" form="tfBulk" /></td>
                            <td>@i</td>
                            <td class="fw-semibold">@item.Name</td>
                            <td>
                                @if (item.CarType != null)
                                {
                                    <span class="badge bg-info text-dark">
                                        @item.CarType.Name
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">@L["No Car Type"]</span>
                                }
                            </td>
                            <td>
                                @if (item.RevenueAccount != null)
                                {
                                    <span class="badge bg-primary">
                                        @item.RevenueAccount.AccountCode - @item.RevenueAccount.AccountName
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">@L["Not assigned"]</span>
                                }
                            </td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success">@L["Active"]</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@L["Inactive"]</span>
                                }
                            </td>
                            <td class="text-center text-nowrap">
                                <button type="submit" form="tfOne" name="ids" value="@item.Id"
                                        class="btn btn-sm @(item.IsActive ? "btn-outline-secondary" : "btn-outline-success") me-1 module-action-btn"
                                        formaction="@Url.Page("Index", "SetActive", new { active = !item.IsActive, Model.Search, Model.Sort, Model.Status, Model.PageSize, Model.CurrentPage })">
                                    @(item.IsActive ? L["Deactivate"] : L["Activate"])
                                </button>
                                <a asp-page="Edit"
                                   asp-route-id="@item.Id"
                                   class="btn btn-sm btn-outline-warning me-1 module-action-btn">
                                    @L["Edit"]
                                </a>
                                <a asp-page="Delete"
                                   asp-route-id="@item.Id"
                                   class="btn btn-sm btn-outline-danger module-action-btn">
                                    @L["Delete"]
                                </a>
                            </td>
                        </tr>
                        i++;
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted">
                            @L["No tariffs found"]
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>

    <!-- BULK + PAGER -->
    <form method="post" id="tfOne"></form>
    <form method="post" id="tfBulk" asp-page-handler="SetActive"
          asp-route-Search="@Model.Search" asp-route-Sort="@Model.Sort" asp-route-Status="@Model.Status"
          asp-route-PageSize="@Model.PageSize" asp-route-CurrentPage="@Model.CurrentPage"
          class="card border-0 mt-2">
        <div class="d-flex flex-wrap align-items-center gap-2 p-2">
            <span class="small text-muted"><span id="tfCount">0</span> @L["selected"]</span>
            <button class="btn btn-sm btn-outline-success" name="active" value="true" disabled data-bulk><i class="bi bi-play-circle me-1"></i>@L["Activate"]</button>
            <button class="btn btn-sm btn-outline-secondary" name="active" value="false" disabled data-bulk><i class="bi bi-pause-circle me-1"></i>@L["Deactivate"]</button>
        </div>
    </form>
    <div class="card border-0 mt-2"><partial name="_Pager" model="Model.Pager" /></div>

</div>

<script>
    (function () {
        var picks = document.querySelectorAll('.tf-pick'), all = document.getElementById('tfAll');
        function update() {
            var n = [].filter.call(picks, function (c) { return c.checked; }).length;
            document.getElementById('tfCount').textContent = n;
            document.querySelectorAll('[data-bulk]').forEach(function (b) { b.disabled = n === 0; });
            if (all) all.checked = n > 0 && n === picks.length;
        }
        picks.forEach(function (c) { c.addEventListener('change', update); });
        if (all) all.addEventListener('change', function () { picks.forEach(function (c) { c.checked = all.checked; }); update(); });
    })();
</script>
