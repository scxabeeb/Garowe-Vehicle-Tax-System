@page "{id:int}"
@model VehicleTax.Web.Pages.Movements.EditModel
@{
    ViewData["Title"] = L["Edit Tariff"];
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
        {
            <div>@error.ErrorMessage</div>
        }
    </div>
}

<div class="row justify-content-center">
    <div class="col-md-6">

        <div class="mb-4 text-center">
            <h3 class="fw-bold">@L["Edit Tariff"]</h3>
            <p class="text-muted">
                @L["Update tariff and car type"]
            </p>
        </div>

        <form method="post" class="card shadow-sm border-0">

            <div class="card-body p-4">

                <input type="hidden" asp-for="Movement.Id" />

                <!-- Movement Name -->
                <div class="mb-3">
                    <label class="form-label fw-semibold">@L["Tariff Name"]</label>
                    <input asp-for="Movement.Name"
                           class="form-control"
                           required />
                    <span asp-validation-for="Movement.Name"
                          class="text-danger small"></span>
                </div>

                <!-- Car Type Dropdown -->
                <div class="mb-3">
                    <label class="form-label fw-semibold">@L["Car Type"]</label>
                    <select asp-for="Movement.CarTypeId"
                            class="form-select"
                            asp-items="Model.CarTypes">
                        <option value="">@L["Select Car Type"]</option>
                    </select>
                    <span asp-validation-for="Movement.CarTypeId"
                          class="text-danger small"></span>
                </div>

                <!-- Revenue Account Dropdown -->
                <div class="mb-3">
                    <label asp-for="Movement.RevenueAccountId" class="form-label fw-semibold">@L["Revenue Account"]</label>
                    <select asp-for="Movement.RevenueAccountId"
                            class="form-select"
                            asp-items="Model.RevenueAccounts">
                        <option value="">@L["Select Revenue Account"]</option>
                    </select>
                    <span asp-validation-for="Movement.RevenueAccountId"
                          class="text-danger small"></span>
                </div>

                @if (Model.SiblingCount > 1)
                {
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" asp-for="ApplyToAll" id="applyAll" />
                        <label class="form-check-label" for="applyAll">
                            @L["Apply this revenue account to all car types of this tariff"] (@Model.SiblingCount)
                        </label>
                    </div>
                }
                @if (Model.PaymentCount > 0)
                {
                    <div class="alert alert-info small mb-0">
                        <i class="bi bi-info-circle me-1"></i>@Model.PaymentCount @L["payments use this tariff. Changing the revenue account also moves them to the new account in reports."]
                    </div>
                }

            </div>

            <div class="card-footer bg-light text-end">
                <a asp-page="Index"
                   class="btn btn-outline-secondary me-2">
                    @L["Cancel"]
                </a>

                <button type="submit"
                        class="btn btn-primary px-4">
                    @L["Save Changes"]
                </button>
            </div>

        </form>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
