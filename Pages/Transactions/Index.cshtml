@page
@model VehicleTax.Web.Pages.Transactions.IndexModel

<div class="container mt-4">

    <h3 class="fw-bold mb-4">
        <i class="bi bi-filter-square"></i>
        All Transactions
    </h3>

    <!-- SUMMARY CARDS -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card shadow-sm border-0 text-center h-100">
                <div class="card-body">
                    <div class="text-muted small fw-semibold">Total Transactions</div>
                    <h3 class="fw-bold mb-0 text-primary">@Model.TotalTransactions</h3>
                    <div class="text-muted small fw-semibold">$@Model.TotalAmount.ToString("N0")</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 text-center h-100">
                <div class="card-body">
                    <div class="text-muted small fw-semibold">Completed</div>
                    <h3 class="fw-bold mb-0 text-success">@Model.CompletedCount</h3>
                    <div class="text-muted small fw-semibold">$@Model.CompletedAmount.ToString("N0")</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 text-center h-100">
                <div class="card-body">
                    <div class="text-muted small fw-semibold">Cancelled</div>
                    <h3 class="fw-bold mb-0 text-danger">@Model.CancelledCount</h3>
                    <div class="text-muted small fw-semibold">$@Model.CancelledAmount.ToString("N0")</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 text-center h-100">
                <div class="card-body">
                    <div class="text-muted small fw-semibold">Net Amount</div>
                    <h3 class="fw-bold mb-0 text-info">$@Model.NetAmount.ToString("N0")</h3>
                    <div class="text-muted small fw-semibold">Completed - Cancelled</div>
                </div>
            </div>
        </div>
    </div>

    <!-- FILTERS -->
    <form method="get" class="card shadow-sm border-0 mb-3">
        <div class="card-body">
            <div class="row g-3">

                <div class="col-md-3">
                    <label class="form-label">From Date</label>
                    <input type="date" asp-for="FromDate" class="form-control" />
                </div>

                <div class="col-md-3">
                    <label class="form-label">To Date</label>
                    <input type="date" asp-for="ToDate" class="form-control" />
                </div>

                <div class="col-md-3">
                    <label class="form-label">User</label>
                    <select asp-for="UserId" class="form-select">
                        <option value="">-- All Users --</option>
                        @foreach (var u in Model.Users)
                        {
                            <option value="@u.Id">@u.Username</option>
                        }
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="form-label">Action</label>
                    <select asp-for="Action" class="form-select">
                        <option value="All">All (Completed & Cancelled)</option>
                        <option value="Completed">Completed</option>
                        <option value="Reverted">Cancelled</option>
                    </select>
                </div>

            </div>

            <div class="mt-3 text-end">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-search"></i> Filter
                </button>

                <a asp-page="/Transactions/Index" class="btn btn-secondary">
                    Reset
                </a>
            </div>
        </div>
    </form>

    <!-- PAGE SIZE + EXPORT -->
    <div class="d-flex justify-content-between mb-2">
        <form method="get" class="d-inline">
            <input type="hidden" name="FromDate" value="@Model.FromDate" />
            <input type="hidden" name="ToDate" value="@Model.ToDate" />
            <input type="hidden" name="UserId" value="@Model.UserId" />
            <input type="hidden" name="Action" value="@Model.Action" />

            <select name="PageSize"
                    class="form-select d-inline w-auto"
                    onchange="this.form.submit()">
                <option value="10" selected="@(Model.PageSize == 10 ? "selected" : null)">10</option>
                <option value="20" selected="@(Model.PageSize == 20 ? "selected" : null)">20</option>
                <option value="50" selected="@(Model.PageSize == 50 ? "selected" : null)">50</option>
                <option value="100" selected="@(Model.PageSize == 100 ? "selected" : null)">100</option>
                <option value="200" selected="@(Model.PageSize == 200 ? "selected" : null)">200</option>
                <option value="0" selected="@(Model.PageSize == 0 ? "selected" : null)">All</option>
            </select>
            <span class="ms-1">rows</span>
        </form>

        <a href="~/Transactions/Index?handler=ExportFiltered&FromDate=@Model.FromDate&ToDate=@Model.ToDate&UserId=@Model.UserId&Action=@Model.Action"
           class="btn btn-success">
            <i class="bi bi-file-earmark-excel"></i> Export Filtered
        </a>
    </div>

    <!-- TABLE -->
    <div class="card shadow-sm border-0">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-striped align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>Ref No</th>
                            <th>Date</th>
                            <th>Plate</th>
                            <th>Car Type</th>
                            <th>Movement</th>
                            <th>Collector</th>
                            <th>Amount</th>
                            <th>Receipt No</th>
                            <th>Golis Bill No</th>
                            <th>Status</th>
                            <th>Cancelled By</th>
                            <th>Cancel Reason</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var t in Model.Transactions)
                        {
                            <tr class="@(t.IsReverted ? "table-danger" : "")">
                                <td>@(t.ReferenceNo?.ToString() ?? "-")</td>
                                <td>@VehicleTax.Web.AppTime.ToLocal(t.PaidAt).ToString("dd MMM yyyy HH:mm")</td>
                                <td>@t.Vehicle?.PlateNumber</td>
                                <td>@t.Vehicle?.CarType?.Name</td>
                                <td>@t.MovementType</td>
                                <td>@(t.Collector?.Username ?? "System")</td>
                                <td>$@t.Amount.ToString("N0")</td>
                                <td>@(t.ReceiptReference != null ? t.ReceiptReference.ReferenceNumber : t.InvoiceNumber)</td>
                                <td>@(string.IsNullOrWhiteSpace(t.TransactionId) ? "-" : t.TransactionId)</td>
                                <td>
                                    @if (t.IsReverted)
                                    {
                                        <span class="badge bg-danger">Cancelled</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">Completed</span>
                                    }
                                </td>
                                <td>@(t.RevertedByUser?.Username ?? "-")</td>
                                <td>@(string.IsNullOrWhiteSpace(t.RevertReason) ? "-" : t.RevertReason)</td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>
        </div>
    </div>

</div>
