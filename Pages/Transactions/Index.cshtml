@page
@model VehicleTax.Web.Pages.Transactions.IndexModel

<div class="container mt-4">

    <h3 class="fw-bold mb-4">
        <i class="bi bi-filter-square"></i>
        @L["All Transactions"]
    </h3>

    <!-- SUMMARY CARDS -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card shadow-sm border-0 text-center h-100">
                <div class="card-body">
                    <div class="text-muted small fw-semibold">@L["Total Transactions"]</div>
                    <h3 class="fw-bold mb-0 text-primary">@Model.TotalTransactions</h3>
                    <div class="text-muted small fw-semibold">$@Model.TotalAmount.ToString("N0")</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 text-center h-100">
                <div class="card-body">
                    <div class="text-muted small fw-semibold">@L["Completed"]</div>
                    <h3 class="fw-bold mb-0 text-success">@Model.CompletedCount</h3>
                    <div class="text-muted small fw-semibold">$@Model.CompletedAmount.ToString("N0")</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 text-center h-100">
                <div class="card-body">
                    <div class="text-muted small fw-semibold">@L["Cancelled"]</div>
                    <h3 class="fw-bold mb-0 text-danger">@Model.CancelledCount</h3>
                    <div class="text-muted small fw-semibold">$@Model.CancelledAmount.ToString("N0")</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 text-center h-100">
                <div class="card-body">
                    <div class="text-muted small fw-semibold">@L["Net Amount"]</div>
                    <h3 class="fw-bold mb-0 text-info">$@Model.NetAmount.ToString("N0")</h3>
                    <div class="text-muted small fw-semibold">@L["Completed - Cancelled"]</div>
                </div>
            </div>
        </div>
    </div>

    <!-- FILTERS -->
    <form method="get" class="card shadow-sm border-0 mb-3">
        <div class="card-body">
            <div class="row g-3">

                <div class="col-md-3">
                    <label class="form-label">@L["From Date"]</label>
                    <input type="date" asp-for="FromDate" class="form-control" />
                </div>

                <div class="col-md-3">
                    <label class="form-label">@L["To Date"]</label>
                    <input type="date" asp-for="ToDate" class="form-control" />
                </div>

                <div class="col-md-3">
                    <label class="form-label">@L["User"]</label>
                    <select asp-for="UserId" class="form-select">
                        <option value="">@L["All Users"]</option>
                        @foreach (var u in Model.Users)
                        {
                            <option value="@u.Id">@u.Username</option>
                        }
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="form-label">@L["Action"]</label>
                    <select asp-for="Action" class="form-select">
                        <option value="All">@L["All (Completed & Cancelled)"]</option>
                        <option value="Completed">@L["Completed"]</option>
                        <option value="Reverted">@L["Cancelled"]</option>
                    </select>
                </div>

            </div>

            <div class="mt-3 text-end">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-search"></i> @L["Filter"]
                </button>

                <a asp-page="/Transactions/Index" class="btn btn-secondary">
                    @L["Reset"]
                </a>
            </div>
        </div>
    </form>

    <!-- EXPORT -->
    <div class="d-flex justify-content-end mb-2">
        <a asp-page-handler="ExportFiltered" asp-route-FromDate="@Model.FromDate?.ToString("yyyy-MM-dd")" asp-route-ToDate="@Model.ToDate?.ToString("yyyy-MM-dd")"
           asp-route-UserId="@Model.UserId" asp-route-Action="@Model.Action"
           class="btn btn-success">
            <i class="bi bi-file-earmark-excel"></i> @L["Export Filtered"]
        </a>
    </div>

    <!-- TABLE -->
    <div class="card shadow-sm border-0">
        <div class="card-body pb-0">
            <div class="table-responsive">
                <table class="table table-bordered table-striped align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>@L["System ID"]</th>
                            <th>@L["Ref No"]</th>
                            <th>@L["Date"]</th>
                            <th>@L["Plate"]</th>
                            <th>@L["Car Type"]</th>
                            <th>@L["Traffida"]</th>
                            <th>@L["Collector"]</th>
                            <th>@L["Amount"]</th>
                            <th>@L["Receipt No"]</th>
                            <th>@L["Golis Bill No"]</th>
                            <th>@L["Status"]</th>
                            <th>@L["Cancelled By"]</th>
                            <th>@L["Cancel Reason"]</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var t in Model.Transactions)
                        {
                            <tr class="@(t.IsReverted ? "table-danger" : "")">
                                <td class="fw-semibold">@t.Id</td>
                                <td>@(t.ReferenceNo?.ToString() ?? "-")</td>
                                <td>@VehicleTax.Web.AppTime.ToLocal(t.PaidAt).ToString("dd MMM yyyy HH:mm")</td>
                                <td>@t.Vehicle?.PlateNumber</td>
                                <td>@t.Vehicle?.CarType?.Name</td>
                                <td>@t.MovementType</td>
                                <td>@(t.Collector?.Username ?? "System")</td>
                                <td>$@t.Amount.ToString("N0")</td>
                                <td>@(t.ReceiptReference != null ? t.ReceiptReference.ReferenceNumber : t.InvoiceNumber)</td>
                                <td>@(string.IsNullOrWhiteSpace(t.TransactionId) ? "-" : t.TransactionId)</td>
                                <td>
                                    @if (t.IsReverted)
                                    {
                                        <span class="badge bg-danger">@L["Cancelled"]</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">@L["Completed"]</span>
                                    }
                                </td>
                                <td>@(t.RevertedByUser?.Username ?? "-")</td>
                                <td>@(string.IsNullOrWhiteSpace(t.RevertReason) ? "-" : t.RevertReason)</td>
                            </tr>
                        }
                        @if (!Model.Transactions.Any())
                        {
                            <tr><td colspan="13" class="text-center text-muted py-4">@L["No transactions found."]</td></tr>
                        }
                    </tbody>

                </table>
            </div>
        </div>
        <partial name="_Pager" model="Model.Pager" />
    </div>

</div>
